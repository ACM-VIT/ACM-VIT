# ---------------------------------------------------------------------------
# ACM-VIT website — environment variables
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# Vars prefixed PUBLIC_ are inlined into the client bundle at BUILD time
# (Vite), so they must be present wherever the build runs (CI / CF Pages),
# not just at runtime.
# ---------------------------------------------------------------------------

# === Media CDN (Cloudflare R2) — audio + video offload ======================
# Base URL the site prepends to /audio/* and /videos/* via getMediaUrl().
# Leave empty to serve media from the origin (local). Set to activate the CDN.
#   test:       https://pub-<hash>.r2.dev        (rate-limited, dev only)
#   production: https://media.acmvit.in          (custom domain, once Active)
PUBLIC_MEDIA_CDN_URL=

# R2 credentials — only needed where the upload script runs (laptop / CI),
# NOT in the site runtime. From: R2 > Manage R2 API Tokens (Object Read & Write).
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET_NAME=acmvit-media
# Run: npm run deploy:media  (uploads public/audio + public/videos to R2)

# === Image CDN (Cloudflare R2) — team + board photo offload =================
# Base URL the site prepends to /board/* and /team/* via getImageUrl().
# Leave empty to serve images from the origin (local). Set to activate the CDN.
PUBLIC_IMAGE_CDN_URL=
R2_IMAGES_BUCKET_NAME=acmvit-images
# Run: npm run deploy:images  (uploads public/board + public/team to R2)

# === Static-asset CDN (Cloudflare R2) — getAssetUrl() =======================
# Base URL the site prepends to an ALLOWLIST of heavy public/ folders only:
# /design, /design-guide, /gallery, /projects, /aois, /merch,
# /contact-scroll-frames, /scroll-video-frames (see CDN_ASSET_PREFIXES in
# src/utils/cdn.ts). Everything else (logos, partners, icons, _astro, HTML)
# stays on the origin Worker. Leave empty to serve those folders locally.
#   production: https://juxtaryct.com   (R2 custom domain, once Active)
PUBLIC_CDN_URL=
# Bucket for scripts/upload-r2.mjs (deploy:cdn). Mirrors the whole public/ tree.
R2_ASSETS_BUCKET_NAME=acm-vit-website-cdn

# === Optional: route _astro/* bundles to a CDN ==============================
# Sets Astro build.assetsPrefix. Independent of PUBLIC_CDN_URL. Only enable if
# the hashed dist/_astro bundles are uploaded to this host EVERY build, else
# the site's JS/CSS 404s. Leave empty to serve _astro from the origin Worker.
PUBLIC_ASSETS_PREFIX=

# === Contact form / email (Resend) ==========================================
PUBLIC_CONTACT_ENDPOINT=
RESEND_API_KEY=
RESEND_FROM=

# === Keystatic CMS ==========================================================
# Target content repo. Default to ACM-VIT/ACM-VIT if unset (also in wrangler.json).
KEYSTATIC_GITHUB_REPO_OWNER=ACM-VIT
KEYSTATIC_GITHUB_REPO_NAME=ACM-VIT

# --- GitHub auth (PRODUCTION only) ------------------------------------------
# Local dev needs NONE of these - Keystatic runs in local storage with no login,
# and the Content Studio (/cms) treats you as owner. In production the Studio
# uses GitHub storage + login, which needs a GitHub App.
#
# Create the App: GitHub > Settings > Developer settings > GitHub Apps > New.
#   - Homepage URL:     https://acmvit.juxtaryct.com/keystatic
#   - Callback URL:     https://acmvit.juxtaryct.com/api/keystatic/github/oauth/callback
#   - Permissions:      Contents = Read & write, Pull requests = Read & write,
#                       Metadata = Read-only
#   - Install it on the content repo (ACM-VIT/ACM-VIT).
# Tip: opening /keystatic in prod runs Keystatic's "set up GitHub" wizard, which
# creates the App and hands you these values.
#
# App slug (from the App URL /apps/<slug>). PUBLIC_ = inlined at BUILD time.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# From the GitHub App page. RUNTIME SECRETS - set via `wrangler secret put`, never commit.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Signs the Keystatic session cookie. Generate: openssl rand -hex 32
KEYSTATIC_SECRET=
# Optional: impersonate a member locally to preview a role (owner by default in dev).
# CMS_DEV_USER=some-github-login

# === Legacy AWS S3 + CloudFront (updateCDN.js) — DO NOT USE =================
# Broken for the current Cloudflare adapter (uploads server bundle + wrong
# key prefix). Kept only for reference. Runs on postbuild ONLY when
# NODE_ENV=production AND these are set; leaving them empty keeps it dormant.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET_NAME=
# AWS_DISTRIBUTION_ID=
# ASTRO_OUTPUT_DIR=./dist
# UPLOAD_CONCURRENCY_LIMIT=5
