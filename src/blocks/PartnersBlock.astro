---
import Partners from "../sections/Partners.astro";
import AnimatedButton from "../components/ui/AnimatedButton.astro";
---

<section id="partners" class="page-section">
    <Partners />
    <div
        class="relative z-20 flex flex-col md:flex-row md:flex-nowrap items-center justify-center gap-6 w-full -mt-48 pb-16 [&_.anim-btn-anchor]:w-auto [&_.anim-btn]:whitespace-nowrap"
    >
        <AnimatedButton text="Partner With Us" href="/#contact" />
        <AnimatedButton text="Checkout All our partners" href="/partners" />
    </div>
</section>
