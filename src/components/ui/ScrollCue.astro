---
/**
 * ScrollCue - a "there's more below" nudge styled as a strip of magnetic tape
 * feeding downward through a spool window. A playhead dot runs the track, a
 * chevron pulses down, and a PolySans-Mono label reads "SCROLL".
 *
 * Two modes:
 *  - "hero"  (default): absolutely pinned to the bottom of a full-height first
 *    section. Visible while the hero is on screen (reuses body.hero-in-view,
 *    which Hero.astro toggles) and the page is near the top. Used on the home
 *    hero.
 *  - "fixed": viewport-fixed at bottom-centre, for any ordinary scrolling page.
 *    Visible only near the top AND when the page actually has room to scroll.
 *    Rendered globally from Layout.astro on subpages.
 *
 * Both modes fade out the moment the user scrolls, are desktop-only (the mobile
 * bottom navbar owns that lane ≤1024px), respect prefers-reduced-motion, and
 * scroll to `target` (or one viewport down) on click / Enter.
 */
export interface Props {
  target?: string;
  label?: string;
  mode?: "hero" | "fixed";
}
const { target, label = "SCROLL", mode = "hero" } = Astro.props;
---

<button
  class:list={["scroll-cue", { "is-fixed": mode === "fixed" }]}
  type="button"
  data-scroll-cue
  data-cue-mode={mode}
  data-scroll-target={target}
  aria-label={`${label} to continue`}
>
  <span class="cue-label">{label}</span>

  <span class="cue-spool" aria-hidden="true">
    <span class="cue-tape"></span>
    <span class="cue-playhead"></span>
  </span>
</button>

<style>
  .scroll-cue {
    /* hero mode: sits at the bottom-centre of the hero section (legends hug the
       corners, so the middle lane is clear). */
    position: absolute;
    bottom: clamp(1.25rem, 3.5vh, 2.25rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;

    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;

    padding: 0.4rem 0.6rem;
    margin: 0;
    background: none;
    border: 0;
    cursor: pointer;
    color: #fefcd9;
    -webkit-tap-highlight-color: transparent;

    opacity: 0;
    transform: translate(-50%, 8px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  /* fixed mode: pinned to the viewport for ordinary subpages. */
  .scroll-cue.is-fixed {
    position: fixed;
  }

  /* Shown state - driven by [data-cue-visible] from the script. */
  .scroll-cue[data-cue-visible="true"] {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  .cue-label {
    font-family: "PolySans Mono", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.34em;
    /* optical: the tracking pushes the block right, nudge it back */
    text-indent: 0.34em;
    text-transform: uppercase;
    color: rgba(254, 252, 217, 0.72);
    transition: color 0.3s ease;
  }

  /* Spool window - the little cassette port the tape runs through. */
  .cue-spool {
    position: relative;
    width: 26px;
    height: 42px;
    border-radius: 999px;
    border: 1.5px solid rgba(254, 252, 217, 0.4);
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  /* Faint tape line the playhead rides. */
  .cue-tape {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background: repeating-linear-gradient(
      to bottom,
      rgba(254, 252, 217, 0.28) 0 3px,
      transparent 3px 7px
    );
  }

  .cue-playhead {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: #f95f4a;
    box-shadow: 0 0 8px rgba(249, 95, 74, 0.75);
    animation: cuePlayhead 1.9s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }

  @keyframes cuePlayhead {
    0%   { transform: translateY(0);    opacity: 0; }
    18%  { opacity: 1; }
    72%  { opacity: 1; }
    100% { transform: translateY(23px); opacity: 0; }
  }

  /* Hover / focus - light the whole cue with the accent. */
  .scroll-cue:hover .cue-label,
  .scroll-cue:focus-visible .cue-label {
    color: #f95f4a;
  }
  .scroll-cue:hover .cue-spool,
  .scroll-cue:focus-visible .cue-spool {
    border-color: rgba(249, 95, 74, 0.7);
    box-shadow: 0 0 18px rgba(249, 95, 74, 0.25);
  }
  .scroll-cue:focus-visible {
    outline: none;
  }

  /* ── Light mode ── */
  :global(html[data-theme="light"]) .scroll-cue {
    color: #1a1a1a;
  }
  :global(html[data-theme="light"]) .cue-label {
    color: rgba(26, 26, 26, 0.6);
  }
  :global(html[data-theme="light"]) .cue-spool {
    border-color: rgba(26, 26, 26, 0.32);
  }
  :global(html[data-theme="light"]) .cue-tape {
    background: repeating-linear-gradient(
      to bottom,
      rgba(26, 26, 26, 0.24) 0 3px,
      transparent 3px 7px
    );
  }

  /* ── Reduced motion - hold everything still, keep it legible ── */
  @media (prefers-reduced-motion: reduce) {
    .cue-playhead {
      animation: none;
      top: 50%;
      margin-top: -2.5px;
      opacity: 1;
    }
    .scroll-cue {
      transition: opacity 0.3s ease;
    }
  }

  /* Desktop only. ≤1024px the mobile bottom navbar (and page docks) own the
     bottom-centre lane, and touch scrolling needs no nudge. */
  @media (max-width: 1024px) {
    .scroll-cue { display: none !important; }
  }

  /* Very short landscape screens: the first view is cramped, don't crowd it. */
  @media (max-height: 520px) {
    .scroll-cue { display: none !important; }
  }
</style>

<script>
  (() => {
    const cue = document.querySelector<HTMLButtonElement>("[data-scroll-cue]");
    if (!cue) return;

    const mode = cue.dataset.cueMode === "fixed" ? "fixed" : "hero";
    // Only nudge near the very top of the page. Once the user has scrolled a
    // little the intent is clear, so the cue steps aside.
    const HIDE_AFTER = 40; // px
    const SCROLL_ROOM = 300; // px of real scroll before "fixed" mode bothers

    let hasScroll = false;
    const measure = () => {
      hasScroll =
        document.documentElement.scrollHeight - window.innerHeight > SCROLL_ROOM;
    };

    const update = () => {
      const nearTop = window.scrollY < HIDE_AFTER;
      const ok =
        mode === "fixed"
          ? nearTop && hasScroll
          : nearTop && document.body.classList.contains("hero-in-view");
      cue.dataset.cueVisible = ok ? "true" : "false";
    };

    measure();
    // Seed a first-paint state; hero-in-view / final page height settle async.
    cue.dataset.cueVisible =
      window.scrollY < HIDE_AFTER && (mode !== "fixed" || hasScroll)
        ? "true"
        : "false";

    const remeasure = () => {
      measure();
      update();
    };

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", remeasure, { passive: true });
    window.addEventListener("load", remeasure);
    window.addEventListener("variants-mounted", remeasure);
    // Content / images can grow the page after first paint.
    setTimeout(remeasure, 300);
    setTimeout(remeasure, 1200);

    const go = () => {
      const sel = cue.dataset.scrollTarget;
      const dest = sel ? document.querySelector(sel) : null;
      if (dest) {
        dest.scrollIntoView({ behavior: "smooth", block: "start" });
      } else {
        window.scrollBy({ top: window.innerHeight * 0.9, behavior: "smooth" });
      }
    };

    cue.addEventListener("click", go);
  })();
</script>
