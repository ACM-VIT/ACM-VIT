---
import BlogsCard from "./BlogsCard.astro";
import { reader } from "../utils/reader";
import { getAssetUrl } from "../utils/cdn";

const blogsData = await reader.singletons.blogs.read();
const blogData = blogsData?.items ?? [];

const fallbackCover = "/blogs/placeholder.webp";

type PostMeta = {
  cover: string | null;
  title: string | null;
  author: string | null;
  readingTime: number | null;
  tag: string | null;
};

const emptyMeta: PostMeta = {
  cover: null,
  title: null,
  author: null,
  readingTime: null,
  tag: null,
};

function slugOf(url: string): string | null {
  try {
    const slug = new URL(url).pathname.replace(/^\/|\/$/g, "");
    return slug || null;
  } catch {
    return null;
  }
}

function titleFromSlug(slug: string | null): string {
  if (!slug) return "Untitled";
  return slug
    .split("-")
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}

async function fetchPostMeta(url: string): Promise<PostMeta> {
  try {
    const response = await fetch(url, {
      headers: {
        Accept: "text/html",
        "User-Agent": "Mozilla/5.0 (compatible; AstroBot/1.0)",
      },
      signal: AbortSignal.timeout(20000),
    });

    if (!response.ok) return emptyMeta;

    const html = await response.text();

    const ldMatch = html.match(
      /<script type="application\/ld\+json"[^>]*>([\s\S]*?)<\/script>/
    );

    let cover: string | null = null;
    let title: string | null = null;
    let author: string | null = null;
    let tag: string | null = null;

    if (ldMatch) {
      try {
        const ld = JSON.parse(ldMatch[1]);
        if (typeof ld.headline === "string") title = ld.headline;
        if (typeof ld.author?.name === "string") author = ld.author.name;
        if (typeof ld.image === "string") cover = ld.image;
        else if (typeof ld.image?.url === "string") cover = ld.image.url;
        if (typeof ld.keywords === "string") {
          const first = ld.keywords.split(",")[0]?.trim().replace(/^#/, "");
          tag = first || null;
        }
      } catch {
        return emptyMeta;
      }
    }

    const readMatch = html.match(/readTimeInMinutes\\?":(\d+)/);
    const readingTime = readMatch ? Number(readMatch[1]) : null;

    return { cover, title, author, readingTime, tag };
  } catch {
    return emptyMeta;
  }
}

const blogs = await Promise.all(
  blogData.map(async (blog) => {
    const meta = await fetchPostMeta(blog.link);
    return {
      link: blog.link,
      bgUrl: blog.cover || meta.cover || fallbackCover,
      title: meta.title || titleFromSlug(slugOf(blog.link)),
      author: meta.author ?? undefined,
      readingTime: meta.readingTime ?? undefined,
      tag: meta.tag ?? "Hashnode",
    };
  })
);

const mid = Math.ceil(blogs.length / 2);
const rowTop = blogs.slice(0, mid);
const rowBottom = blogs.slice(mid);
---

<div
  class="flex flex-col space-y-12 md:space-y-16 items-center justify-start pt-16 md:pt-20 w-full min-h-screen"
>
  <div
    class="blogs-title-bar bg-[#F95F4A] w-11/12 rounded-full h-[10vh] md:h-[15vh] lg:h-[20vh] grid grid-cols-[1fr_auto_1fr] items-center px-2 md:px-8 text-stone-900 border border-[#fefcd9]"
  >
    <div
      id="rotate-svg"
      data-type="Filled"
      class="w-12 h-12 md:w-20 md:h-20 lg:w-24 lg:h-24 relative justify-self-start"
    >
      <img
        src={getAssetUrl("/rotate.webp")}
        class="rotate-svg w-full h-full block"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="flex items-center justify-center h-full">
      <span
        class="blogs-title font-normal font-['PolySans_Trial'] text-4xl sm:text-6xl md:text-8xl lg:text-[150px] leading-none text-center transform translate-y-[5%]"
      >
        BLOGS
      </span>
    </div>

    <div
      data-type="Filled"
      class="w-12 h-12 md:w-20 md:h-20 lg:w-24 lg:h-24 relative justify-self-end"
    >
      <img
        src={getAssetUrl("/rotate.webp")}
        class="rotate-svg w-full h-full block"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>

  <div class="w-11/12 md:w-5/6 lg:w-2/3 max-w-6xl justify-start">
    <span
      class="text-[#F95F4A] font-light font-['PolySans_Trial'] uppercase text-base leading-relaxed max-w-4xl max-[640px]:text-[0.95rem] max-[640px]:leading-[1.45] max-[640px]:max-w-[28rem] max-[480px]:text-[0.85rem] max-[480px]:leading-[1.4]"
    >
      Our blogs take you behind the scenes of the technologies shaping the world
      today.
    </span>
    <span
      class="text-white font-light font-['PolySans_Trial'] uppercase text-base leading-relaxed max-w-4xl max-[640px]:text-[0.95rem] max-[640px]:leading-[1.45] max-[640px]:max-w-[28rem] max-[480px]:text-[0.85rem] max-[480px]:leading-[1.4]"
    >
      Whether it’s LLMs, UI/UX, microchips, or Web3, we break it down so anyone
      can follow. Find your next read just below.
    </span>
  </div>

  <div class="blogs-marquee w-full flex flex-col gap-5 md:gap-6" data-blogs-marquee>
    <div class="marquee-viewport" data-marquee-viewport data-speed="65.1">
      <div class="marquee-row">
        {rowTop.map((blog) => <BlogsCard {...blog} />)}
        {rowTop.map((blog) => <BlogsCard {...blog} clone />)}
      </div>
    </div>

    {
      rowBottom.length > 0 && (
        <div
          class="marquee-viewport"
          data-marquee-viewport
          data-speed="50.4"
          data-direction="reverse"
        >
          <div class="marquee-row">
            {rowBottom.map((blog) => (
              <BlogsCard {...blog} />
            ))}
            {rowBottom.map((blog) => (
              <BlogsCard {...blog} clone />
            ))}
          </div>
        </div>
      )
    }
  </div>

  <div class="flex justify-center w-full mt-8">
    <a
      href="https://blog.acmvit.in"
      target="_blank"
      rel="noopener noreferrer"
      class="w-[80%] sm:w-full max-w-sm md:max-w-md lg:max-w-lg xl:max-w-xl px-5 py-2 sm:px-8 sm:py-4 rounded-[41px] border border-[#F95F4A] text-center hover:bg-[#F95F4A] hover:text-white transition-all duration-300 cursor-pointer group block"
    >
      <div
        class="text-white group-hover:text-white text-sm sm:text-base font-light font-['PolySans_Trial'] uppercase tracking-wide"
      >
        <span class="block md:hidden">Still Curious? Dive Deeper</span>
        <span class="hidden md:block"
          >Still Curious? Dive Deeper into Our Brainwaves</span
        >
      </div>
    </a>
  </div>
</div>

<style>
  @media (max-height: 700px) {
    .blogs-title-bar {
      height: clamp(72px, 24vh, 160px);
    }

    .blogs-title {
      font-size: clamp(2rem, 16vh, 6rem);
      line-height: 0.9;
    }
  }

  @media (max-height: 400px) {
    .blogs-title-bar {
      height: clamp(56px, 28vh, 120px);
    }

    .blogs-title {
      font-size: clamp(1.6rem, 14vh, 4rem);
    }
  }
  @media (max-width: 450px) {
    .blogs-title-bar {
      height: clamp(56px, 28vh, 120px);
    }

    .blogs-title {
      font-size: clamp(1.8rem, 14vh, 4rem);
    }
  }
</style>

<style>
  .marquee-viewport {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
  }
  .marquee-viewport::-webkit-scrollbar {
    display: none;
  }

  .marquee-row {
    display: flex;
    width: max-content;
    padding: 0.75rem 0;
  }

  .marquee-viewport.is-dragging {
    cursor: grabbing;
    user-select: none;
  }
  .marquee-viewport.is-dragging :global(a) {
    pointer-events: none;
  }
</style>

<script>
  import { gsap } from "gsap";
  gsap.to(".rotate-svg", {
    rotation: 360,
    repeat: -1,
    duration: 5,
    ease: "linear",
  });

  function initBlogsMarquee() {
    const marquee = document.querySelector<HTMLElement>("[data-blogs-marquee]");
    if (!marquee || marquee.dataset.bmInit === "1") return;
    marquee.dataset.bmInit = "1";

    const viewports = Array.from(
      marquee.querySelectorAll<HTMLElement>("[data-marquee-viewport]")
    );
    if (viewports.length === 0) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const RESUME_DELAY = 2200;

    type Lane = {
      viewport: HTMLElement;
      speed: number;
      direction: number;
      position: number;
      auto: boolean;
      hovering: boolean;
      resumeTimer: number;
      idleTimer: number;
    };

    const lanes: Lane[] = viewports.map((viewport) => ({
      viewport,
      speed: Number(viewport.dataset.speed ?? 55),
      direction: viewport.dataset.direction === "reverse" ? -1 : 1,
      position: 0,
      auto: !reduceMotion,
      hovering: false,
      resumeTimer: 0,
      idleTimer: 0,
    }));

    const halfWidth = (viewport: HTMLElement) => viewport.scrollWidth / 2;

    const prime = () => {
      lanes.forEach((lane) => {
        if (!lane.auto) return;
        const half = halfWidth(lane.viewport);
        if (half <= 0) return;
        lane.position = lane.direction < 0 ? half : 0;
        lane.viewport.scrollLeft = lane.position;
      });
    };

    prime();

    let onScreen = true;
    let frameId = 0;
    let lastFrame = 0;

    const step = (time: number) => {
      const delta = lastFrame ? Math.min(time - lastFrame, 64) : 16;
      lastFrame = time;

      if (onScreen && !document.hidden) {
        for (const lane of lanes) {
          if (!lane.auto || lane.hovering) continue;
          const half = halfWidth(lane.viewport);
          if (half <= 0) continue;
          lane.position += (lane.speed * lane.direction * delta) / 1000;
          if (lane.position >= half) lane.position -= half;
          if (lane.position < 0) lane.position += half;
          lane.viewport.scrollLeft = lane.position;
        }
      }

      frameId = requestAnimationFrame(step);
    };

    const scheduleResume = (lane: Lane) => {
      if (reduceMotion) return;
      window.clearTimeout(lane.resumeTimer);
      lane.resumeTimer = window.setTimeout(() => {
        if (lane.hovering) {
          scheduleResume(lane);
          return;
        }
        lane.position = lane.viewport.scrollLeft;
        lane.auto = true;
      }, RESUME_DELAY);
    };

    const takeOver = (lane: Lane) => {
      lane.auto = false;
      scheduleResume(lane);
    };

    const wrapWhenIdle = (lane: Lane) => {
      const half = halfWidth(lane.viewport);
      if (half <= 0) return;
      if (lane.viewport.scrollLeft >= half) lane.viewport.scrollLeft -= half;
      else if (lane.viewport.scrollLeft <= 0) lane.viewport.scrollLeft += half;
      lane.position = lane.viewport.scrollLeft;
    };

    let dragLane: Lane | null = null;
    let dragStartX = 0;
    let dragStartScroll = 0;
    let dragged = false;
    let suppressClick = false;

    lanes.forEach((lane) => {
      const viewport = lane.viewport;

      viewport.addEventListener(
        "scroll",
        () => {
          if (lane.auto) return;
          window.clearTimeout(lane.idleTimer);
          lane.idleTimer = window.setTimeout(() => wrapWhenIdle(lane), 180);
          scheduleResume(lane);
        },
        { passive: true }
      );

      viewport.addEventListener(
        "wheel",
        (event) => {
          if (Math.abs(event.deltaX) > Math.abs(event.deltaY) || event.shiftKey)
            takeOver(lane);
        },
        { passive: true }
      );

      let touchStartX = 0;
      let touchStartY = 0;

      viewport.addEventListener(
        "touchstart",
        (event) => {
          const touch = event.touches[0];
          if (!touch) return;
          touchStartX = touch.clientX;
          touchStartY = touch.clientY;
        },
        { passive: true }
      );

      viewport.addEventListener(
        "touchmove",
        (event) => {
          const touch = event.touches[0];
          if (!touch) return;
          const deltaX = Math.abs(touch.clientX - touchStartX);
          const deltaY = Math.abs(touch.clientY - touchStartY);
          if (deltaX > deltaY && deltaX > 6) takeOver(lane);
        },
        { passive: true }
      );

      viewport.addEventListener("pointerdown", (event) => {
        if (event.pointerType !== "mouse" || event.button !== 0) return;
        dragLane = lane;
        dragStartX = event.clientX;
        dragStartScroll = viewport.scrollLeft;
        dragged = false;
      });

      viewport.addEventListener(
        "click",
        (event) => {
          if (!suppressClick) return;
          event.preventDefault();
          event.stopPropagation();
        },
        true
      );

      viewport.addEventListener("mouseenter", () => {
        lane.hovering = true;
      });

      viewport.addEventListener("mouseleave", () => {
        lane.hovering = false;
      });
    });

    window.addEventListener("pointermove", (event) => {
      if (!dragLane) return;
      const offset = event.clientX - dragStartX;
      if (!dragged) {
        if (Math.abs(offset) < 8) return;
        dragged = true;
        takeOver(dragLane);
        dragLane.viewport.classList.add("is-dragging");
      }
      dragLane.viewport.scrollLeft = dragStartScroll - offset;
    });

    const endDrag = () => {
      if (!dragLane) return;
      dragLane.viewport.classList.remove("is-dragging");
      if (dragged) {
        suppressClick = true;
        window.setTimeout(() => {
          suppressClick = false;
        }, 60);
        scheduleResume(dragLane);
      }
      dragLane = null;
      dragged = false;
    };

    window.addEventListener("pointerup", endDrag);
    window.addEventListener("pointercancel", endDrag);

    window.addEventListener("load", prime);

    window.addEventListener("resize", () => {
      lanes.forEach((lane) => {
        lane.position = lane.viewport.scrollLeft;
      });
    });

    if ("IntersectionObserver" in window) {
      let primedOnScreen = false;
      const observer = new IntersectionObserver(
        (entries) => {
          onScreen = entries.some((entry) => entry.isIntersecting);
          if (onScreen && !primedOnScreen) {
            primedOnScreen = true;
            prime();
          }
        },
        { rootMargin: "200px 0px" }
      );
      observer.observe(marquee);
    }

    if (!reduceMotion) {
      frameId = requestAnimationFrame(step);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initBlogsMarquee);
  } else {
    initBlogsMarquee();
  }
</script>
