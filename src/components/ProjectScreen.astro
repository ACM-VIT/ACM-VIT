---
import Cassette from "./Cassette.astro";
import { getAssetUrl } from "../utils/cdn";

export interface Props {
  projects: Array<{
    cassette: {
      src?: string | null;
      svg?: string | null;
      alt: string;
    };
    textContent: {
      blocks: string[];
    };
    buttons: {
      primary: {
        backgroundColor: string;
        textColor: string;
        borderColor: string;
        borderRadius?: string;
      };
      visitWebsite: {
        text: string;
        backgroundColor: string;
        textColor: string;
        borderColor: string;
        borderRadius?: string;
        url?: string;
      };
      icons: Array<{
        type: string;
        backgroundColor: string;
        textColor: string;
        borderColor: string;
        iconColor: string;
        borderRadius?: string;
        url?: string;
      }>;
    };
    colors: {
      textColor: string;
      contentBlockBackground: string;
      hoverShadow: string;
    };
  }>;
}

const { projects = [] } = Astro.props;

const toSolid = (c: string) => {
  if (!c) return "#F95F4A";
  if (/gradient/i.test(c)) {
    const hex = c.match(/#[0-9a-fA-F]{3,8}/);
    return hex ? hex[0] : "#F95F4A";
  }
  return c;
};

const items = projects.map((p) => ({
  ...p,
  name: (p.cassette.alt || "").replace(/\s*image$/i, "").trim() || "Project",
  accent: toSolid(p.buttons.primary.backgroundColor),
}));

const sectionHeightVh = Math.max(1, items.length) * 100;
---

<section
  class="proj-showcase relative w-full"
  data-proj-showcase
  style={`height: ${sectionHeightVh}vh;`}
>
  <div class="proj-sticky sticky top-0 h-screen w-full overflow-hidden">
    <div class="proj-grid-bg pointer-events-none absolute inset-0 z-0" aria-hidden="true">
      <span class="grid-v" style="left: var(--gx1)"></span>
      <span class="grid-v" style="right: var(--cass-line-left)"></span>
      <span class="grid-v" style="right: var(--cass-line-right)"></span>
      <span class="grid-h" style="top: var(--gy1)"></span>
      <span class="grid-h" style="top: var(--gy2)"></span>
    </div>

    <div class="proj-text-zone">
      {
        items.map((it, i) => (
          <article
            class:list={["text-panel", { "is-active": i === 0 }]}
            data-text-panel
            data-index={i}
            style={`--proj-color: ${it.accent}; --hoverShadow: ${it.colors.hoverShadow};`}
          >
            <h3 class="panel-title">{it.name}</h3>

            <p class="panel-desc">{it.textContent.blocks[0]}</p>

            <div class="panel-actions">
              <a
                href={it.buttons.visitWebsite.url || "#"}
                target="_blank"
                rel="noopener noreferrer"
                class="panel-btn"
                style={`
                  background: ${it.buttons.visitWebsite.backgroundColor};
                  color: ${it.buttons.visitWebsite.textColor};
                  border-color: ${it.buttons.visitWebsite.borderColor};
                  ${it.buttons.visitWebsite.borderRadius ? `border-radius: ${it.buttons.visitWebsite.borderRadius};` : ""}
                `}
              >
                {it.buttons.visitWebsite.text}
              </a>

              {it.buttons.icons.map((icon) => (
                <a
                  href={icon.url || "#"}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="panel-icon-btn"
                  style={`
                    background: ${icon.backgroundColor};
                    border-color: ${icon.borderColor};
                    ${icon.borderRadius ? `border-radius: ${icon.borderRadius};` : "border-radius: 50%;"}
                  `}
                  aria-label={icon.type}
                >
                  <img
                    src={getAssetUrl(`/${icon.type}-icon.webp`)}
                    alt={icon.type}
                    width="22"
                    style={`filter: brightness(0) saturate(100%) invert(${icon.iconColor === "#FEFCD9" ? "96%" : "0%"});`}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <div class="proj-visual-zone">
      {
        items.map((it, i) => (
          <div
            class:list={["cassette-slide", { "is-active": i === 0 }]}
            data-cassette-slide
            data-index={i}
          >
            {it.cassette.svg ? (
              <img
                class="proj-cassette-art"
                src={getAssetUrl(it.cassette.svg)}
                alt={it.cassette.alt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Cassette
                overlaySrc={it.cassette.src ? getAssetUrl(it.cassette.src) : undefined}
                alt={it.cassette.alt}
                color={it.accent}
              />
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .proj-sticky {
    --gx1: 5%;
    --gy1: 16%;
    --gy2: 84%;

    --cass-right: clamp(28px, 4.5vw, 84px);
    --cass-w: clamp(280px, min(40vw, 105vh), 560px);
    --cass-gap: clamp(14px, 1.8vw, 34px);

    --cass-line-right: calc(var(--cass-right) - var(--cass-gap));
    --cass-line-left: calc(var(--cass-right) + var(--cass-w) + var(--cass-gap));
  }

  .proj-grid-bg {
    --prog: 0%;
    --dot-base: rgba(254, 252, 217, 0.12);
    --dot-fill: rgba(254, 252, 217, 0.55);
  }
  .grid-v {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: repeating-linear-gradient(
      to bottom,
      var(--dot-base) 0 3px,
      transparent 3px 17px
    );
  }
  .grid-v::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      var(--dot-fill) 0 3px,
      transparent 3px 17px
    );
    -webkit-mask: linear-gradient(
      to bottom,
      #000 0 var(--prog),
      transparent var(--prog)
    );
    mask: linear-gradient(
      to bottom,
      #000 0 var(--prog),
      transparent var(--prog)
    );
  }
  .grid-h {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: repeating-linear-gradient(
      to right,
      var(--dot-base) 0 3px,
      transparent 3px 17px
    );
  }
  .grid-h::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to right,
      var(--dot-fill) 0 3px,
      transparent 3px 17px
    );
    -webkit-mask: linear-gradient(
      to right,
      #000 0 var(--prog),
      transparent var(--prog)
    );
    mask: linear-gradient(
      to right,
      #000 0 var(--prog),
      transparent var(--prog)
    );
  }

  .proj-text-zone {
    position: absolute;
    z-index: 10;
    left: var(--gx1);
    right: calc(var(--cass-line-left) + clamp(16px, 1.6vw, 30px));
    top: var(--gy1);
    bottom: calc(100% - var(--gy2));
    padding: clamp(16px, 2.4vh, 34px) clamp(20px, 2.6vw, 48px);
  }

  .proj-visual-zone {
    position: absolute;
    z-index: 10;
    right: var(--cass-right);
    width: var(--cass-w);
    top: var(--gy1);
    bottom: calc(100% - var(--gy2));
  }

  .proj-cassette-art {
    width: 100%;
    height: auto;
    display: block;
  }

  .text-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: inherit;
    opacity: 0;
    transform: translateY(28px);
    pointer-events: none;
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .text-panel.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .panel-title {
    margin: 0;
    font-family: "PolySans Trial", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
    font-size: clamp(1.9rem, 3.2vw, 3.2rem);
    color: #fefcd9;
  }

  .panel-desc {
    margin: clamp(0.8rem, 1.6vh, 1.4rem) 0 0;
    max-width: 34rem;
    font-family: "PolySans Trial", sans-serif;
    font-weight: 300;
    font-size: clamp(0.9rem, 1.02vw, 1.1rem);
    line-height: 1.55;
    color: rgba(254, 252, 217, 0.8);
  }

  .panel-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1rem, 1.6vw, 1.9rem);
    margin-top: clamp(1rem, 2.2vh, 1.9rem);
  }

  .panel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 20px;
    border: 1px solid;
    border-radius: 25px;
    font-family: "PolySans Trial", sans-serif;
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .panel-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px var(--hoverShadow);
  }

  .panel-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .panel-icon-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px var(--hoverShadow);
  }

  .cassette-slide {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: rotate(-7deg) scale(0.82);
    transition:
      opacity 0.6s ease,
      transform 0.7s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .cassette-slide.is-active {
    opacity: 1;
    transform: none;
  }
  .cassette-slide.is-prev {
    opacity: 0;
    transform: rotate(7deg) scale(0.82);
  }

  @media (prefers-reduced-motion: reduce) {
    .text-panel,
    .cassette-slide {
      transition: opacity 0.3s ease;
      transform: none !important;
    }
  }

  @media (max-width: 768px) {
    .proj-showcase {
      height: auto !important;
    }
    .proj-sticky {
      position: static;
      height: auto;
      padding: 3rem 1.25rem;
    }
    .proj-grid-bg {
      display: none;
    }
    .proj-text-zone,
    .proj-visual-zone {
      position: static;
      padding: 0;
    }
    .proj-visual-zone {
      margin-top: 2rem;
    }
    .text-panel,
    .cassette-slide {
      position: static;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .cassette-slide + .cassette-slide,
    .text-panel + .text-panel {
      margin-top: 3rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let mounted: HTMLElement | null = null;
  let cleanup: (() => void) | null = null;

  function initProjectScreen() {
    const section = document.querySelector<HTMLElement>("[data-proj-showcase]");

    if (mounted && mounted !== section) {
      cleanup?.();
      cleanup = null;
      mounted = null;
    }
    if (!section || section.dataset.psInit === "1") return;
    section.dataset.psInit = "1";
    mounted = section;

    const textPanels = Array.from(
      section.querySelectorAll<HTMLElement>("[data-text-panel]"),
    );
    const cassettes = Array.from(
      section.querySelectorAll<HTMLElement>("[data-cassette-slide]"),
    );
    const gridBg = section.querySelector<HTMLElement>(".proj-grid-bg");
    const n = textPanels.length;
    if (n === 0) return;

    let active = -1;
    const setActive = (idx: number) => {
      if (idx === active) return;
      active = idx;
      textPanels.forEach((p, i) => p.classList.toggle("is-active", i === idx));
      cassettes.forEach((c, i) => {
        c.classList.toggle("is-active", i === idx);
        c.classList.toggle("is-prev", i < idx);
      });
    };

    setActive(0);

    const st = ScrollTrigger.create({
      trigger: section,
      start: "top top",
      end: "bottom bottom",
      invalidateOnRefresh: true,
      onUpdate: (self) => {
        const idx = Math.min(
          n - 1,
          Math.max(0, Math.round(self.progress * (n - 1))),
        );
        setActive(idx);
        if (gridBg)
          gridBg.style.setProperty(
            "--prog",
            `${(self.progress * 100).toFixed(2)}%`,
          );
      },
    });

    cleanup = () => st.kill();
    requestAnimationFrame(() => ScrollTrigger.refresh());
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectScreen);
  } else {
    initProjectScreen();
  }
  window.addEventListener("variants-mounted", () => initProjectScreen());
</script>
