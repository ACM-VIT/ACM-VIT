---
// The site's signature boombox (from src/sections/Socials.astro), lifted into a
// standalone, full-height component for the Content Studio login art. Same
// markup + styles as the original - handle, tuner marquee, EQ, speakers, the
// glass cassette with spinning reels, control knobs and transport - minus the
// socials title + social-button grid (not relevant on the login screen) and the
// scroll-scene wrapper. Reels + marquee animate via pure CSS.
---

<div class="sb-host">
  <div class="boombox">
    <!-- ── Handle ── -->
    <div class="boombox-handle">
      <div class="handle-post handle-post-l"></div>
      <div class="handle-bar">
        <span class="handle-grip"></span>
        <span class="handle-grip"></span>
        <span class="handle-grip"></span>
        <span class="handle-grip"></span>
        <span class="handle-grip"></span>
      </div>
      <div class="handle-post handle-post-r"></div>
    </div>

    <!-- ── Main Body ── -->
    <div class="boombox-body">
      <div class="bb-screw bb-screw-tl"></div>
      <div class="bb-screw bb-screw-tr"></div>
      <div class="bb-screw bb-screw-bl"></div>
      <div class="bb-screw bb-screw-br"></div>

      <!-- Tuner / Marquee -->
      <div class="tuner-row">
        <div class="tuner-strip">
          <div class="tuner-marks" aria-hidden="true"></div>
          <div class="tuner-needle"></div>
          <div class="tuner-marquee">
            <span>NOW PLAYING&ensp;-&ensp;ACM·VIT CONTENT STUDIO&ensp;-&ensp;BUILD THE FUTURE&ensp;-&ensp;NOW PLAYING&ensp;-&ensp;ACM·VIT CONTENT STUDIO&ensp;-&ensp;BUILD THE FUTURE&ensp;-&ensp;</span>
          </div>
        </div>
      </div>

      <!-- EQ -->
      <div class="eq-row">
        {Array.from({ length: 20 }).map((_, i) => (
          <div class:list={["eq-btn", i % 3 === 0 ? "eq-btn-accent" : ""]}></div>
        ))}
      </div>

      <!-- Main: speakers + center -->
      <div class="boombox-main">
        <div class="speaker-wrap">
          <div class="speaker">
            <div class="speaker-grill"></div>
            <div class="speaker-ring speaker-ring-outer"></div>
            <div class="speaker-ring speaker-ring-mid"></div>
            <div class="speaker-dome"></div>
          </div>
        </div>

        <div class="center-panel">
          <div class="cassette-deck">
            <div class="cassette-slot">
              <svg class="cassette-svg" viewBox="0 0 280 175" xmlns="http://www.w3.org/2000/svg">
                <rect class="cassette-body" x="0.75" y="0.75" width="278.5" height="173.5" rx="11" />
                <path class="cassette-cover" d="M 18 10 L 22 10 L 28 16 L 252 16 L 258 10 L 262 10 Q 266 10 266 14 L 266 120 L 14 120 L 14 14 Q 14 10 18 10 Z" />
                <line class="cover-line" x1="20" y1="22" x2="260" y2="22" />
                <line class="cover-line" x1="20" y1="114" x2="260" y2="114" />
                <!-- Left reel -->
                <g class="reel reel-left">
                  <circle cx="92" cy="62" r="24" class="reel-outer" />
                  <circle cx="92" cy="62" r="16" class="reel-mid" />
                  <circle cx="92" cy="62" r="5.5" class="reel-hub" />
                  <g class="reel-spokes-l" style="transform-origin: 92px 62px">
                    <line x1="92" y1="43" x2="92" y2="38" class="reel-spoke" />
                    <line x1="92" y1="43" x2="92" y2="38" class="reel-spoke" transform="rotate(60, 92, 62)" />
                    <line x1="92" y1="43" x2="92" y2="38" class="reel-spoke" transform="rotate(120, 92, 62)" />
                    <line x1="92" y1="43" x2="92" y2="38" class="reel-spoke" transform="rotate(180, 92, 62)" />
                    <line x1="92" y1="43" x2="92" y2="38" class="reel-spoke" transform="rotate(240, 92, 62)" />
                    <line x1="92" y1="43" x2="92" y2="38" class="reel-spoke" transform="rotate(300, 92, 62)" />
                  </g>
                  <circle cx="92" cy="62" r="19" class="reel-tape reel-tape-left" />
                </g>
                <!-- Right reel -->
                <g class="reel reel-right">
                  <circle cx="188" cy="62" r="24" class="reel-outer" />
                  <circle cx="188" cy="62" r="16" class="reel-mid" />
                  <circle cx="188" cy="62" r="5.5" class="reel-hub reel-hub-accent" />
                  <g class="reel-spokes-r" style="transform-origin: 188px 62px">
                    <line x1="188" y1="43" x2="188" y2="38" class="reel-spoke" />
                    <line x1="188" y1="43" x2="188" y2="38" class="reel-spoke" transform="rotate(60, 188, 62)" />
                    <line x1="188" y1="43" x2="188" y2="38" class="reel-spoke" transform="rotate(120, 188, 62)" />
                    <line x1="188" y1="43" x2="188" y2="38" class="reel-spoke" transform="rotate(180, 188, 62)" />
                    <line x1="188" y1="43" x2="188" y2="38" class="reel-spoke" transform="rotate(240, 188, 62)" />
                    <line x1="188" y1="43" x2="188" y2="38" class="reel-spoke" transform="rotate(300, 188, 62)" />
                  </g>
                  <circle cx="188" cy="62" r="10" class="reel-tape reel-tape-right" />
                </g>
                <path class="tape-path" d="M 68 62 A 24 24 0 0 0 92 86 L 188 86 A 24 24 0 0 0 212 62" />
                <rect class="tape-window" x="118" y="73" width="44" height="16" rx="3" />
                <circle class="center-post" cx="140" cy="62" r="2.5" />
                <rect class="cassette-label" x="58" y="95" width="164" height="18" rx="9" />
                <text class="label-text" x="140" y="107" text-anchor="middle" dominant-baseline="middle">BECAUSE TECHNOLOGY MATTERS</text>
                <path class="cassette-bump" d="M 85 132 L 98 158 Q 100 162 104 162 L 176 162 Q 180 162 182 158 L 195 132" />
                <g class="pin-holes">
                  <circle cx="90" cy="143" r="1.8" />
                  <circle cx="102" cy="143" r="1.8" />
                  <circle cx="114" cy="143" r="1.8" />
                  <circle cx="126" cy="143" r="1.8" />
                  <circle cx="140" cy="143" r="2.2" />
                  <circle cx="154" cy="143" r="1.8" />
                  <circle cx="166" cy="143" r="1.8" />
                  <circle cx="178" cy="143" r="1.8" />
                  <circle cx="190" cy="143" r="1.8" />
                </g>
              </svg>
            </div>
          </div>

          <!-- Knobs -->
          <div class="knob-console">
            {["VOL", "SEEK", "SPEED", "TRACK"].map((label) => (
              <div class="knob-unit">
                <div class="tuner-knob"><div class="tuner-knob-inner"></div><span class="knob-notch"></span></div>
                <span class="knob-label">{label}</span>
              </div>
            ))}
          </div>

          <!-- Transport -->
          <div class="transport-row">
            <span class="transport-btn"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M11 18V6l-8.5 6 8.5 6zm.5-6l8.5 6V6l-8.5 6z"/></svg></span>
            <span class="transport-btn"><svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="1"/></svg></span>
            <span class="transport-btn transport-play"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
            <span class="transport-btn"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M4 18l8.5-6L4 6v12zm9-12v12l8.5-6L13 6z"/></svg></span>
          </div>
        </div>

        <div class="speaker-wrap">
          <div class="speaker">
            <div class="speaker-grill"></div>
            <div class="speaker-ring speaker-ring-outer"></div>
            <div class="speaker-ring speaker-ring-mid"></div>
            <div class="speaker-dome"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Full-height stage that seats the boombox inside the login art panel. */
  .sb-host {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: stretch;
    justify-content: center;
    padding: clamp(1rem, 2.5vw, 2rem);
    background: radial-gradient(120% 90% at 50% 15%, #2a2530, #141018 72%);
  }

  /* Fill the full height of the login art panel. */
  .boombox { width: 100%; max-width: 44rem; height: 100%; position: relative; display: flex; flex-direction: column; }

  /* ── Handle ── */
  .boombox-handle { display: flex; align-items: flex-end; justify-content: center; height: 44px; padding: 0 18%; position: relative; z-index: 2; }
  .handle-post { width: 14px; height: 36px; background: linear-gradient(180deg, #2a3240 0%, #222a36 100%); border: 1.5px solid rgba(255,255,255,0.06); border-bottom: none; border-radius: 4px 4px 0 0; flex-shrink: 0; }
  .handle-bar { flex: 1; height: 18px; background: linear-gradient(180deg, #343e4e 0%, #2a3240 100%); border: 1.5px solid rgba(255,255,255,0.08); border-bottom: none; border-radius: 6px 6px 0 0; display: flex; align-items: center; justify-content: center; gap: 10px; padding: 0 12px; }
  .handle-grip { width: 10px; height: 8px; border-radius: 3px; background: #1a2030; border: 1px solid rgba(255,255,255,0.06); }

  /* ── Body ── */
  /* Body stays ACM orange; only the checkerboard "checks" cycle through the five
     domain accent colours. --check-c is a registered custom property so it
     interpolates smoothly between domains. */
  @property --check-c {
    syntax: '<color>';
    inherits: false;
    initial-value: #9B51E0;
  }
  .boombox-body {
    position: relative;
    background: linear-gradient(180deg, #ff7a66 0%, #fb6b53 15%, #F95F4A 50%, #e8513d 85%, #d4452f 100%);
    border: 2.5px solid rgba(255,255,255,0.12); border-radius: 18px;
    box-shadow: inset 0 2px 0 rgba(255,255,255,0.06), inset 0 -3px 8px rgba(0,0,0,0.4), 0 30px 80px rgba(0,0,0,0.6), 0 10px 30px rgba(0,0,0,0.4);
    padding: 16px 20px 20px; display: flex; flex-direction: column; gap: 12px; overflow: hidden;
    flex: 1; min-height: 0;
  }
  .boombox-body::before {
    content: ''; position: absolute; inset: 0;
    /* fallback (older WebKit without color-mix): the original dark checks */
    background-image:
      linear-gradient(45deg, rgba(0,0,0,0.07) 25%, transparent 25%, transparent 75%, rgba(0,0,0,0.07) 75%),
      linear-gradient(45deg, rgba(0,0,0,0.07) 25%, transparent 25%, transparent 75%, rgba(0,0,0,0.07) 75%);
    /* domain-tinted checks */
    background-image:
      linear-gradient(45deg, color-mix(in srgb, var(--check-c) 55%, transparent) 25%, transparent 25%, transparent 75%, color-mix(in srgb, var(--check-c) 55%, transparent) 75%),
      linear-gradient(45deg, color-mix(in srgb, var(--check-c) 55%, transparent) 25%, transparent 25%, transparent 75%, color-mix(in srgb, var(--check-c) 55%, transparent) 75%);
    background-position: 0 0, 22px 22px; background-size: 44px 44px;
    opacity: 0.7; pointer-events: none; z-index: 0;
    animation: checkCycle 30s ease-in-out infinite;
  }
  /* tech, design, research, management, cc */
  @keyframes checkCycle {
    0%, 100% { --check-c: #9B51E0; }
    20% { --check-c: #FF0054; }
    40% { --check-c: #135DE2; }
    60% { --check-c: #008080; }
    80% { --check-c: #42CD9D; }
  }
  .boombox-body > .tuner-row, .boombox-body > .eq-row, .boombox-body > .boombox-main { position: relative; z-index: 1; }

  .bb-screw { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: radial-gradient(circle at 40% 40%, #F95F4A, #c4442e); opacity: 0.55; z-index: 10; box-shadow: inset 0 -1px 2px rgba(0,0,0,0.4); }
  .bb-screw-tl { top: 10px; left: 10px; } .bb-screw-tr { top: 10px; right: 10px; } .bb-screw-bl { bottom: 10px; left: 10px; } .bb-screw-br { bottom: 10px; right: 10px; }

  /* ── Tuner ── */
  .tuner-row { display: flex; align-items: center; gap: 10px; padding: 0 8px; }
  .tuner-strip { flex: 1; height: 30px; background: #060a10; border: 1.5px solid rgba(255,255,255,0.06); border-radius: 6px; position: relative; overflow: hidden; }
  .tuner-marks { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0px, transparent 8px, rgba(255,255,255,0.06) 8px, rgba(255,255,255,0.06) 9px); z-index: 0; }
  .tuner-needle { position: absolute; top: 2px; bottom: 2px; left: 52%; width: 2px; background: #F95F4A; border-radius: 1px; box-shadow: 0 0 6px rgba(249,95,74,0.6); z-index: 2; }
  .tuner-marquee { position: absolute; inset: 0; display: flex; align-items: center; overflow: hidden; z-index: 1; }
  .tuner-marquee span { font-family: 'PolySans Mono', monospace; font-size: 10px; color: rgba(249,95,74,0.7); letter-spacing: 0.15em; text-transform: uppercase; white-space: nowrap; animation: marqueeScroll 20s linear infinite; text-shadow: 0 0 6px rgba(249,95,74,0.3); }
  @keyframes marqueeScroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  /* ── Knobs ── */
  .knob-console { display: flex; align-items: flex-start; justify-content: center; gap: clamp(16px, 4vw, 40px); padding: 4px 0 2px; }
  .knob-unit { display: flex; flex-direction: column; align-items: center; gap: 5px; flex-shrink: 0; }
  .knob-label { font-family: 'PolySans Mono', monospace; font-size: 9px; letter-spacing: 0.14em; color: rgba(254,252,217,0.8); text-shadow: 0 1px 2px rgba(0,0,0,0.4); }
  .tuner-knob { position: relative; width: 52px; height: 52px; border-radius: 50%; background: radial-gradient(circle at 38% 30%, #232f3d 0%, #11161e 55%, #070a0f 100%); border: 2px solid rgba(255,255,255,0.16); display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: inset 0 -3px 6px rgba(0,0,0,0.6), inset 0 2px 3px rgba(255,255,255,0.08), 0 3px 8px rgba(0,0,0,0.5); }
  .tuner-knob-inner { width: 22px; height: 22px; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #2a3848, #141c26); border: 1px solid rgba(255,255,255,0.12); box-shadow: inset 0 1px 2px rgba(255,255,255,0.06); }
  .knob-notch { position: absolute; top: 4px; left: 50%; width: 3px; height: 12px; margin-left: -1.5px; border-radius: 2px; background: #F95F4A; box-shadow: 0 0 6px rgba(249,95,74,0.8); }

  /* ── EQ ── */
  .eq-row { display: flex; align-items: center; justify-content: center; gap: 4px; padding: 2px 30px; }
  .eq-btn { width: 100%; max-width: 40px; height: 14px; border-radius: 3px; background: #0e141c; border: 1px solid rgba(255,255,255,0.04); }
  .eq-btn-accent { border-color: rgba(249,95,74,0.15); }

  /* ── Main / Speakers ── */
  .boombox-main { display: flex; align-items: stretch; gap: 16px; flex: 1; min-height: 0; }
  .speaker-wrap { flex: 0 0 28%; display: flex; align-items: center; justify-content: center; padding: 8px; }
  .speaker { width: 100%; aspect-ratio: 1; border-radius: 50%; background: #0a0e14; position: relative; box-shadow: inset 0 4px 20px rgba(0,0,0,0.5), inset 0 -2px 10px rgba(0,0,0,0.3), 0 2px 8px rgba(0,0,0,0.3); overflow: hidden; }
  .speaker-grill { position: absolute; inset: 6%; border-radius: 50%; background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1.2px, transparent 1.2px); background-size: 8px 8px; }
  .speaker-ring { position: absolute; border-radius: 50%; border: 1px solid rgba(255,255,255,0.04); pointer-events: none; }
  .speaker-ring-outer { inset: 12%; } .speaker-ring-mid { inset: 30%; }
  .speaker-dome { position: absolute; inset: 40%; border-radius: 50%; background: radial-gradient(circle at 40% 35%, rgba(255,255,255,0.06), rgba(0,0,0,0.2)); border: 1px solid rgba(255,255,255,0.05); }
  /* gentle idle pulse so the speakers feel alive on the login screen */
  .speaker-dome, .speaker-ring-mid { transform-origin: center; animation: sbThump 1.4s ease-in-out infinite; }
  .speaker-wrap:last-child .speaker-dome, .speaker-wrap:last-child .speaker-ring-mid { animation-delay: 0.35s; }
  @keyframes sbThump { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }

  /* ── Center panel ── */
  .center-panel { flex: 1; display: flex; flex-direction: column; gap: 10px; min-width: 0; justify-content: center; }
  .cassette-deck { display: flex; align-items: center; justify-content: center; flex: 1; min-height: 0; overflow: hidden; }
  .cassette-slot { position: relative; width: 100%; max-width: 480px; max-height: 100%; aspect-ratio: 280 / 120; overflow: hidden; border-radius: 14px 14px 0 0; }
  .cassette-svg { width: 100%; height: auto; display: block; }
  .cassette-slot::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 26px; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.35) 45%, transparent 100%); box-shadow: inset 0 -2px 4px rgba(0,0,0,0.6); border-top: 1px solid rgba(0,0,0,0.5); pointer-events: none; }
  .cassette-body { fill: #161616; stroke: rgba(255,255,255,0.15); stroke-width: 1.5; }
  .cassette-cover { fill: #0d0d0d; stroke: rgba(255,255,255,0.12); stroke-width: 0.75; }
  .cover-line { stroke: rgba(255,255,255,0.14); stroke-width: 0.5; }
  .reel-outer { fill: none; stroke: rgba(255,255,255,0.4); stroke-width: 1.2; }
  .reel-mid { fill: none; stroke: rgba(255,255,255,0.22); stroke-width: 0.8; }
  .reel-hub { fill: none; stroke: rgba(255,255,255,0.55); stroke-width: 1.5; }
  .reel-hub-accent { stroke: #FEFCD9; }
  .reel-spoke { stroke: rgba(255,255,255,0.3); stroke-width: 1.5; stroke-linecap: round; }
  .reel-tape { fill: none; stroke: rgba(255,255,255,0.14); stroke-width: 5; }
  .reel-tape-left { stroke-width: 7; stroke: rgba(255,255,255,0.17); }
  .reel-tape-right { stroke-width: 3; stroke: rgba(255,255,255,0.12); }
  .reel-spokes-l { animation: reelSpin 2s linear infinite; }
  .reel-spokes-r { animation: reelSpin 1.4s linear infinite; }
  @keyframes reelSpin { to { transform: rotate(-360deg); } }
  .tape-path { fill: none; stroke: rgba(255,255,255,0.2); stroke-width: 0.8; }
  .tape-window { fill: rgba(0,0,0,0.22); stroke: rgba(255,255,255,0.2); stroke-width: 0.6; }
  .center-post { fill: rgba(255,255,255,0.35); }
  .cassette-label { fill: none; stroke: rgba(255,255,255,0.24); stroke-width: 0.8; }
  .label-text { font-family: 'PolySans Mono', 'Courier New', monospace; font-size: 5px; letter-spacing: 0.1em; fill: rgba(254,252,217,0.85); font-weight: 500; text-transform: uppercase; }
  .cassette-bump { fill: none; stroke: rgba(255,255,255,0.2); stroke-width: 0.8; }
  .pin-holes circle { fill: rgba(255,255,255,0.2); }

  /* ── Transport ── */
  .transport-row { display: flex; align-items: center; justify-content: center; gap: 6px; }
  .transport-btn { width: 36px; height: 30px; border-radius: 5px; background: #0e141c; border: 1.5px solid rgba(255,255,255,0.06); box-shadow: inset 0 -1px 2px rgba(0,0,0,0.3), 0 2px 4px rgba(0,0,0,0.3); color: rgba(254,252,217,0.35); display: flex; align-items: center; justify-content: center; }
  .transport-play { width: 38px; height: 32px; background: #FEFCD9; border-color: rgba(0,0,0,0.2); color: #1a1a1a; border-radius: 6px; box-shadow: 0 0 10px rgba(254,252,217,0.25), 0 2px 4px rgba(0,0,0,0.35); }

  @media (max-width: 860px) {
    .boombox { max-height: none; }
    .knob-console { gap: 18px; }
  }
  @media (max-width: 640px) {
    .speaker-wrap { display: none; }
    .boombox-body { padding: 12px 12px 16px; gap: 8px; }
    .eq-row { padding: 2px 10px; gap: 3px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reel-spokes-l, .reel-spokes-r, .tuner-marquee span, .speaker-dome, .speaker-ring-mid, .boombox-body::before { animation: none; }
  }
</style>
