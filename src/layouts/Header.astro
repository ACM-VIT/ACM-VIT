---
// Header.astro
import { getAssetUrl } from "../utils/cdn";
import MobileNavbar from "../components/ui/MobileNavbar.astro";
import { teamYears, yearLabel } from "../data/teamData";
import { getAllPosts } from "../lib/blog";

// ── Dynamic dropdown data ───────────────────────────────────────────────────
// Team: boards for the last 5 years, each linking to its block on /team.
const boardYears = teamYears.slice(0, 5);
// Blogs: the 6 latest posts across Hashnode + Medium (memoised at build time).
const latestPosts = (await getAllPosts().catch(() => [])).slice(0, 6);

export interface Props {
  /** When set, replaces the dot nav with a compact subpage pill (page title + back button). */
  pageTitle?: string;
  /** Where the back button navigates. Defaults to "/#<pageTitle lowercase>". */
  backHref?: string;
}

const { pageTitle, backHref } = Astro.props;
const isSubpage = !!pageTitle;
const resolvedBackHref = backHref || `/#${(pageTitle || '').toLowerCase().replace(/\s+/g, '-')}`;

interface DropdownItem {
  title: string;
  desc: string;
  href: string;
  img: string;
  color?: string;
  /** Full-width "view all" CTA tile - text only, spans the whole panel row. */
  all?: boolean;
}

const dropdowns: Record<string, DropdownItem[]> = {
  about: [
    { title: "ACM-VIT", desc: "Our chapter's mission & culture", href: "/#about-acmvit", img: "/about/about-acmvit-cassette.webp" },
    { title: "VIT University", desc: "One of India's top tech universities", href: "/#about-vit", img: "/about/about-vit-cassette.webp" },
    { title: "ACM Global", desc: "World's largest computing society", href: "/#about-acm", img: "/about/about-acm-cassette.webp" },
  ],
  community: [
    { title: "Outreach", desc: "Beyond The Norm workshops for schools", href: "/community#community-outreach", img: "/outreach/outreach-event.webp" },
    { title: "SDG Initiative", desc: "Digital learning for rural communities", href: "/community#community-sdg", img: "/outreach/outreach-beyond-norm-logo.webp" },
    { title: "International Award", desc: "Outstanding School Service", href: "/community#community-award", img: "/ui/ui-acm-celeb.webp" },
    { title: "Code of Conduct", desc: "ACM ethical principles & values", href: "/community#community-conduct", img: "/logos/logos-acm-logo-black.webp" },
    { title: "ACM-W", desc: "Inclusion & women in tech", href: "/community#acm-w", img: "/logos/logos-acmw-logo.webp" },
  ],
  domains: [
    { title: "Tech", desc: "App Dev, Web, FOSS, DevOps", href: "/domains/tech", img: "/cassettes/cassettes-cassette-tech.webp", color: "#9B51E0" },
    { title: "Competitive Coding", desc: "Codeforces, ICPC, C++", href: "/domains/cc", img: "/cassettes/cassettes-cassette-cc.webp", color: "#42CD9D" },
    { title: "Design", desc: "UI/UX, Motion Graphics, 3D", href: "/domains/design", img: "/cassettes/cassettes-cassette-design.webp", color: "#FF0054" },
    { title: "Research", desc: "AI/ML, Blockchain, Quantum", href: "/domains/research", img: "/cassettes/cassettes-cassette-research.webp", color: "#135DE2" },
    { title: "Management", desc: "Operations & coordination", href: "/domains/management", img: "/cassettes/cassettes-cassette-management.webp", color: "#008080" },
  ],
  events: [
    { title: "Code2Create", desc: "24-hour hackathon", href: "/events/code2create", img: "/events/events-c2c-cassette.webp" },
    { title: "Cryptic Hunt", desc: "Online cryptographic treasure hunt", href: "/events/cryptic-hunt", img: "/events/events-cryptic-hunt-cassette.webp" },
    { title: "inspiHer", desc: "Celebrating women in technology", href: "/events/inspiher", img: "/events/events-inspiher-cassette.webp" },
    { title: "Forktober", desc: "Open source contribution drive", href: "/events/forktober", img: "/events/events-forktober-cassette.webp" },
    { title: "The Neural Hack", desc: "Deep dive into AI & ML", href: "/events/neural-hack", img: "/events/events-neural-hack-cassette.webp" },
    { title: "All Events", desc: "Browse every event we run", href: "/events", img: "", all: true },
  ],
  projects: [
    { title: "Conclave", desc: "Real-time meetings platform, built from scratch", href: "/projects/conclave", img: getAssetUrl("/projects/cassettes/projects-cassettes-conclave.svg") },
    { title: "ExamCooker", desc: "Exam prep hub for VIT students", href: "/projects/examcooker", img: getAssetUrl("/projects/projects-examcooker.svg") },
    { title: "CLI RPG", desc: "Terminal-based role-playing game", href: "/projects/cli-rpg", img: getAssetUrl("/projects/projects-cli-rpg.svg") },
    { title: "UniPool", desc: "Campus carpooling made easy", href: "/projects/unipool", img: getAssetUrl("/projects/projects-unipool.svg") },
    { title: "Localhost", desc: "Local development toolkit", href: "/projects/localhost", img: getAssetUrl("/projects/projects-localhost.svg") },
    { title: "OCS Website", desc: "Open community showcase site", href: "/projects/ocs-26", img: getAssetUrl("/projects/projects-cover.svg") },
    { title: "All Projects", desc: "Browse every project we build", href: "/projects", img: "", all: true },
  ],
  "acm-w": [
    { title: "Our Mission", desc: "Supporting women in computing", href: "/#acm-w", img: "/logos/logos-acmw-logo.webp" },
    { title: "Initiatives", desc: "Programs & activities", href: "/#acm-w-content", img: "/acmw/acmw-acmwmotto.webp" },
    { title: "Showcase", desc: "Highlights of our work", href: "/#acm-w-bento", img: "/acmw/acmw-bento.webp" },
  ],
  team: [
    ...boardYears.map((year) => ({
      title: `${year} Board`,
      desc: `The ${yearLabel(year)} board`,
      href: `/team#year-${year}`,
      img: `/cassettes/cassettes-team-${year}.svg`,
    })),
    { title: "Full Team", desc: "Meet everyone, year by year", href: "/team", img: "", all: true },
  ],
  blogs: [
    ...latestPosts.map((post) => ({
      title: post.title,
      desc: `${post.source === "hashnode" ? "Hashnode" : "Medium"} · ${post.readingTime} min read`,
      href: `/blogs/${post.source}/${post.slug}`,
      img: post.coverImage || "/blogs/blogs-placeholder.webp",
    })),
    { title: "All Blogs", desc: "Browse every article we've published", href: "/blogs", img: "", all: true },
  ],
  gallery: [
    { title: "2026", desc: "This year's events & candids", href: "/gallery#gallery-year-2026", img: "/cassettes/cassettes-year-2026.svg" },
    { title: "2025", desc: "Events, boards & late nights", href: "/gallery#gallery-year-2025", img: "/cassettes/cassettes-year-2025.svg" },
    { title: "2024", desc: "Events, boards & late nights", href: "/gallery#gallery-year-2024", img: "/cassettes/cassettes-year-2024.svg" },
    { title: "2023", desc: "Events, boards & late nights", href: "/gallery#gallery-year-2023", img: "/cassettes/cassettes-year-2023.svg" },
    { title: "All Photos", desc: "Browse the full gallery", href: "/gallery", img: "", all: true },
  ],
  more: [
    { title: "FAQs", desc: "Everything you wanted to know, answered", href: "/faqs", img: "/icons/icons-faq.svg" },
    { title: "Design Guide", desc: "Brand marks, colors, type & the rules we bend", href: "/design", img: "/cassettes/cassettes-cassette-design.webp" },
    { title: "Code of Conduct", desc: "ACM ethical principles & values", href: "/code-of-conduct", img: "/logos/logos-acm-logo-black.webp" },
    { title: "Merchandise", desc: "Official ACM-VIT merch & collectibles", href: "/merchandise", img: getAssetUrl("/merch/2025/black-back/merch-2025-black-back-design.webp") },
    { title: "GREP Newsletter", desc: "Our bi-annual technical newsletter", href: "/grep", img: "/grep/grep-wordmark.png" },
    { title: "z0d1ak", desc: "ACM-VIT's competitive CTF team", href: "/z0d1ak", img: "/z0d1ak/z0d1ak-logo.svg" },
    { title: "Achievements", desc: "Awards, recognitions & milestones", href: "/achievements", img: "/ui/ui-trophy.webp" },
    { title: "Cassette Builder", desc: "Design your own custom cassette", href: "/cassette-builder", img: "/cassettes/cassettes-cassette-tech.webp" },
    { title: "Calendar", desc: "Upcoming events & important dates", href: "/calendar", img: "/icons/icons-calendar.svg" },
  ],
};
---

<header
  class="site-header fixed top-5 left-0 right-0 z-50 w-full px-4 py-2 pointer-events-none"
>
  <div
    class="header-inner relative max-w-fit mx-auto flex justify-center pointer-events-auto"
  >
    <nav aria-label="Primary">
      <!-- Desktop nav -->
      <div class="nav-desktop">
        <div class="pill-island-wrap" id="pillIslandWrap">
        <div class={`header-pill ${isSubpage ? 'subpage-mode' : ''}`} id="headerPill" data-subpage={isSubpage ? 'true' : undefined}>
          {/* Subpage title - shown only on subpages, hidden when nav expands */}
          {isSubpage && (
            <span class="subpage-island-label">{pageTitle}</span>
          )}
          <a href="/#about" class="nav-item" data-section="about" style="--dot-i:0">
            <span class="nav-dot"></span>
            <span class="nav-label">About</span>
          </a>
          <a href="/#domains" class="nav-item" data-section="domains" style="--dot-i:1">
            <span class="nav-dot"></span>
            <span class="nav-label">Domains</span>
          </a>
          <a href="/#events" class="nav-item" data-section="events" style="--dot-i:2">
            <span class="nav-dot"></span>
            <span class="nav-label">Events</span>
          </a>
          <a href="/#projects" class="nav-item" data-section="projects" style="--dot-i:3">
            <span class="nav-dot"></span>
            <span class="nav-label">Projects</span>
          </a>
          <a href="/#acm-w" class="nav-item" data-section="acm-w" style="--dot-i:4">
            <span class="nav-dot"></span>
            <span class="nav-label">ACM-W</span>
          </a>
          <a href="/#community" class="nav-item" data-section="community" style="--dot-i:5">
            <span class="nav-dot"></span>
            <span class="nav-label">Community</span>
          </a>
          <a href="/#team" class="nav-item" data-section="team" style="--dot-i:6">
            <span class="nav-dot"></span>
            <span class="nav-label">Team</span>
          </a>
          <a href="/#blogs" class="nav-item" data-section="blogs" style="--dot-i:7">
            <span class="nav-dot"></span>
            <span class="nav-label">Blogs</span>
          </a>
          <a href="/#partners" class="nav-item" data-section="partners" style="--dot-i:8">
            <span class="nav-dot"></span>
            <span class="nav-label">Partners</span>
          </a>
          <a href="/#gallery" class="nav-item" data-section="gallery" style="--dot-i:9">
            <span class="nav-dot"></span>
            <span class="nav-label">Gallery</span>
          </a>
          <a href="/#contact" class="nav-item" data-section="contact" style="--dot-i:10">
            <span class="nav-dot"></span>
            <span class="nav-label">Contact</span>
          </a>
          <a href="/#more" class="nav-item" data-section="more" style="--dot-i:11">
            <span class="nav-dot"></span>
            <span class="nav-label">More</span>
          </a>
        </div>

        {/* Back button bubble - separate from pill, Dynamic Island style */}
        {isSubpage && (
          <a href={resolvedBackHref} class="subpage-back-bubble" aria-label="Back to home">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M3 19V5" stroke="#FEFCD9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M13 6L7 12L13 18" stroke="#FEFCD9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M7 12H21" stroke="#FEFCD9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        )}
        </div>

        <!-- Megamenu dropdown -->
        <div class="nav-megamenu" id="navMegamenu">
          {Object.entries(dropdowns).map(([key, items]) => (
            <div class="megamenu-panel" data-panel={key}>
              <div class="megamenu-grid">
                {items.map((item, i) => item.all ? (
                  <a href={item.href} class="megamenu-tile all-tile" style={`--tile-i: ${i}`}>
                    <span class="all-tile-label">{item.title}</span>
                    <svg class="all-tile-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none">
                      <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                ) : (
                  <a
                    href={item.href}
                    class="megamenu-tile"
                    data-tilt
                    style={`--tile-i: ${i}; ${item.color ? `--tile-color: ${item.color}` : ''}`}
                  >
                    {item.color && <span class="tile-color-bar" />}
                    <div class="tile-text">
                      <span class="tile-title">{item.title}</span>
                      <span class="tile-desc">{item.desc}</span>
                    </div>
                    <img
                      class="tile-img"
                      src={getAssetUrl(item.img)}
                      alt={item.title}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Mobile bottom navbar (morphing pill: nav / menu / music) -->
      <div class="nav-mobile">
        <MobileNavbar pageTitle={pageTitle} />
      </div>
    </nav>
  </div>
</header>

<style>
  /* ── Pill + back-bubble wrapper ── */
  .pill-island-wrap {
    display: flex;
    align-items: center;
    position: relative;
  }

  /* During the split morph: solid shapes, kill glass effects so the two
     overlapping shapes read as one seamless silhouette. The drop-shadows
     trace the UNION outline (waist included) - a faux border that keeps the
     silhouette visible on near-black pages, matching the glass border glow */
  .pill-island-wrap.split-active {
    filter:
      drop-shadow(0 0 1px rgba(249, 95, 74, 0.85))
      drop-shadow(0 0 1px rgba(249, 95, 74, 0.45))
      drop-shadow(0 8px 20px rgba(0, 0, 0, 0.55));
  }

  .pill-island-wrap.split-active .header-pill,
  .pill-island-wrap.split-active .subpage-back-bubble {
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border-color: transparent !important;
    box-shadow: none !important;
  }

  .pill-island-wrap.split-active .header-pill::before,
  .pill-island-wrap.split-active .header-pill::after,
  .pill-island-wrap.split-active .subpage-back-bubble::before {
    display: none !important;
  }

  /* ── Bubble intro (GSAP + Flip) ── */
  .header-pill.pill-collapsed {
    width: 44px;
    height: 44px;
    padding: 0;
    overflow: hidden;
    justify-content: center;
  }

  .header-pill.pill-collapsed .nav-item {
    opacity: 0;
    pointer-events: none;
  }

  /* ── Pill container ── */
  .header-pill {
    /* astro-liquid-glass tokens (scoped to pill) */
    --glass-bg: rgba(6, 2, 2, 0.22);
    --glass-blur: 32px;
    --glass-saturate: 220%;
    --glass-border: rgba(249, 95, 74, 0.75);
    --glass-highlight: rgba(255, 255, 255, 0.18);
    --glass-shadow: rgba(0, 0, 0, 0.5);
    --lens-edge-light: transparent;
    --lens-edge-dark: transparent;

    /* astro-liquid-glass .glass base styles (ported from package) */
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    position: relative;

    display: flex;
    align-items: center;
    gap: 0;
    height: 44px;
    padding: 0 16px;
    border-radius: 100px;
    /* Safari: backdrop-filter region ignores border-radius without an
       explicit clip - glass corners poke past the border otherwise */
    overflow: hidden;
    box-shadow:
      0 8px 32px var(--glass-shadow),
      0 0 18px rgba(249, 95, 74, 0.10),
      0 0 6px rgba(249, 95, 74, 0.08),
      inset 0 1px 0 var(--glass-highlight),
      inset 0 0 12px rgba(249, 95, 74, 0.04);
    transition:
      box-shadow 0.4s cubic-bezier(0.25, 0.1, 0.25, 1),
      border-color 0.4s cubic-bezier(0.25, 0.1, 0.25, 1),
      padding 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
    /* Hidden until GSAP intro */
    opacity: 0;
  }

  /* astro-liquid-glass lens-edge light effect (::before) + top highlight (::after) */
  .header-pill::before,
  .header-pill::after {
    border-radius: inherit;
    content: "";
    pointer-events: none;
    position: absolute;
  }

  /* Diagonal lens refraction - light top-left, dark bottom-right */
  .header-pill::before {
    background: linear-gradient(
      135deg,
      var(--lens-edge-light) 0%,
      transparent 40%,
      transparent 60%,
      var(--lens-edge-dark) 100%
    );
    inset: 0;
    opacity: 0.85;
  }

  /* Top inner highlight - like a glass rim catching light. Full inset so
     border-radius: inherit isn't clamped by a half-height box (which gives
     the sheen tighter corners than the pill) */
  .header-pill::after {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.18), transparent 50%);
    inset: 0;
  }

  /* Intro complete - GSAP sets opacity/transform, this class gates child visibility */
  .header-pill.pill-intro-play {
    opacity: 1;
  }

  /* Hover state - also triggered by .pill-menu-open when megamenu is visible */
  .header-pill:hover,
  .header-pill.pill-menu-open {
    --glass-border: rgba(249, 95, 74, 1.0);
    --glass-bg: rgba(6, 2, 2, 0.32);
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.55),
      0 0 24px rgba(249, 95, 74, 0.14),
      0 0 8px rgba(249, 95, 74, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      inset 0 0 16px rgba(249, 95, 74, 0.06);
    padding: 0 20px;
  }

  /* ── Each nav item ── */
  .nav-item {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0;
    padding: 5px 10px;
    border-radius: 100px;
    cursor: pointer;
    text-decoration: none;
    border: none;
    background: transparent;
    transition: gap 0.38s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  /* Hover on pill - expand all items */
  .header-pill:hover .nav-item,
  .header-pill.pill-menu-open .nav-item {
    gap: 7px;
  }

  .nav-item.active {
    gap: 8px;
  }

  /* ── Dot ── */
  .nav-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(254, 252, 217, 0.28);
    flex-shrink: 0;
    transition:
      background 0.35s cubic-bezier(0.25, 0.1, 0.25, 1),
      transform 0.38s cubic-bezier(0.25, 0.1, 0.25, 1),
      box-shadow 0.35s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .nav-item.active .nav-dot {
    background: #fefcd9;
    box-shadow: 0 0 8px rgba(254, 252, 217, 0.5);
  }

  .header-pill:hover .nav-item:not(.active) .nav-dot,
  .header-pill.pill-menu-open .nav-item:not(.active) .nav-dot {
    background: rgba(254, 252, 217, 0.5);
    transform: scale(1.15);
  }

  .header-pill:hover .nav-item.active .nav-dot,
  .header-pill.pill-menu-open .nav-item.active .nav-dot {
    transform: scale(1.2);
  }

  /* ── Nav item hover - orange highlight ── */
  .nav-item:hover .nav-dot {
    background: #f95f4a !important;
    box-shadow: 0 0 8px rgba(249, 95, 74, 0.5);
    transform: scale(1.25);
  }
  .nav-item:hover .nav-label {
    color: #f95f4a !important;
    opacity: 1 !important;
  }

  /* ACM-W hover - pink */
  .nav-item[data-section="acm-w"]:hover .nav-dot {
    background: #ff007a !important;
    box-shadow: 0 0 8px rgba(255, 0, 122, 0.5);
  }
  .nav-item[data-section="acm-w"]:hover .nav-label {
    color: #ff007a !important;
  }

  /* ── Label: hidden until active or pill hovered ── */
  .nav-label {
    font-size: 12px;
    font-family: "PolySans Trial", sans-serif;
    color: #fefcd9;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-weight: 400;
    white-space: nowrap;
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-width 0.4s cubic-bezier(0.25, 0.1, 0.25, 1),
      opacity 0.3s cubic-bezier(0.25, 0.1, 0.25, 1),
      color 0.25s ease;
  }

  /* Show all labels on pill hover */
  .header-pill:hover .nav-label,
  .header-pill.pill-menu-open .nav-label {
    max-width: 120px;
    opacity: 0.8;
  }

  /* Active label always visible, full opacity */
  .nav-item.active .nav-label {
    max-width: 120px;
    opacity: 1;
  }

  /* On hover + active: full opacity */
  .header-pill:hover .nav-item.active .nav-label,
  .header-pill.pill-menu-open .nav-item.active .nav-label {
    opacity: 1;
  }

  /* ── Megamenu dropdown ── */
  .nav-megamenu {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(10px) scale(0.96);
    transform-origin: top center;
    pointer-events: none;
    opacity: 0;
    z-index: 60;
    width: max(760px, 100%);
    transition:
      opacity 0.25s cubic-bezier(0.25, 0.1, 0.25, 1),
      transform 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .nav-megamenu.open {
    pointer-events: auto;
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .megamenu-panel {
    display: none;
    background: rgba(6, 2, 2, 0.72);
    backdrop-filter: blur(40px) saturate(220%);
    -webkit-backdrop-filter: blur(40px) saturate(220%);
    border: 1px solid rgba(249, 95, 74, 0.55);
    border-radius: 22px;
    padding: 18px;
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.55),
      0 0 20px rgba(249, 95, 74, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
  }

  .megamenu-panel::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent);
    border-radius: inherit;
    pointer-events: none;
  }

  .megamenu-panel.active {
    display: block;
  }

  /* Bento grid */
  .megamenu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    position: relative;
    z-index: 1;
