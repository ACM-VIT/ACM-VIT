<script>
  // @ts-nocheck
  import { gsap } from "gsap";
  import { Flip } from "gsap/Flip";
  gsap.registerPlugin(Flip);

  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id], footer[id]");

    // Section → nav-item mapping
    const idMapping = {
      work: "events",
      "igniting-minds-section": "community",
      "community-outreach": "community",
      "community-sdg": "community",
      "community-conduct": "community",
      "community-award": "community",
      "projects-intro": "projects",
    };

    // ── Dot nav active state ──
    function setActiveItem(navSection) {
      const items = document.querySelectorAll(".nav-desktop .nav-item");
      items.forEach((item) => {
        item.classList.remove("active", "pink-mode");
      });

      if (!navSection) return;

      const target = document.querySelector(
        `.nav-desktop .nav-item[data-section="${navSection}"]`
      );
      if (!target) return;

      target.classList.add("active");
      if (navSection === "acm-w") target.classList.add("pink-mode");
    }

    function applyNavState(sectionId) {
      if (!sectionId || sectionId === "footer") {
        setActiveItem(null);
        window.dispatchEvent(new CustomEvent("nav:section", { detail: { id: "home" } }));
        return;
      }
      const mappedId = idMapping[sectionId] || sectionId;
      setActiveItem(mappedId);
      window.dispatchEvent(new CustomEvent("nav:section", { detail: { id: mappedId } }));
    }

    // ── Scroll tracking ──
    let currentSectionId = null;
    let rafPending = false;
    let lastScrollY = window.scrollY || window.pageYOffset;

    function getActiveSection() {
      const focusLine = window.innerHeight * 0.3;
      let activeSection = null;
      let closestSection = null;
      let closestDistance = Infinity;

      sections.forEach((section) => {
        const rect = section.getBoundingClientRect();
        if (rect.top <= focusLine && rect.bottom >= focusLine) {
          activeSection = section;
        }
        let distance = 0;
        if (rect.top > focusLine) {
          distance = rect.top - focusLine;
        } else if (rect.bottom < focusLine) {
          distance = focusLine - rect.bottom;
        }
        if (distance < closestDistance) {
          closestDistance = distance;
          closestSection = section;
        }
      });

      return activeSection || closestSection;
    }

    function updateActiveSection() {
      rafPending = false;
      const scrollY = window.scrollY || window.pageYOffset;
      lastScrollY = scrollY;
      const activeSection = getActiveSection();
      if (!activeSection) return;
      const id = activeSection.getAttribute("id");
      if (!id || id === currentSectionId) return;
      currentSectionId = id;
      applyNavState(id);
    }

    function scheduleNavUpdate() {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(updateActiveSection);
    }

    const observer = new IntersectionObserver(
      () => scheduleNavUpdate(),
      { root: null, rootMargin: "-20% 0px -60% 0px", threshold: 0 }
    );
    sections.forEach((s) => observer.observe(s));
    window.addEventListener("scroll", scheduleNavUpdate, { passive: true });

    // The document scroll lives on <body> here (overflow-y: auto), not the
    // window - so window.scrollTo is a no-op. Find the element that actually
    // scrolls before tweening.
    function getScroller(): HTMLElement {
      const candidates = [
        document.scrollingElement,
        document.documentElement,
        document.body,
      ].filter(Boolean) as HTMLElement[];
      for (const el of candidates) {
        if (el.scrollHeight > el.clientHeight + 4) return el;
      }
      return (document.scrollingElement as HTMLElement) || document.documentElement;
    }

    // Self-correcting smooth scroll: re-reads the target's live position each
    // frame, so lazy content settling below doesn't leave it landing short.
    function smoothScrollToSection(target: Element) {
      const scroller = getScroller();
      const finalTargetY = () =>
        scroller.scrollTop + target.getBoundingClientRect().top;

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      if (reduceMotion) {
        scroller.scrollTop = finalTargetY();
        return;
      }

      const startY = scroller.scrollTop;
      const duration = 800;
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      // Bypass CSS scroll-behavior so our per-frame writes aren't double-eased.
      const prevBehavior = scroller.style.scrollBehavior;
      scroller.style.scrollBehavior = "auto";

      let start: number | undefined;
      const step = (ts: number) => {
        if (start === undefined) start = ts;
        const p = Math.min((ts - start) / duration, 1);
        scroller.scrollTop = startY + (finalTargetY() - startY) * ease(p);
        if (p < 1) {
          requestAnimationFrame(step);
        } else {
          scroller.style.scrollBehavior = prevBehavior;
        }
      };
      requestAnimationFrame(step);
    }

    // ── Smooth scroll ──
    document.addEventListener("click", (e) => {
      const el = e.target instanceof Element ? e.target.closest('a[href*="#"]') : null;
      if (!el) return;
      const href = el.getAttribute("href");
      if (!href) return;

      // Extract section id from href (handles both "#about" and "/#about")
      const hashIndex = href.indexOf("#");
      if (hashIndex === -1) return;
      const id = href.slice(hashIndex + 1);
      if (!id) return;

      // If on a different page, let the browser navigate to /#section
      const hrefPath = href.slice(0, hashIndex) || "/";
      if (hrefPath !== "/" && hrefPath !== window.location.pathname) return;

      const target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();

      // Contact (200vh) and More (curtain + pinned boombox below it) sit below
      // lazy-loaded content, so a captured scrollIntoView target goes stale and
      // lands short. Tween manually, re-reading the target position every frame
      // so it self-corrects as content below settles - and stays smooth.
      if (id === "contact" || id === "more") {
        smoothScrollToSection(target);
        history.replaceState(null, "", window.location.pathname);
        applyNavState(id);
        currentSectionId = id;
        return;
      }

      target.scrollIntoView({ behavior: "smooth", block: "start" });
      // Clean URL - no hash
      history.replaceState(null, "", window.location.pathname);
      applyNavState(id);
      currentSectionId = id;
    });

    scheduleNavUpdate();

    // ── Clean hash from URL on load (after browser scrolls to target) ──
    if (window.location.hash) {
      const hashId = window.location.hash.slice(1);
      requestAnimationFrame(() => {
        history.replaceState(null, "", window.location.pathname);
        if (hashId) applyNavState(hashId);
      });
    }

    // ── Megamenu interaction ──
    const megamenu = document.getElementById("navMegamenu");
    const megamenuPanels = megamenu ? megamenu.querySelectorAll(".megamenu-panel") : [];
    const sectionsWithDropdowns = ["about", "community", "domains", "events", "projects", "team", "blogs", "acm-w", "gallery", "more"];
    let megamenuTimer = null;
    let currentPanel = null;

    const pill = document.getElementById("headerPill");

    function showMegamenu(section) {
      if (!megamenu) return;
      megamenuPanels.forEach((p) => p.classList.remove("active"));
      const panel = megamenu.querySelector(`[data-panel="${section}"]`);
      if (!panel) return;
      panel.classList.add("active");
      currentPanel = section;
      megamenu.classList.add("open");
      if (pill) pill.classList.add("pill-menu-open");
    }

    function hideMegamenu() {
      if (!megamenu) return;
      megamenu.classList.remove("open");
      currentPanel = null;
      if (pill) pill.classList.remove("pill-menu-open");
      setTimeout(() => {
        if (!currentPanel) {
          megamenuPanels.forEach((p) => p.classList.remove("active"));
        }
      }, 280);
    }

    function startHideTimer() {
      megamenuTimer = setTimeout(hideMegamenu, 180);
    }

    function cancelHideTimer() {
      if (megamenuTimer) {
        clearTimeout(megamenuTimer);
        megamenuTimer = null;
      }
    }

    // Nav item hover → show panel
    document.querySelectorAll(".nav-desktop .nav-item").forEach((item) => {
      const section = item.getAttribute("data-section");
      if (!sectionsWithDropdowns.includes(section)) return;

      item.addEventListener("mouseenter", () => {
        cancelHideTimer();
        showMegamenu(section);
      });
      item.addEventListener("mouseleave", () => {
        startHideTimer();
      });
    });

    // Megamenu hover → keep open
    if (megamenu) {
      megamenu.addEventListener("mouseenter", () => {
        cancelHideTimer();
      });
      megamenu.addEventListener("mouseleave", () => {
        startHideTimer();
      });
    }

    // Close megamenu on scroll
    window.addEventListener("scroll", () => {
      if (currentPanel) hideMegamenu();
    }, { passive: true });

    // Close megamenu when clicking a tile
    if (megamenu) {
      megamenu.querySelectorAll(".megamenu-tile").forEach((tile) => {
        tile.addEventListener("click", () => {
          hideMegamenu();
        });
      });
    }

    // ── Tilt micro-interaction ──
    document.querySelectorAll("[data-tilt]").forEach((tile) => {
      tile.addEventListener("mousemove", (e) => {
        const rect = tile.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;
        const rotateX = (0.5 - y) * 8;
        const rotateY = (x - 0.5) * 8;
        tile.style.transform =
          `perspective(600px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
      });
      tile.addEventListener("mouseleave", () => {
        tile.style.transform = "";
      });
    });

    // ── Bubble intro animation (GSAP) ──
    if (pill) {
      let introFired = false;

      // ── Subpage intro: circle drop → Flip expand full capsule → constriction pinch-off ──
      if (pill.dataset.subpage === 'true') {
        introFired = true;

        const splitWrap = document.getElementById('pillIslandWrap');
        const backBubble = document.querySelector('.subpage-back-bubble');
        const label = pill.querySelector('.subpage-island-label');
        const bubbleIcon = backBubble ? backBubble.querySelector('svg') : null;
        const solidDark = 'rgb(24, 18, 18)';

        // Start as collapsed circle
        pill.classList.add('pill-collapsed');
        pill.style.transition = 'none';
        gsap.set(pill, { opacity: 0, y: -24, scale: 0.7 });
        if (label) gsap.set(label, { opacity: 0, maxWidth: 0, padding: 0 });
        if (backBubble) {
          // Kill CSS transitions so GSAP owns transform during the intro
          backBubble.style.transition = 'none';
          // Out of flow for the whole intro, anchored to the capsule's right
          // edge: the wrap width equals the visible capsule width, so the
          // header's flex centering never shifts as the pill expands/retracts
          gsap.set(backBubble, {
            opacity: 0, scale: 1,
            position: 'absolute', top: 0, right: 0, marginLeft: 0,
            background: solidDark,
            backdropFilter: 'none', webkitBackdropFilter: 'none',
            borderColor: 'transparent', boxShadow: 'none',
          });
        }
        if (bubbleIcon) gsap.set(bubbleIcon, { opacity: 0, scale: 0.5, transformOrigin: '50% 50%' });

        function playSubpageIntro() {
        const dropTl = gsap.timeline({ delay: 0.1 });

        // Phase 1: Circle drops in
        dropTl.to(pill, {
          opacity: 1, y: 8, scale: 1.05,
          duration: 0.28, ease: 'power2.out',
        })
        // Phase 2: Bounce back
        .to(pill, { y: -5, scale: 1, duration: 0.16, ease: 'power2.inOut' })
        // Phase 3: Settle
        .to(pill, { y: 0, duration: 0.12, ease: 'power2.out' })
        // Phase 4: Flip expand circle → pill
        .add(() => {
          // Reserve the label's layout space now so capsule width == final
          // pill+bubble width, but keep it invisible until the split is done
          if (label) gsap.set(label, { opacity: 0, maxWidth: 300, padding: '0 4px' });

          const state = Flip.getState(pill);
          pill.classList.remove('pill-collapsed');
          pill.classList.add('pill-intro-play');
          // Expand to the FULL capsule width - pill + bubble footprint drawn
          // as one shape (16px base + 44px bubble + 8px gap)
          pill.style.paddingRight = '68px';

          Flip.from(state, {
            duration: 0.32,
            ease: 'power3.out',
            clearProps: 'all',
            onComplete() {
              // Phase 5: constriction split - the full-width capsule pinches
              // its right end off into the back bubble. Pure geometry: two
              // solid same-color shapes overlap, so the union silhouette
              // narrows into a waist as the pill edge retracts across the
              // bubble. (No SVG gooey filter - Safari renders feColorMatrix
              // metaballs as a plain blur smear.)
              pill.style.transition = 'none';
              pill.style.background = solidDark;
              pill.style.backdropFilter = 'none';
              pill.style.webkitBackdropFilter = 'none';
              pill.style.borderColor = 'transparent';
              pill.style.boxShadow = 'none';
              // clearProps: 'all' wiped the inline padding - re-reserve the
              // bubble footprint before this frame paints
              pill.style.paddingRight = '68px';

              // Lock the wrap width so flex centering can't shift while the
              // pill retracts - pill+bubble bounds stay identical to the capsule
              if (splitWrap) {
                splitWrap.style.width = splitWrap.getBoundingClientRect().width + 'px';
                splitWrap.classList.add('split-active');
              }

              // Bubble sits embedded in the capsule's right end (absolute,
              // right: 0), already at its final screen position, invisible
              // against the solid pill
              if (backBubble) gsap.set(backBubble, { opacity: 1 });

              const glassBg = 'rgba(6, 2, 2, 0.22)';
              const glassBorder = 'rgba(249, 95, 74, 0.75)';

              const breakTl = gsap.timeline({
                onComplete() {
                  // Restore CSS transitions first, then clear inline styles so
                  // remaining deltas (box-shadow, glow) ease in via CSS
                  pill.style.transition = '';
                  pill.style.background = '';
                  pill.style.backdropFilter = '';
                  pill.style.webkitBackdropFilter = '';
                  pill.style.borderColor = '';
                  pill.style.boxShadow = '';
                  pill.style.paddingRight = '';
                  gsap.set(pill, { clearProps: 'x,scaleX,backgroundColor,borderColor,paddingRight' });
                  // Back into flex flow + unlock wrap: natural layout is the
                  // same total width, so nothing moves on screen
                  if (splitWrap) splitWrap.style.width = '';
                  if (backBubble) {
                    backBubble.style.transition = '';
                    gsap.set(backBubble, {
                      clearProps: 'position,top,right,marginLeft,x,scale,scaleX,scaleY,transformOrigin,background,backdropFilter,webkitBackdropFilter,borderColor,boxShadow',
                    });
                  }
                  if (bubbleIcon) gsap.set(bubbleIcon, { clearProps: 'scale,transformOrigin' });
                },
              });

              // Brief beat so the full capsule registers, then the pill's
              // right edge retracts - the silhouette necks down over the
              // embedded bubble and pinches off
              breakTl.to(pill, {
                paddingRight: 16,
                duration: 0.22, ease: 'power2.inOut',
              }, 0.04)
              // Surface tension: bubble stretches toward the receding edge...
              .to(backBubble, {
                scaleX: 1.07, transformOrigin: '100% 50%',
                duration: 0.08, ease: 'power2.out',
              }, 0.17)
              // ...and bounces apart as the shapes let go: quick pop away
              // from the pill, then an elastic settle back to resting spot
              .to(backBubble, {
                scaleX: 1.1, scaleY: 1.06, x: 7,
                duration: 0.09, ease: 'power2.out',
              }, 0.26)
              .to(backBubble, {
                scaleX: 1, scaleY: 1, x: 0,
                duration: 0.45, ease: 'elastic.out(1.1, 0.4)',
              }, 0.35)
              // Bubble melts dark → orange as the waist narrows
              .to(backBubble, {
                background: '#F95F4A',
                duration: 0.15, ease: 'sine.inOut',
              }, 0.17)
              // Back arrow resolves in
              .to(bubbleIcon, {
                opacity: 1, scale: 1,
                duration: 0.14, ease: 'power2.out',
              }, 0.24)
              // Title fades in once the pill has separated
              .to(label, {
                opacity: 1,
                duration: 0.22, ease: 'power2.out',
              }, 0.3)
              // Pill recoils off the separation - kicks left, springs back
              .to(pill, {
                scaleX: 0.97, x: -4, transformOrigin: '100% 50%',
                duration: 0.07, ease: 'power2.out',
              }, 0.26)
              .to(pill, {
                scaleX: 1, x: 0,
                duration: 0.35, ease: 'elastic.out(1, 0.45)',
              }, 0.33)
              // Shapes fully apart: ease glass back in
              .add(() => {
                if (splitWrap) splitWrap.classList.remove('split-active');
                pill.style.backdropFilter = '';
                pill.style.webkitBackdropFilter = '';
                if (backBubble) gsap.set(backBubble, { backdropFilter: '', webkitBackdropFilter: '' });
              }, 0.34)
              .to(pill, {
                backgroundColor: glassBg, borderColor: glassBorder,
                duration: 0.25, ease: 'power2.out',
              }, 0.34)
              .to(backBubble, {
                borderColor: 'rgba(254, 252, 217, 0.35)',
                duration: 0.25, ease: 'power2.out',
              }, 0.34);
            },
          });
        });

        } // end playSubpageIntro

        // Wait for preloader to finish before playing subpage intro
        window.addEventListener("preloader:done", () => {
          setTimeout(playSubpageIntro, 250);
        }, { once: true });

        // ── Subpage hover: pill only (not bubble), debounced ──
        let hoverTimer = null;
        pill.addEventListener('mouseenter', () => {
          clearTimeout(hoverTimer);
          pill.classList.add('subpage-expanded');
        });
        pill.addEventListener('mouseleave', () => {
          hoverTimer = setTimeout(() => {
            pill.classList.remove('subpage-expanded');
          }, 150);
        });
      }

      function triggerPillIntro() {
        if (introFired) return;
        introFired = true;

        const dots = pill.querySelectorAll(".nav-dot");
        const navItems = pill.querySelectorAll(".nav-item");

        // Start collapsed as small circle, kill CSS transitions during intro
        pill.classList.add("pill-collapsed");
        pill.style.transition = "none";
        gsap.set(pill, { opacity: 0, y: -24, scale: 0.7 });
        gsap.set(dots, { opacity: 0 });

        const pillTl = gsap.timeline({
          onComplete: () => {
            pill.classList.add("pill-intro-play");
          },
        });

        // Phase 1: Circle drops in from above, overshoots down
        pillTl.to(pill, {
          opacity: 1,
          y: 8,
          scale: 1.05,
          duration: 0.28,
          ease: "power2.out",
        })
        // Phase 2: Bounce back up
        .to(pill, {
          y: -5,
          scale: 1,
          duration: 0.16,
          ease: "power2.inOut",
        })
        // Phase 3: Settle + expand circle → pill (Flip)
        .to(pill, {
          y: 0,
          duration: 0.12,
          ease: "power2.out",
          onStart: () => {
            const state = Flip.getState(pill);
            pill.classList.remove("pill-collapsed");

            Flip.from(state, {
              duration: 0.38,
              ease: "power3.out",
              clearProps: "all",
              onComplete: () => {
                // Restore CSS transitions now that intro is done
                pill.style.transition = "";
                // Phase 4: Dots stagger in after expansion
                gsap.to(dots, {
                  opacity: 1,
                  duration: 0.2,
                  ease: "power2.out",
                  stagger: 0.02,
                });
              },
            });
          },
        });
      }

      // If preloader already shown before, 500ms delay then drop
      if (sessionStorage.getItem("preloaderShown")) {
        setTimeout(triggerPillIntro, 250);
      } else {
        // First visit - wait for preloader to fully finish
        window.addEventListener("preloader:done", () => {
          setTimeout(triggerPillIntro, 250);
        }, { once: true });
      }
    }

  });
</script>
