---
// Footer.astro
import FillButton from "../components/ui/FillButton.astro";
import { getAssetUrl, getMediaUrl } from "../utils/cdn";
import { techAOIs } from "../data/techDomainData";
import { designAOIs } from "../data/designDomainData";
import { researchAOIs } from "../data/researchDomainData";

const currentYear = new Date().getFullYear();

// Social icons - brand marks from Simple Icons (simpleicons.org), 24x24 viewBox.
// Inlined as SVG so every glyph renders at identical size and recolors via
// currentColor (clean orange hover, no per-asset padding mismatch).
const socials: { label: string; href: string; path: string }[] = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/company/acmvit",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z",
  },
  {
    label: "X",
    href: "https://x.com/acm_vit",
    path: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/acmvit",
    path: "M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0Zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.897 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.897-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03Zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162ZM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4Zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439Z",
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/@acm_vit",
    path: "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
  },
  {
    label: "Hashnode",
    href: "https://blog.acmvit.in",
    path: "M22.351 8.019l-6.37-6.37a5.63 5.63 0 0 0-7.962 0l-6.37 6.37a5.63 5.63 0 0 0 0 7.962l6.37 6.37a5.63 5.63 0 0 0 7.962 0l6.37-6.37a5.63 5.63 0 0 0 0-7.962zM12 15.953a3.953 3.953 0 1 1 0-7.906 3.953 3.953 0 0 1 0 7.906z",
  },
  {
    label: "Facebook",
    href: "https://www.facebook.com/acmvitvellore",
    path: "M9.198 21.5h4v-8.01h3.604l.396-3.98h-4V7.5a1 1 0 0 1 1-1h3V2.5h-3a5 5 0 0 0-5 5v2.01h-2l-.396 3.98h2.396v8.01Z",
  },
];

const socialLinksHtml = socials
  .map(
    (s) =>
      `<a href="${s.href}" aria-label="${s.label}" target="_blank" rel="noopener noreferrer" class="footer-social"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="${s.path}"/></svg></a>`
  )
  .join("");

type FooterLink = { label: string; href: string };
type FooterColumn = { title: string; links: FooterLink[] };

// AOI columns derive from the same data that builds /domains/*/[aoi] pages,
// so footer links never drift from real routes.
const aoiLinks = (
  aois: { key: string; title: string }[],
  base: string
): FooterLink[] => aois.map((a) => ({ label: a.title, href: `${base}/${a.key}` }));

const footerNav: FooterColumn[] = [
  {
    title: "Explore",
    links: [
      { label: "About", href: "/#about" },
      { label: "Domains", href: "/#domains" },
      { label: "Events", href: "/#events" },
      { label: "Projects", href: "/#projects" },
      { label: "ACM-W", href: "/#acm-w" },
      { label: "Community", href: "/#community" },
      { label: "Blogs", href: "/#blogs" },
      { label: "Partners", href: "/#partners" },
      { label: "Gallery", href: "/#gallery" },
      { label: "Contact", href: "/#contact" },
    ],
  },
  {
    title: "Domains",
    links: [
      { label: "Tech", href: "/domains/tech" },
      { label: "Competitive Coding", href: "/domains/cc" },
      { label: "Design", href: "/domains/design" },
      { label: "Management", href: "/domains/management" },
      { label: "Research", href: "/domains/research" },
    ],
  },
  { title: "Tech", links: aoiLinks(techAOIs, "/domains/tech") },
  { title: "Design", links: aoiLinks(designAOIs, "/domains/design") },
  { title: "Research", links: aoiLinks(researchAOIs, "/domains/research") },
  {
    title: "Events",
    links: [
      { label: "All Events", href: "/events" },
      { label: "Code2Create", href: "/events/code2create" },
      { label: "Cryptic Hunt", href: "/events/cryptic-hunt" },
      { label: "Reverse Coding", href: "/events/reverse-coding" },
      { label: "Forktober", href: "/events/forktober" },
      { label: "The Tiny Hack", href: "/events/the-tiny-hack" },
      { label: "Apptitude", href: "/events/apptitude" },
    ],
  },
  {
    title: "Projects",
    links: [
      { label: "All Projects", href: "/projects" },
      { label: "Conclave", href: "/projects/conclave" },
      { label: "ExamCooker", href: "/projects/examcooker" },
      { label: "CLI-RPG", href: "/projects/cli-rpg" },
      { label: "UniPool", href: "/projects/unipool" },
      { label: "LOCALHOST", href: "/projects/localhost" },
      { label: "OCS-25", href: "/projects/ocs-25" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Blogs", href: "/blogs" },
      { label: "GREP Newsletter", href: "/grep" },
      { label: "Gallery", href: "/gallery" },
      { label: "Achievements", href: "/achievements" },
      { label: "Merchandise", href: "/merchandise" },
      { label: "Cassette Builder", href: "/cassette-builder" },
      { label: "Design Guide", href: "/design" },
    ],
  },
  {
    title: "Community",
    links: [
      { label: "Community Hub", href: "/community" },
      { label: "Outreach", href: "/community#community-outreach" },
      { label: "SDG Initiative", href: "/community#community-sdg" },
      { label: "Fresher Initiative", href: "/community#community-ksl" },
      { label: "Bootcamps", href: "/community#community-bootcamp" },
      { label: "Open Source", href: "/community#community-opensource" },
      { label: "ACM-W", href: "/community#acm-w" },
      { label: "International Award", href: "/community#community-award" },
    ],
  },
  {
    title: "More",
    links: [
      { label: "Team", href: "/team" },
      { label: "Partners", href: "/partners" },
      { label: "z0d1ak", href: "/z0d1ak" },
      { label: "Calendar", href: "/calendar" },
      { label: "FAQs", href: "/faqs" },
      { label: "Code of Conduct", href: "/code-of-conduct" },
      { label: "Sitemap", href: "/sitemap" },
    ],
  },
];

// Nested .map() JSX misbehaves inside <template> elements, so pre-render the
// footer columns to a trusted HTML string and inject with set:html.
const footerColumnsHtml = footerNav
  .map(
    (col) => `
      <div class="flex flex-col gap-4">
        <h3 class="footer-col-title">${col.title}</h3>
        <ul class="flex flex-col gap-2.5">
          ${col.links
            .map(
              (l) =>
                `<li><a href="${l.href}" class="footer-link">${l.label}</a></li>`
            )
            .join("")}
        </ul>
      </div>`
  )
  .join("");
---

<div data-variant-host>
  <template data-variant="desktop">
    <footer
      id="footer"
      class="footer-gradient relative w-full overflow-hidden m-0 p-0 flex flex-col"
    >
      <div class="relative z-10 hidden md:block px-6 lg:px-16 pt-16 pb-24">
        <div
          class="mx-auto flex w-full max-w-[1600px] flex-col gap-14 lg:flex-row lg:gap-20"
        >
          <!-- Identity -->
          <div class="flex shrink-0 flex-col gap-7 lg:w-[300px]">
            <h2 class="footer-title text-yellow-50">
              association for<br />computing machinery
            </h2>

            <span class="footer-status" style="--dot: #0270f3">
              <span class="footer-status-dot"></span>
              ALL SYSTEMS OPTIMAL
            </span>

            <a
              href="https://w3w.co/static.grips.limelight"
              target="_blank"
              rel="noopener noreferrer"
              class="group relative block h-36 w-56 overflow-hidden rounded-xl border border-zinc-800"
            >
              <img
                src={getAssetUrl("/footer/footer-vit-map.webp")}
                alt="Map to Vellore Institute of Technology"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <span
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"
              ></span>
              <span
                class="absolute bottom-2 left-3 font-['PolySans_Trial'] text-[11px] text-white/90"
                >Vellore, India</span
              >
              <span
                class="absolute top-2 right-2 inline-flex h-6 w-6 items-center justify-center rounded-full border border-white/25 bg-black/40 text-white/90 backdrop-blur-sm"
                aria-hidden="true"
              >
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg>
              </span>
            </a>

            <div class="flex flex-wrap items-center gap-3">
              <FillButton href="/sitemap" label="View sitemap" class="footer-fill">
                <svg
                  slot="icon"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="3" width="7" height="7" rx="1" />
                  <rect x="14" y="3" width="7" height="7" rx="1" />
                  <rect x="3" y="14" width="7" height="7" rx="1" />
                  <rect x="14" y="14" width="7" height="7" rx="1" />
                </svg>
              </FillButton>
              <FillButton href="/sitemap.xml" label="sitemap.xml" class="footer-fill">
                <svg
                  slot="icon"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="16 18 22 12 16 6" />
                  <polyline points="8 6 2 12 8 18" />
                </svg>
              </FillButton>
            </div>

          </div>

          <!-- Link grid -->
          <nav
            aria-label="Footer navigation"
            class="grid grow grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
            set:html={footerColumnsHtml}
          >
          </nav>
        </div>
      </div>

      <!-- Social icons above the video -->
      <div
        class="footer-socials footer-socials--desktop hidden md:flex relative z-10 flex-row items-center justify-center gap-6 pb-8"
        set:html={socialLinksHtml}
      >
      </div>

      <!-- Footer video banner with overlaid bottom section -->
      <div class="footer-video hidden md:block relative z-10 w-full mt-auto overflow-hidden">
        <video
          class="block w-full h-auto"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        >
          <source src={getMediaUrl("/videos/videos-footer-walkman.webm")} type="video/webm" />
          <source src={getMediaUrl("/videos/videos-footer-walkman.mp4")} type="video/mp4" />
        </video>
        <div class="footer-video-tint" aria-hidden="true"></div>
        <div class="footer-video-fade" aria-hidden="true"></div>
        <canvas class="footer-rain" aria-hidden="true"></canvas>
        <span class="footer-wordmark">because technology matters</span>
        <div class="footer-acm-block" aria-hidden="true">
          <span class="footer-acm-mark">acm</span>
        </div>

        <!-- Copyright pinned bottom-left -->
        <p class="absolute bottom-3 left-12 z-30 text-[10px] lg:text-xs font-light text-white">
          © {currentYear}&nbsp;ACM-VIT. All rights reserved.
        </p>

        <!-- Location + live weather pinned bottom-right -->
        <div class="absolute bottom-3 right-12 z-30 pr-14 text-right text-[10px] lg:text-xs font-light text-white">
          <p class="footer-weather" data-footer-weather hidden>
            <span data-weather-fact></span><br />
            <span class="footer-weather-mood" data-weather-mood></span>
          </p>
          <p>Vellore, Tamil Nadu, India</p>
        </div>

        <!-- Bottom section overlaid on the video, pushed lower -->
        <div class="absolute inset-0 z-20 flex w-full flex-col items-center justify-end pb-20 lg:pb-28">
        <div
          class="flex flex-col items-center justify-center z-30 relative"
        >
          <div class="flex items-center gap-2">
            <img
              src={getAssetUrl("/footer/footer-pixel-heart.webp")}
              alt="pixel heart"
              class="w-5 h-5 lg:w-6 lg:h-6"
              loading="lazy"
              decoding="async"
            />
            <span
              class="text-sm lg:text-base text-white font-['PolySans_Trial']"
              >crafted with love by ACM-VIT</span
            >
          </div>
        </div>
        </div>
      </div>
    </footer>
  </template>

  <template data-variant="mobile">
    <!-- Phone Screen Version -->
    <footer
      id="footer"
      class="footer-gradient relative w-full h-auto overflow-hidden pb-0 flex flex-col"
    >
      <!-- Content -->
      <div class="relative z-10 flex flex-col gap-8 px-5 sm:px-8 pt-8 pb-6">
        <!-- Identity -->
        <div class="flex flex-col items-center gap-4 text-center">
          <h2 class="footer-title footer-title--mobile text-yellow-50">
            association for<br />computing machinery
          </h2>
          <span class="footer-status" style="--dot: #0270f3">
            <span class="footer-status-dot"></span>
            ALL SYSTEMS OPTIMAL
          </span>
        </div>

        <!-- Link grid -->
        <nav
          aria-label="Footer navigation"
          class="grid grid-cols-2 gap-x-6 gap-y-8"
          set:html={footerColumnsHtml}
        >
        </nav>

        <div class="flex flex-wrap items-center gap-3 self-start">
          <FillButton href="/sitemap" label="View sitemap" class="footer-fill">
            <svg
              slot="icon"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="7" height="7" rx="1" />
              <rect x="14" y="3" width="7" height="7" rx="1" />
              <rect x="3" y="14" width="7" height="7" rx="1" />
              <rect x="14" y="14" width="7" height="7" rx="1" />
            </svg>
          </FillButton>
          <FillButton href="/sitemap.xml" label="sitemap.xml" class="footer-fill">
            <svg
              slot="icon"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="16 18 22 12 16 6" />
              <polyline points="8 6 2 12 8 18" />
            </svg>
          </FillButton>
        </div>
      </div>

      <!-- Copyright + socials above the video -->
      <div class="relative z-10 flex flex-col items-center gap-4 pb-5">
        <!-- Social Icons -->
        <div
          class="footer-socials footer-socials--mobile flex flex-row items-center gap-5 flex-wrap justify-center"
          set:html={socialLinksHtml}
        >
        </div>
        <p class="text-white text-[10px] font-light text-center">
          © {currentYear}&nbsp;ACM-VIT. All rights reserved.
        </p>
        <p
          class="footer-weather text-white text-[10px] font-light text-center"
          data-footer-weather
          hidden
        >
          <span data-weather-fact></span><br />
          <span class="footer-weather-mood" data-weather-mood></span>
        </p>
      </div>

      <!-- Footer video banner (mobile) with overlaid bottom section -->
      <div class="footer-video relative z-10 w-full mt-auto overflow-hidden">
        <video
          class="block w-full h-auto"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        >
          <source src={getMediaUrl("/videos/videos-footer-walkman.webm")} type="video/webm" />
          <source src={getMediaUrl("/videos/videos-footer-walkman.mp4")} type="video/mp4" />
        </video>
        <div class="footer-video-tint" aria-hidden="true"></div>
        <div class="footer-video-fade" aria-hidden="true"></div>
        <canvas class="footer-rain" aria-hidden="true"></canvas>
        <span class="footer-wordmark footer-wordmark--mobile">because technology matters</span>

        <!-- Bottom section overlaid on the video, lifted clear of the wordmark -->
        <div class="absolute inset-0 z-20 flex w-full flex-col items-center justify-end px-4 pb-[4.5rem]">
        <div
          class="flex flex-col items-center justify-center gap-3 z-30 relative"
        >
          <div class="flex items-center gap-2">
            <img
              src={getAssetUrl("/footer/footer-pixel-heart.webp")}
              alt="pixel heart"
              class="w-5 h-5 sm:w-6 sm:h-6 md:w-7 md:h-7"
              loading="lazy"
              decoding="async"
            />
            <span class="text-white text-xs sm:text-sm md:text-base font-['PolySans_Trial']"
              >crafted with love by ACM-VIT</span
            >
          </div>
        </div>
        </div>
      </div>
    </footer>
  </template>
</div>

<style>
  /* Footer identity title */
  .footer-title {
    font-family: "PolySans Bulky Wide", sans-serif;
    font-weight: 700;
    text-transform: lowercase;
    font-size: 1.6rem;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .footer-title--mobile {
    font-size: 1.25rem;
  }

  /* Status badge - mirrors .proj-status-badge on /projects/[project] */
  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    padding: 6px 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.02);
    font-family: "PolySans Mono", monospace;
    font-size: 0.62rem;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0270f3;
  }
  .footer-status-dot {
    position: relative;
    /* top: 1px; */
    bottom: 2px;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot);
    box-shadow: 0 0 12px var(--dot);
    animation: footer-status-pulse 5s ease-in-out infinite;
  }
  @keyframes footer-status-pulse {
    0%,
    100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.18);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-status-dot {
      animation: none;
    }
  }

  /* Column heading + nav link live inside set:html content, so they miss
     Astro's scoping attribute - target them globally. */
  :global(.footer-col-title) {
    font-family: "PolySans Trial", sans-serif;
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
    padding-bottom: 0.55rem;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.14);
  }

  :global(.footer-link) {
    display: inline-block;
    font-family: "PolySans Trial", sans-serif;
    font-weight: 400;
    font-size: 0.9rem;
    line-height: 1.2;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color 0.18s ease;
  }
  :global(.footer-link:hover),
  :global(.footer-link:focus-visible) {
    color: #fff;
    outline: none;
  }

  /* The footer sits on an always-black video band in BOTH themes, so pin these
     fill buttons to one dark-surface treatment and ignore FillButton's
     light-mode swap (which otherwise paints them #263B33 green here). Rest =
     transparent pill with a cream label; hover = accent-orange fill that pops
     on black, with a dark label. */
  :global(.fill-btn.footer-fill) {
    --fill-bg: #f95f4a !important;
    background: transparent !important;
    color: #fefcd9 !important;
    border-color: rgba(254, 252, 217, 0.25) !important;
  }
  :global(.fill-btn.footer-fill:hover) {
    color: #0d0e0d !important;
    border-color: #f95f4a !important;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.footer-link) {
      transition: none;
    }
  }

  /* Full-footer tonal transition: blends section above into the black video band.
     Transparent at top (matches the section above), ramps to solid black by the
     point the video begins, so there is no hard seam anywhere. */
  .footer-gradient {
    /* Solid black base so the translucent top never reveals the page bg
       (stays dark in light theme too). Gradient still blends the seam. */
    background-color: #000;
    background-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.4) 14%,
      rgba(0, 0, 0, 0.82) 24%,
      #000 32%,
      #000 100%
    );
  }

  /* Small tagline over the video */
  .footer-wordmark {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.25rem;
    z-index: 3;
    width: 100%;
    text-align: center;
    font-family: "PolySans Bulky Wide", sans-serif;
    font-weight: 700;
    text-transform: lowercase;
    line-height: 1;
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.75);
    pointer-events: none;
    user-select: none;
  }

  /* Mobile footer video is short (~210px); shrink the wordmark and pin it
     tight to the bottom so the "crafted with love" line clears it. */
  .footer-wordmark--mobile {
    font-size: 1rem;
    bottom: 0.6rem;
    letter-spacing: 0.02em;
  }

  /* Big 'acm' wordmark, right side of footer video */
  .footer-acm-block {
    position: absolute;
    right: 10rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    pointer-events: none;
    user-select: none;
  }
  .footer-acm-mark {
    font-family: "PolySans Bulky Wide", sans-serif;
    font-weight: 700;
    text-transform: lowercase;
    line-height: 0.9;
    font-size: clamp(6rem, 16vw, 16rem);
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.9);
    overflow: hidden;
  }
  .footer-acm-letter {
    display: inline-block;
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }

  /* Social icons: inline Simple Icons SVG. Uniform box, currentColor fill,
     slow ease to website orange on hover. */
  :global(.footer-social) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.45);
    transition:
      color 0.45s ease,
      transform 0.3s ease;
  }
  :global(.footer-social:hover),
  :global(.footer-social:focus-visible) {
    color: #fff;
    transform: scale(1.1);
    outline: none;
  }
  :global(.footer-social svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Facebook glyph fills ~80% of its 24 viewBox, the rest ~100%. Scale the
     others down so every mark reads at the same visual size as Facebook. */
  :global(.footer-social:not([aria-label="Facebook"]) svg) {
    transform: scale(0.8);
  }
  :global(.footer-socials--desktop .footer-social) {
    width: 1.65rem;
    height: 1.65rem;
  }
  :global(.footer-socials--mobile .footer-social) {
    width: 1.4rem;
    height: 1.4rem;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.footer-social) {
      transition: none;
    }
    :global(.footer-social:hover),
    :global(.footer-social:focus-visible) {
      transform: none;
    }
  }

  /* Orangish tint over footer video */
  .footer-video-tint {
    position: absolute;
    inset: 0;
    background: #f95f4a;
    mix-blend-mode: multiply;
    opacity: 0.55;
    pointer-events: none;
    transition: background-color 1.6s ease, opacity 1.6s ease;
  }
  /* Rainy colour grade: warm orange cools down to wet slate blue */
  .footer-video.is-rainy .footer-video-tint {
    background-color: #64789a;
    opacity: 0.5;
  }
  /* Live rain overlay - activated by script only when it is actually
     raining at VIT Vellore (Open-Meteo current weather). Sits above the
     tint/fade so drops stay crisp, below the z-20 text overlays. */
  .footer-rain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.6s ease;
    /* Wind slant; JS animates gusts around this. Scale hides rotated corners */
    transform: rotate(6deg) scale(1.32);
  }
  .footer-rain.is-raining {
    opacity: 1;
  }
  /* Live weather summary, fades in once data arrives */
  .footer-weather {
    opacity: 0;
    transition: opacity 1s ease;
    margin-bottom: 0.4em;
  }
  .footer-weather.is-live {
    opacity: 1;
  }
  .footer-weather-mood {
    opacity: 0.7;
    font-style: italic;
  }

  /* Ground mist while raining */
  .footer-video::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(150, 172, 198, 0.18),
      rgba(150, 172, 198, 0.05) 35%,
      transparent 60%
    );
    opacity: 0;
    transition: opacity 1.6s ease;
  }
  .footer-video.is-rainy::after {
    opacity: 1;
  }

  /* Fade top of video into footer background - soft ramp, no hard black cap */
  .footer-video-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      #000 0%,
      #000 20%,
      rgba(0, 0, 0, 0.7) 45%,
      rgba(0, 0, 0, 0) 78%
    );
    pointer-events: none;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initFooterAcm = () => {
    const marks = document.querySelectorAll<HTMLElement>(".footer-acm-mark");
    marks.forEach((mark) => {
      if (mark.dataset.acmInit === "1") return;
      mark.dataset.acmInit = "1";

      // Split into per-letter spans
      const text = mark.textContent || "";
      mark.textContent = "";
      const letters: HTMLElement[] = [];
      [...text].forEach((ch) => {
        const span = document.createElement("span");
        span.className = "footer-acm-letter";
        span.textContent = ch;
        mark.appendChild(span);
        letters.push(span);
      });

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (reduceMotion) {
        gsap.set(letters, { yPercent: 0, opacity: 1 });
        return;
      }

      gsap.set(letters, { yPercent: 120, rotation: -6, opacity: 0 });

      ScrollTrigger.create({
        trigger: mark,
        start: "top 90%",
        once: true,
        onEnter: () => {
          gsap.to(letters, {
            yPercent: 0,
            rotation: 0,
            opacity: 1,
            duration: 0.85,
            ease: "power3.out",
            stagger: 0.08,
          });
        },
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFooterAcm);
  } else {
    initFooterAcm();
  }
  // Re-init when variant templates mount (variant host, dispatches on window)
  window.addEventListener("variants-mounted", initFooterAcm);

  /* ------------------------------------------------------------------ */
  /* Live rain on the footer video when it's raining at VIT Vellore.    */
  /* Weather source: Open-Meteo (free, no API key, ~300 byte response). */
  /* ------------------------------------------------------------------ */

  const VIT_LAT = 12.9692;
  const VIT_LON = 79.1559;
  const WEATHER_URL = `https://api.open-meteo.com/v1/forecast?latitude=${VIT_LAT}&longitude=${VIT_LON}&current=weather_code,temperature_2m,relative_humidity_2m,wind_speed_10m`;
  const WEATHER_CACHE_KEY = "vit-weather-v2";
  const WEATHER_TTL_MS = 10 * 60 * 1000;

  type VitWeather = {
    code: number;
    temp: number | null;
    humidity: number | null;
    wind: number | null;
  };

  // WMO weather codes -> rain intensity (drops per 10k px²)
  const rainIntensity = (code: number): number => {
    if (code >= 95) return 1.6; // thunderstorm
    if (code >= 80 && code <= 82) return 1.2; // rain showers
    if (code >= 61 && code <= 67) return 0.9; // rain
    if (code >= 51 && code <= 57) return 0.45; // drizzle
    return 0;
  };

  const fetchVitWeather = async (): Promise<VitWeather> => {
    try {
      const cached = sessionStorage.getItem(WEATHER_CACHE_KEY);
      if (cached) {
        const { w, at } = JSON.parse(cached);
        if (Date.now() - at < WEATHER_TTL_MS) return w;
      }
    } catch {
      /* corrupt cache - refetch */
    }

    const res = await fetch(WEATHER_URL);
    if (!res.ok) throw new Error(`weather fetch failed: ${res.status}`);
    const data = await res.json();
    const cur = data?.current ?? {};
    const w: VitWeather = {
      code: Number(cur.weather_code ?? -1),
      temp: cur.temperature_2m ?? null,
      humidity: cur.relative_humidity_2m ?? null,
      wind: cur.wind_speed_10m ?? null,
    };
    try {
      sessionStorage.setItem(
        WEATHER_CACHE_KEY,
        JSON.stringify({ w, at: Date.now() })
      );
    } catch {
      /* storage unavailable - fine, just no cache */
    }
    return w;
  };

  const getVitWeather = async (): Promise<VitWeather> => {
    let w: VitWeather;
    try {
      w = await fetchVitWeather();
    } catch {
      w = { code: -1, temp: null, humidity: null, wind: null };
    }
    // ?rain=1 forces moderate rain, ?rain=dry forces dry, ?rain=<code> any
    // WMO code (0 = clear); ?temp=<n> forces temperature (heat messages)
    const params = new URLSearchParams(location.search);
    const forced = params.get("rain");
    if (forced === "1") w.code = 63;
    else if (forced === "dry") w.code = -1;
    else if (forced) w.code = Number(forced);
    const forcedTemp = params.get("temp");
    if (forcedTemp) w.temp = Number(forcedTemp);
    return w;
  };

  // Two-line summary: [facts, mood]. Mood lines lean into the footer's
  // late-night walkman energy.
  const weatherText = (w: VitWeather): [string, string] | null => {
    const c = w.code;
    const vitHour = (new Date().getUTCHours() + 5.5) % 24; // IST
    const day = vitHour >= 6 && vitHour < 18;
    let label: string;
    let mood: string;
    if (c >= 95) {
      label = "thunderstorm";
      mood = "the sky is running a live demo. stay for the light show";
    } else if (c === 85 || c === 86 || (c >= 71 && c <= 77)) {
      label = "snow";
      mood = "snow in vellore. screenshot it, nobody will believe you";
    } else if (c >= 80) {
      label = "rain showers";
      mood = "rain in bursts, like inspiration. save your work";
    } else if (c >= 61) {
      label = "rain";
      mood = "rain on the pavement, lo-fi in the headphones";
    } else if (c >= 51) {
      label = "drizzle";
      mood = "barely rain. commit anyway";
    } else if (c === 45 || c === 48) {
      label = "fog";
      mood = "low visibility, high introspection";
    } else if (c === 3) {
      label = "overcast";
      mood = "grey sky. good focus weather";
    } else if (c === 2) {
      label = "partly cloudy";
      mood = "some clouds, mostly possibility";
    } else if (c === 1) {
      label = day ? "mainly clear" : "mainly clear night";
      mood = "almost cloudless. almost a metaphor";
    } else if (c === 0) {
      label = day ? "sunny" : "clear night";
      mood = day
        ? "not a cloud over campus. go touch grass"
        : "zero clouds. the stars compile in silence";
    } else {
      return null;
    }

    // Heat overrides: sky code says "clear", the thermometer says otherwise.
    // Vellore summers regularly cook past 38°c.
    const t = w.temp;
    if (c <= 3 && t != null) {
      if (t >= 40) {
        if (day && c <= 2) label = "scorching";
        mood = "the sun is overclocked and thermal limits mean nothing. stay indoors";
      } else if (t >= 36) {
        if (day && c <= 2) label = "very hot";
        mood = "peak vellore summer. hydration is not optional";
      } else if (day && t >= 32) {
        mood = "bright, hot, unapologetic. carry water";
      } else if (!day && t >= 30) {
        mood = `still ${Math.round(t)}°c after dark. the day refuses to log off`;
      } else if (w.humidity != null && w.humidity >= 80 && t >= 27) {
        mood = "the air is basically soup. everything sticks, including motivation";
      }
    }
    const facts = [`${label} in vellore`];
    if (w.temp != null) facts.push(`${Math.round(w.temp)}°c`);
    if (w.humidity != null) facts.push(`${Math.round(w.humidity)}% humidity`);
    return [facts.join(" · "), mood];
  };

  const showFooterWeather = (w: VitWeather) => {
    const text = weatherText(w);
    if (!text) return;
    document
      .querySelectorAll<HTMLElement>("[data-footer-weather]")
      .forEach((el) => {
        const fact = el.querySelector("[data-weather-fact]");
        const mood = el.querySelector("[data-weather-mood]");
        if (fact) fact.textContent = text[0];
        if (mood) mood.textContent = text[1];
        el.hidden = false;
        requestAnimationFrame(() => el.classList.add("is-live"));
      });
  };

  type Drop = {
    x: number;
    y: number;
    len: number;
    speed: number;
    w: number;
    ground: number;
  };
  type Splash = {
    x: number;
    y: number;
    maxR: number;
    age: number;
    life: number;
    base: number;
  };
  type RainLayer = {
    share: number;
    speed: [number, number];
    len: [number, number];
    width: number;
    alpha: number;
    /* fraction of canvas height where drops of this depth hit the ground */
    ground: [number, number];
    splash: number;
    drops: Drop[];
  };

  const rand = (a: number, b: number) => a + Math.random() * (b - a);

  // Pre-rendered streak sprite: transparent tail tapering to a bright head.
  // drawImage-ing this beats per-drop gradients by a wide margin.
  const makeStreakSprite = (): HTMLCanvasElement => {
    const s = document.createElement("canvas");
    s.width = 8;
    s.height = 128;
    const c = s.getContext("2d")!;
    const g = c.createLinearGradient(0, 0, 0, 128);
    g.addColorStop(0, "rgba(195, 215, 245, 0)");
    g.addColorStop(0.72, "rgba(195, 215, 245, 0.5)");
    g.addColorStop(1, "rgba(228, 240, 255, 0.95)");
    c.fillStyle = g;
    c.beginPath();
    c.moveTo(3.2, 0);
    c.lineTo(4.8, 0);
    c.lineTo(6.6, 121);
    c.arc(4, 121, 2.6, 0, Math.PI);
    c.closePath();
    c.fill();
    return s;
  };

  /* Thunder rumble, synthesized (no audio asset). Browsers block sound
     until the user interacts, so the AudioContext is armed on first
     pointerdown and strikes before that stay silent. */
  let audioCtx: AudioContext | null = null;
  const armThunderAudio = () => {
    document.addEventListener(
      "pointerdown",
      () => {
        if (!audioCtx) audioCtx = new AudioContext();
      },
      { once: true, passive: true }
    );
  };

  const playThunder = () => {
    if (!audioCtx || audioCtx.state !== "running" || document.hidden) return;
    const dur = rand(1.8, 3.2);
    const sr = audioCtx.sampleRate;
    const buf = audioCtx.createBuffer(1, Math.floor(sr * dur), sr);
    const data = buf.getChannelData(0);
    let v = 0;
    for (let i = 0; i < data.length; i++) {
      const t = i / data.length;
      v = (v + 0.02 * (Math.random() * 2 - 1)) / 1.02; // brown noise
      const crack = t < 0.12 ? 1.6 - t * 5 : 1; // sharper onset
      data[i] = v * 3.5 * Math.pow(1 - t, 1.7) * crack;
    }
    const src = audioCtx.createBufferSource();
    src.buffer = buf;
    const filter = audioCtx.createBiquadFilter();
    filter.type = "lowpass";
    filter.frequency.setValueAtTime(420, audioCtx.currentTime);
    filter.frequency.exponentialRampToValueAtTime(90, audioCtx.currentTime + dur);
    const gain = audioCtx.createGain();
    gain.gain.value = 0.22;
    src.connect(filter).connect(gain).connect(audioCtx.destination);
    src.start();
  };

  const startRain = (canvas: HTMLCanvasElement, intensity: number) => {
    if (canvas.dataset.rainInit === "1") return;
    canvas.dataset.rainInit = "1";

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const sprite = makeStreakSprite();

    // Three depth layers: far = short/slow/faint/dense, near = long/fast/bright.
    // Ground bands follow the road's perspective: far drops land higher up.
    const layers: RainLayer[] = [
      { share: 0.5, speed: [650, 900], len: [16, 28], width: 2.6, alpha: 0.28, ground: [0.55, 0.8], splash: 0, drops: [] },
      { share: 0.3, speed: [1050, 1450], len: [36, 58], width: 3.6, alpha: 0.42, ground: [0.66, 0.92], splash: 3.5, drops: [] },
      { share: 0.2, speed: [1700, 2300], len: [70, 110], width: 5, alpha: 0.58, ground: [0.78, 1.06], splash: 5.5, drops: [] },
    ];
    const thunder = intensity >= 1.5;
    const splashes: Splash[] = [];
    const flashQueue: { at: number; a: number }[] = [];

    let width = 0;
    let height = 0;
    let raf = 0;
    let visible = false;
    let flashAlpha = 0;
    let nextFlash = performance.now() + rand(3000, 9000);

    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    const spawn = (layer: RainLayer, randomY: boolean): Drop => {
      const ground = height * rand(layer.ground[0], layer.ground[1]);
      return {
        x: Math.random() * width,
        y: randomY
          ? Math.random() * ground
          : -rand(layer.len[1], layer.len[1] * 3),
        len: rand(layer.len[0], layer.len[1]),
        speed: rand(layer.speed[0], layer.speed[1]),
        w: layer.width * rand(0.7, 1.3),
        ground,
      };
    };

    const resize = () => {
      // offsetWidth/Height = layout size, unaffected by the CSS rotation
      width = canvas.offsetWidth;
      height = canvas.offsetHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const total = ((width * height) / 9000) * intensity;
      for (const layer of layers) {
        const count = Math.round(total * layer.share);
        layer.drops = Array.from({ length: count }, () => spawn(layer, true));
      }
    };

    let last = 0;
    const frame = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;

      // Wind gusts: slant drifts slowly instead of a frozen angle
      const t = now / 1000;
      const gust = 6 + 2.4 * Math.sin(t * 0.33) + 0.9 * Math.sin(t * 1.07);
      canvas.style.transform = `rotate(${gust.toFixed(2)}deg) scale(1.32)`;

      ctx.clearRect(0, 0, width, height);
      for (const layer of layers) {
        ctx.globalAlpha = layer.alpha;
        for (const d of layer.drops) {
          d.y += d.speed * dt;
          if (d.y >= d.ground) {
            if (layer.splash && d.ground < height - 2 && splashes.length < 90) {
              splashes.push({
                x: d.x,
                y: d.ground,
                maxR: layer.splash * rand(0.7, 1.3),
                age: 0,
                life: rand(0.2, 0.34),
                base: layer.alpha * 1.1,
              });
            }
            Object.assign(d, spawn(layer, false));
          }
          ctx.drawImage(sprite, d.x, d.y - d.len, d.w, d.len);
        }
      }

      // Impact ripples: flattened ellipses expanding and fading on the ground
      ctx.strokeStyle = "rgba(205, 224, 248, 0.9)";
      ctx.lineWidth = 1;
      let live = 0;
      for (const s of splashes) {
        s.age += dt;
        const p = s.age / s.life;
        if (p >= 1) continue;
        splashes[live++] = s;
        const e = 1 - (1 - p) * (1 - p);
        ctx.globalAlpha = s.base * (1 - p);
        ctx.beginPath();
        ctx.ellipse(s.x, s.y, s.maxR * e, s.maxR * e * 0.32, 0, 0, Math.PI * 2);
        ctx.stroke();
      }
      splashes.length = live;

      // Lightning: each strike flickers 2-3 times like the real thing
      if (thunder) {
        if (now >= nextFlash) {
          const pulses = 2 + Math.floor(Math.random() * 2);
          let at = now;
          for (let i = 0; i < pulses; i++) {
            flashQueue.push({ at, a: rand(0.25, 0.5) * (i ? 0.7 : 1) });
            at += rand(60, 140);
          }
          nextFlash = now + rand(6000, 16000);
          if (visible) setTimeout(playThunder, rand(400, 1200));
        }
        while (flashQueue.length && flashQueue[0].at <= now) {
          flashAlpha = Math.max(flashAlpha, flashQueue.shift()!.a);
        }
        if (flashAlpha > 0.005) {
          ctx.globalAlpha = Math.min(flashAlpha, 1);
          ctx.fillStyle = "#dfe9ff";
          ctx.fillRect(0, 0, width, height);
          flashAlpha -= dt * 3.5;
        }
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(frame);
    };

    const play = () => {
      if (raf || !visible) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };
    const pause = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    // Only burn frames while the footer video is on screen
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        visible ? play() : pause();
      },
      { rootMargin: "80px" }
    ).observe(canvas);

    document.addEventListener("visibilitychange", () => {
      document.hidden ? pause() : play();
    });

    new ResizeObserver(resize).observe(canvas);
    resize();
    canvas.classList.add("is-raining");
    canvas.parentElement?.classList.add("is-rainy");
  };

  const initFooterRain = async () => {
    const w = await getVitWeather();
    showFooterWeather(w);
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const intensity = rainIntensity(w.code);
    if (intensity <= 0) return;
    if (intensity >= 1.5) armThunderAudio();
    document
      .querySelectorAll<HTMLCanvasElement>(".footer-rain")
      .forEach((canvas) => startRain(canvas, intensity));
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFooterRain);
  } else {
    initFooterRain();
  }
  // variants-mounted is dispatched on window, not document
  window.addEventListener("variants-mounted", initFooterRain);
</script>
