---
import Cassette from "../components/Cassette.astro";
import { getAssetUrl } from "../utils/cdn";

export interface Props {
  projects: Array<{
    cassette: {
      src?: string | null;
      svg?: string | null;
      alt: string;
    };
    textContent: {
      blocks: string[];
    };
    buttons: {
      primary: {
        backgroundColor: string;
        textColor: string;
        borderColor: string;
        borderRadius?: string;
      };
      visitWebsite: {
        text: string;
        backgroundColor: string;
        textColor: string;
        borderColor: string;
        borderRadius?: string;
        url?: string;
      };
      icons: Array<{
        type: string;
        backgroundColor: string;
        textColor: string;
        borderColor: string;
        iconColor: string;
        borderRadius?: string;
        url?: string;
      }>;
    };
    colors: {
      textColor: string;
      contentBlockBackground: string;
      hoverShadow: string;
    };
  }>;
}

const { projects = [] } = Astro.props;

const toSolid = (c: string) => {
  if (!c) return "#F95F4A";
  if (/gradient/i.test(c)) {
    const hex = c.match(/#[0-9a-fA-F]{3,8}/);
    return hex ? hex[0] : "#F95F4A";
  }
  return c;
};

const items = projects.map((p) => ({
  ...p,
  name: (p.cassette.alt || "").replace(/\s*image$/i, "").trim() || "Project",
  accent: toSolid(p.buttons.primary.backgroundColor),
}));
---

<section class="proj-mobile" data-proj-mobile>
  <div class="proj-carousel" data-proj-carousel>
    {
      items.map((it, i) => (
        <article
          class="proj-slide"
          data-proj-slide
          data-index={i}
          style={`--proj-color: ${it.accent}; --hoverShadow: ${it.colors.hoverShadow}; --textColor: ${it.colors.textColor};`}
        >
          <h3 class="slide-title">{it.name}</h3>

          <p class="slide-desc">{it.textContent.blocks[0]}</p>

          <div class="slide-actions">
            <a
              href={it.buttons.visitWebsite.url || "#"}
              target="_blank"
              rel="noopener noreferrer"
              class="slide-btn"
              style={`
                background: ${it.buttons.visitWebsite.backgroundColor};
                color: ${it.buttons.visitWebsite.textColor};
                border-color: ${it.buttons.visitWebsite.borderColor};
                ${it.buttons.visitWebsite.borderRadius ? `border-radius: ${it.buttons.visitWebsite.borderRadius};` : ""}
              `}
            >
              {it.buttons.visitWebsite.text}
            </a>

            {it.buttons.icons.map((icon) => (
              <a
                href={icon.url || "#"}
                target="_blank"
                rel="noopener noreferrer"
                class="slide-icon-btn"
                style={`
                  background: ${icon.backgroundColor};
                  border-color: ${icon.borderColor};
                  ${icon.borderRadius ? `border-radius: ${icon.borderRadius};` : "border-radius: 50%;"}
                `}
                aria-label={icon.type}
              >
                <img
                  src={getAssetUrl(`/${icon.type}-icon.webp`)}
                  alt={icon.type}
                  width="20"
                  style={`filter: brightness(0) saturate(100%) invert(${icon.iconColor === "#FEFCD9" ? "96%" : "0%"});`}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))}
          </div>

          <div class="slide-cassette">
            {it.cassette.svg ? (
              <img
                class="slide-cassette-art"
                src={getAssetUrl(it.cassette.svg)}
                alt={it.cassette.alt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Cassette
                overlaySrc={it.cassette.src ? getAssetUrl(it.cassette.src) : undefined}
                alt={it.cassette.alt}
                color={it.accent}
              />
            )}
          </div>
        </article>
      ))
    }
  </div>

  <div class="proj-controls">
    <button
      type="button"
      class="proj-arrow"
      data-proj-prev
      aria-label="Previous project"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg>
    </button>

    <div class="proj-dots" data-proj-dots>
      {
        items.map((it, i) => (
          <button
            type="button"
            class="proj-dot"
            data-proj-dot
            data-index={i}
            style={`--proj-color: ${it.accent};`}
            aria-label={`Go to project ${i + 1}`}
          />
        ))
      }
    </div>

    <button
      type="button"
      class="proj-arrow"
      data-proj-next
      aria-label="Next project"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
    </button>
  </div>
</section>

<style>
  .proj-mobile {
    width: 100%;
    padding: 1.5rem 0 2.5rem;
    color: #fefcd9;
  }

  .proj-carousel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .proj-carousel::-webkit-scrollbar {
    display: none;
  }

  .proj-slide {
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    padding: 0 1.25rem;
  }

  .slide-title {
    margin: 0;
    font-family: "PolySans Trial", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
    font-size: clamp(1.75rem, 8vw, 2.5rem);
    color: #fefcd9;
    text-align: center;
  }

  .slide-desc {
    margin: 1rem 0 0;
    font-family: "PolySans Trial", sans-serif;
    font-weight: 300;
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgba(254, 252, 217, 0.8);
  }

  .slide-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .slide-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 20px;
    border: 1px solid;
    border-radius: 25px;
    font-family: "PolySans Trial", sans-serif;
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .slide-btn:active {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px var(--hoverShadow);
  }

  .slide-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .slide-icon-btn:active {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px var(--hoverShadow);
  }

  .slide-cassette {
    margin: 2rem auto 0;
    width: 100%;
    max-width: 22rem;
  }
  .slide-cassette-art {
    width: 100%;
    height: auto;
    display: block;
  }

  .proj-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 2.25rem;
  }

  .proj-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(254, 252, 217, 0.4);
    background: transparent;
    color: #fefcd9;
    cursor: pointer;
    transition: background-color 0.3s ease, opacity 0.3s ease;
  }
  .proj-arrow:active {
    background: rgba(254, 252, 217, 0.1);
  }
  .proj-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .proj-dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .proj-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: rgba(254, 252, 217, 0.3);
    cursor: pointer;
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  .proj-dot[data-active="true"] {
    width: 22px;
    background: var(--proj-color, #f95f4a);
  }

  @media (prefers-reduced-motion: reduce) {
    .proj-carousel {
      scroll-behavior: auto;
    }
  }

  @font-face {
    font-family: "PolySans Trial";
    src: url("../assets/fonts/PolySans-trial/PolySans-trial/Mono/PolySansTrial-SlimMono.otf")
      format("opentype");
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "PolySans Trial";
    src: url("../assets/fonts/PolySans-trial/PolySans-trial/Mono/PolySansTrial-NeutralMono.otf")
      format("opentype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "PolySans Trial";
    src: url("../assets/fonts/PolySans-trial/PolySans-trial/Mono/PolySansTrial-MedianMono.otf")
      format("opentype");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "PolySans Trial";
    src: url("../assets/fonts/PolySans-trial/PolySans-trial/Mono/PolySansTrial-BulkyMono.otf")
      format("opentype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
</style>

<script>
  let mounted: HTMLElement | null = null;
  let cleanup: (() => void) | null = null;

  function initProjectsMobile() {
    const section = document.querySelector<HTMLElement>("[data-proj-mobile]");

    if (mounted && mounted !== section) {
      cleanup?.();
      cleanup = null;
      mounted = null;
    }
    if (!section || section.dataset.pmInit === "1") return;

    const carousel = section.querySelector<HTMLElement>("[data-proj-carousel]");
    const slides = Array.from(
      section.querySelectorAll<HTMLElement>("[data-proj-slide]"),
    );
    if (!carousel || slides.length === 0) return;

    section.dataset.pmInit = "1";
    mounted = section;

    const dots = Array.from(
      section.querySelectorAll<HTMLButtonElement>("[data-proj-dot]"),
    );
    const prevBtn = section.querySelector<HTMLButtonElement>("[data-proj-prev]");
    const nextBtn = section.querySelector<HTMLButtonElement>("[data-proj-next]");

    const base = () => slides[0]?.offsetLeft ?? 0;

    const currentIndex = () => {
      const target = carousel.scrollLeft + carousel.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      slides.forEach((s, i) => {
        const center = s.offsetLeft - base() + s.offsetWidth / 2;
        const d = Math.abs(center - target);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      });
      return best;
    };

    const syncControls = () => {
      const idx = currentIndex();
      dots.forEach((dot, i) => {
        dot.dataset.active = i === idx ? "true" : "false";
      });
      if (prevBtn) prevBtn.disabled = idx <= 0;
      if (nextBtn) nextBtn.disabled = idx >= slides.length - 1;
    };

    const goTo = (i: number) => {
      const clamped = Math.max(0, Math.min(slides.length - 1, i));
      carousel.scrollTo({
        left: slides[clamped].offsetLeft - base(),
        behavior: "smooth",
      });
    };

    const onScroll = () => syncControls();

    const onPrev = () => goTo(currentIndex() - 1);
    const onNext = () => goTo(currentIndex() + 1);
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        onPrev();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        onNext();
      }
    };
    const dotHandlers = dots.map((dot, i) => {
      const handler = () => goTo(i);
      dot.addEventListener("click", handler);
      return { dot, handler };
    });

    carousel.addEventListener("scroll", onScroll, { passive: true });
    prevBtn?.addEventListener("click", onPrev);
    nextBtn?.addEventListener("click", onNext);
    section.addEventListener("keydown", onKeydown);
    window.addEventListener("resize", syncControls, { passive: true });

    syncControls();

    cleanup = () => {
      carousel.removeEventListener("scroll", onScroll);
      prevBtn?.removeEventListener("click", onPrev);
      nextBtn?.removeEventListener("click", onNext);
      section.removeEventListener("keydown", onKeydown);
      window.removeEventListener("resize", syncControls);
      dotHandlers.forEach(({ dot, handler }) =>
        dot.removeEventListener("click", handler),
      );
    };
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectsMobile);
  } else {
    initProjectsMobile();
  }
  window.addEventListener("variants-mounted", () => initProjectsMobile());
</script>
