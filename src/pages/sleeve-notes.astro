  .dg-cm-tog.is-on {
    background: rgba(254, 252, 217, 0.14);
    color: #fefcd9;
  }
  .dg-cm-tag {
    position: absolute;
    left: 16px;
    bottom: 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    pointer-events: none;
  }
  #dg-cm-current {
    font-size: 15px;
    color: #fefcd9;
    font-weight: 600;
  }
  .dg-cm-fam {
    font-family: "PolySans Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: rgba(254, 252, 217, 0.45);
