  /* ── Cassette player mock ── */
  .dg-cp-stage {
    justify-content: center;
  }
  .dg-cp {
    width: 100%;
    max-width: 320px;
    padding: 16px;
    border-radius: 18px;
    background: linear-gradient(160deg, #201a17, #14100e);
    border: 1px solid rgba(254, 252, 217, 0.08);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
  }
  .dg-cp svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .dg-cp-body {
    fill: #2a221e;
    stroke: rgba(254, 252, 217, 0.1);
    stroke-width: 1;
  }
  .dg-cp-cover {
    fill: #1c1613;
    stroke: rgba(254, 252, 217, 0.06);
    stroke-width: 1;
  }
  .dg-cp-line {
    stroke: rgba(254, 252, 217, 0.08);
    stroke-width: 1;
  }
  .dg-cp-outer {
    fill: #14100e;
    stroke: rgba(254, 252, 217, 0.12);
    stroke-width: 1;
  }
  .dg-cp-mid {
    fill: #241d19;
  }
  .dg-cp-tape {
    fill: rgba(254, 252, 217, 0.06);
  }
  .dg-cp-hub {
    fill: #4a3f38;
  }
  .dg-cp-hub-accent {
    fill: #f95f4a;
  }
  .dg-cp-spoke {
    stroke: rgba(254, 252, 217, 0.3);
    stroke-width: 2;
  }
  .dg-cp-reel {
    transform-origin: center;
    transform-box: fill-box;
  }
  .dg-cp:hover .dg-cp-reel {
    animation: dg-cp-spin 3s linear infinite;
  }
  @keyframes dg-cp-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dg-cp:hover .dg-cp-reel {
      animation: none;
    }
  }
  .dg-cp-path {
    fill: none;
    stroke: rgba(254, 252, 217, 0.25);
    stroke-width: 1;
  }
  .dg-cp-window {
    fill: rgba(0, 0, 0, 0.4);
    stroke: rgba(254, 252, 217, 0.1);
    stroke-width: 1;
  }
  .dg-cp-post {
    fill: #4a3f38;
  }
  .dg-cp-label {
    fill: #fefcd9;
  }
  .dg-cp-title {
    fill: #17110f;
    font-family: "PolySans Trial", sans-serif;
    font-weight: 700;
    font-size: 9px;
  }
  .dg-cp-artist {
    fill: rgba(23, 17, 15, 0.6);
    font-family: "PolySans Mono", monospace;
    font-size: 6px;
    letter-spacing: 0.1em;
  }
  .dg-cp-btn-bg {
    fill: rgba(254, 252, 217, 0.06);
    stroke: rgba(254, 252, 217, 0.1);
    stroke-width: 1;
  }
  .dg-cp-btn-ico {
    fill: rgba(254, 252, 217, 0.75);
  }
  .dg-cp-play-bg {
    fill: #f95f4a;
  }
  .dg-cp-prog-bg {
    fill: rgba(254, 252, 217, 0.12);
  }
  .dg-cp-prog-fill {
    fill: #f95f4a;
  }
  .dg-cp-time {
    fill: rgba(254, 252, 217, 0.4);
    font-family: "PolySans Mono", monospace;
    font-size: 6px;
  }
  .dg-cp-pin {
    fill: rgba(254, 252, 217, 0.2);
  }
  .dg-cp-screw {
    fill: rgba(254, 252, 217, 0.15);
  }

  /* ── Contributor pills ── */
  .dg-people-stage {
    --proj: #f95f4a;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
  .dg-people {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
