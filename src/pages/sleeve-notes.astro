<script>
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const swatch = target?.closest<HTMLElement>("[data-copy-hex]");
    if (!swatch) return;

    const hex = swatch.dataset.copyHex;
    if (!hex) return;

    navigator.clipboard?.writeText(hex).then(() => {
      swatch.classList.add("is-copied");
      window.setTimeout(() => swatch.classList.remove("is-copied"), 1400);
    });
  });

  function initDesignGuideReveal() {
    const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
    if (!els.length) return;

    import("gsap").then(({ gsap }) => {
      import("gsap/ScrollTrigger").then(({ ScrollTrigger }) => {
        gsap.registerPlugin(ScrollTrigger);
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        els.forEach((el) => {
          if (reduce) {
            gsap.set(el, { opacity: 1 });
            return;
          }
          gsap.fromTo(
            el,
            { opacity: 0, y: 24 },
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: "power3.out",
              scrollTrigger: { trigger: el, start: "top 88%" },
            },
          );
        });
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDesignGuideReveal);
  } else {
    initDesignGuideReveal();
  }

  // ── Side rail scroll-spy (cassette strip progress) ──
  function initDesignGuideRail() {
    const rail = document.getElementById("dgRail");
    const fill = document.getElementById("dgRailFill");
    if (!rail) return;
    const items = Array.from(rail.querySelectorAll(".dg-rail-item"));
    const sections = items
      .map((it) => document.getElementById(it.getAttribute("data-rail") || ""))
      .filter((el) => !!el);
    if (!sections.length) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const line = window.innerHeight * 0.32;
      let active = 0;
      sections.forEach((sec, i) => {
        if (sec.getBoundingClientRect().top <= line) active = i;
      });
      items.forEach((it, i) => {
        it.classList.toggle("is-active", i === active);
        it.classList.toggle("is-done", i < active);
      });
      if (fill) fill.style.height = `${((active + 1) / items.length) * 100}%`;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDesignGuideRail);
  } else {
    initDesignGuideRail();
  }

  // ── Inert mobile-navbar replica: morph panels, never navigate ──
  function initDesignGuideMnx() {
    const pill = document.getElementById("dgMnxPill");
    if (!pill) return;
    const panels = Array.from(pill.querySelectorAll(".dg-mnx-panel"));
    const show = (state) => {
      pill.setAttribute("data-state", state);
      panels.forEach((p) => {
        const on = p.getAttribute("data-mnx") === state;
        if (on) p.removeAttribute("hidden");
        else p.setAttribute("hidden", "");
        // restart the entry animation
        if (on) {
          p.style.animation = "none";
          void p.offsetWidth;
          p.style.animation = "";
        }
      });
    };
    pill.addEventListener("click", (e) => {
      const t = e.target.closest("[data-mnx-go],[data-mnx-play]");
      if (!t) return;
      e.preventDefault();
      if (t.hasAttribute("data-mnx-go")) show(t.getAttribute("data-mnx-go"));
      if (t.hasAttribute("data-mnx-play")) {
        const playing = pill.classList.toggle("is-playing");
        const p = t.querySelector(".dg-mnx-ico-play");
        const q = t.querySelector(".dg-mnx-ico-pause");
        if (p && q) {
          p.hidden = playing;
          q.hidden = !playing;
        }
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDesignGuideMnx);
  } else {
    initDesignGuideMnx();
  }

  // Demo buttons are for show - swallow their clicks so nothing navigates.
  document.querySelectorAll(".dg-inert").forEach((wrap) => {
    wrap.addEventListener("click", (e) => {
      const hit = (e.target as HTMLElement).closest("a,button");
      if (hit && wrap.contains(hit)) e.preventDefault();
    });
  });
</script>

<script>
  // Live character-map specimen. Measures the selected PolySans / Cormorant
  // face off a canvas, draws the glyph against cap/x-height/baseline/descender
  // guides, and recolours when the site theme is toggled. Mirrors the
  // /design typography specimen, retuned for the dark cassette palette.
  const svg = document.getElementById("dg-cm-svg");
  const grid = document.getElementById("dg-cm-grid");
  const current = document.getElementById("dg-cm-current");
  const famLabel = document.getElementById("dg-cm-fam");

  if (svg && grid) {
    const NS = "http://www.w3.org/2000/svg";
    const VBW = 660;
    const S = 440; // glyph size in svg units
    const INSET = 12;
    const PAD = 40;
    const GX = VBW * 0.5;

    let INK = "#fefcd9";
    let INK3 = "rgba(254,252,217,0.5)";
    let BG = "#0d0e0d";
    const MONO = '"PolySans Mono", monospace';

    function readTheme() {
      const light = document.documentElement.getAttribute("data-theme") === "light";
      INK = light ? "#1a1a1a" : "#fefcd9";
      INK3 = light ? "rgba(26,26,26,0.5)" : "rgba(254,252,217,0.5)";
      BG = light ? "#f5ede4" : "#0d0e0d";
    }

    let font = "PolySans Trial";
    let glyph = "H";
    let mode = "solid";
    let m = { cap: 0.71, xh: 0.52, desc: 0.22, asc: 0.99, descMax: 0.27 };

    const FS = 400;
    const mctx = document.createElement("canvas").getContext("2d");
    const setFont = () => {
      if (mctx) {
        mctx.font = `${FS}px "${font}", sans-serif`;
        mctx.textBaseline = "alphabetic";
        mctx.textAlign = "center";
      }
    };

    function measureFont() {
      if (!mctx) return m;
      setFont();
      const cap = mctx.measureText("H").actualBoundingBoxAscent / FS;
      const xh = mctx.measureText("x").actualBoundingBoxAscent / FS;
      let desc = 0;
      for (const c of "gjpqy") desc = Math.max(desc, mctx.measureText(c).actualBoundingBoxDescent / FS);
      let asc = cap;
      for (const c of "ÅÄÁÀÂÃÉÊÍÎÏÑÓÔÕÖÜÚÛÝbdfhklt") asc = Math.max(asc, mctx.measureText(c).actualBoundingBoxAscent / FS);
      let descMax = desc;
      for (const c of "gjpqyQÇç") descMax = Math.max(descMax, mctx.measureText(c).actualBoundingBoxDescent / FS);
      if (!cap || !xh) return m;
      return { cap, xh, desc, asc, descMax };
    }

    function glyphBounds(ch) {
      if (!mctx) return { asc: m.cap * S, desc: m.desc * S, left: S * 0.3, right: S * 0.3 };
      setFont();
      const t = mctx.measureText(ch);
      return {
        asc: ((t.actualBoundingBoxAscent || m.cap * FS) / FS) * S,
        desc: ((t.actualBoundingBoxDescent || 0) / FS) * S,
        left: ((t.actualBoundingBoxLeft || t.width / 2) / FS) * S,
        right: ((t.actualBoundingBoxRight || t.width / 2) / FS) * S,
      };
    }

    function el(name, attrs, text) {
      const n = document.createElementNS(NS, name);
      for (const k in attrs) n.setAttribute(k, String(attrs[k]));
      if (text != null) n.textContent = text;
      return n;
    }

    function anchor(px, py) {
      const sq = 11;
      return el("rect", { x: px - sq / 2, y: py - sq / 2, width: sq, height: sq, fill: BG, stroke: INK, "stroke-width": 1.6 });
    }

    function build() {
      readTheme();
      const capPx = m.cap * S;
      const xPx = m.xh * S;
      const descPx = m.desc * S;
      const capY = -capPx, xY = -xPx, baseY = 0, descY = descPx;

      const top = -m.asc * S - PAD;
      const bottom = m.descMax * S + PAD;
      svg.setAttribute("viewBox", `0 ${top} ${VBW} ${bottom - top}`);
      while (svg.firstChild) svg.removeChild(svg.firstChild);

      if (mode === "solid") {
        svg.appendChild(el("text", { x: GX, y: baseY, "font-size": S, "font-family": `"${font}", sans-serif`, "text-anchor": "middle", fill: INK }, glyph));
      } else {
        svg.appendChild(el("text", { x: GX, y: baseY, "font-size": S, "font-family": `"${font}", sans-serif`, "text-anchor": "middle", fill: "none", stroke: INK, "stroke-width": 2 }, glyph));
        const gb = glyphBounds(glyph);
        const lx = GX - gb.left, rx = GX + gb.right, ty = -gb.asc, by = gb.desc;
        for (const [px, py] of [[lx, ty], [rx, ty], [GX, ty], [lx, by], [rx, by], [GX, by]]) svg.appendChild(anchor(px, py));
      }

      const lines = [
        { y: capY, lbl: "CAP HEIGHT", val: Math.round(m.cap * 1000) },
        { y: xY, lbl: "X-HEIGHT", val: Math.round(m.xh * 1000) },
        { y: baseY, lbl: "BASELINE", val: 0, strong: true },
        { y: descY, lbl: "DESCENDER", val: -Math.round(m.desc * 1000) },
      ];
      const vw = 46, vx = VBW - INSET - vw;
      for (const ln of lines) {
        svg.appendChild(el("line", { x1: INSET, y1: ln.y, x2: VBW - INSET, y2: ln.y, stroke: INK3, "stroke-width": 1.6, "stroke-linecap": "round", "stroke-dasharray": "1 6", opacity: ln.strong ? 0.9 : 0.6 }));
        svg.appendChild(el("text", { x: INSET, y: ln.y - 8, fill: INK3, "font-family": MONO, "font-size": 11, "letter-spacing": 0.6 }, ln.lbl));
        svg.appendChild(el("rect", { x: vx, y: ln.y - 18, width: vw, height: 15, rx: 3, fill: INK }));
        svg.appendChild(el("text", { x: vx + vw / 2, y: ln.y - 7, "text-anchor": "middle", fill: BG, "font-family": MONO, "font-size": 11, "font-weight": 600 }, ln.val));
      }
    }

    function setGlyph(ch, btn) {
      if (!ch || ch === glyph) return;
      glyph = ch;
      if (current) current.textContent = ch;
      grid.querySelectorAll(".dg-cm-cell.is-active").forEach((b) => {
        b.classList.remove("is-active");
        b.setAttribute("aria-selected", "false");
      });
      if (btn) {
        btn.classList.add("is-active");
        btn.setAttribute("aria-selected", "true");
      }
      build();
    }

    const handle = (e) => {
      const btn = (e.target as HTMLElement).closest(".dg-cm-cell");
      if (btn) setGlyph(btn.getAttribute("data-g"), btn);
    };
    grid.addEventListener("pointerover", handle);
    grid.addEventListener("click", handle);
    grid.addEventListener("focusin", handle);

    // family switch
    const fonts = Array.from(document.querySelectorAll(".dg-cm-font"));
    fonts.forEach((f) => {
      f.addEventListener("click", () => {
        font = f.getAttribute("data-font") || "PolySans Trial";
        grid.style.setProperty("--dg-cm-font", `"${font}"`);
        if (famLabel) famLabel.textContent = f.getAttribute("data-lbl") || font;
        fonts.forEach((o) => {
          const on = o === f;
          o.classList.toggle("is-on", on);
          o.setAttribute("aria-selected", on ? "true" : "false");
        });
        m = measureFont();
        build();
      });
    });

    // solid / outline toggle
    const togs = Array.from(document.querySelectorAll(".dg-cm-tog"));
    togs.forEach((t) => {
      t.addEventListener("click", () => {
        mode = t.getAttribute("data-mode") || "solid";
        togs.forEach((o) => {
          const on = o === t;
          o.classList.toggle("is-on", on);
          o.setAttribute("aria-selected", on ? "true" : "false");
        });
        build();
      });
    });

    const go = () => {
      m = measureFont();
      build();
    };
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(go);
    else go();

    // recolour when the site theme is toggled
    new MutationObserver(() => build()).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }
</script>
