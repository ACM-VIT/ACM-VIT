  /* ── Interactive mobile-navbar replica (dg-mnx) ── */
  .dg-mnx-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 2.2rem 1rem;
    border-radius: 16px;
    background:
      radial-gradient(70% 130% at 50% 100%, rgba(249, 95, 74, 0.08), transparent 70%),
