  .dg-cm-cell {
    aspect-ratio: 1 / 1;
    border: none;
    background: #0d0e0d;
    color: #fefcd9;
    font-family: var(--dg-cm-font, "PolySans Trial"), sans-serif;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .dg-cm-cell:hover {
    background: rgba(254, 252, 217, 0.06);
  }
  .dg-cm-cell.is-active {
    background: #f95f4a;
    color: #0d0e0d;
  }
  .dg-cm-cell:focus-visible {
    outline: 2px solid #f95f4a;
    outline-offset: -2px;
    z-index: 1;
  }
  :global(html[data-theme="light"]) .dg-charmap {
    border-color: rgba(26, 26, 26, 0.12);
    background: rgba(0, 0, 0, 0.02);
  }
  :global(html[data-theme="light"]) .dg-cm-stage {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(26, 26, 26, 0.12);
  }
  :global(html[data-theme="light"]) .dg-cm-grid {
    background: rgba(26, 26, 26, 0.1);
  }
  :global(html[data-theme="light"]) .dg-cm-cell {
    background: #f5ede4;
    color: #1a1a1a;
  }
  :global(html[data-theme="light"]) .dg-cm-cell.is-active {
    color: #f5ede4;
  }
  :global(html[data-theme="light"]) #dg-cm-current {
    color: #1a1a1a;
  }

  /* ── Navigation demo pill ── */
  .dg-nav-demo {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 2.4rem 1.6rem;
    border-radius: 16px;
    background:
      radial-gradient(60% 120% at 50% 0%, rgba(249, 95, 74, 0.1), transparent 70%),
      rgba(13, 14, 13, 0.5);
    border: 1px solid rgba(254, 252, 217, 0.08);
    justify-content: center;
  }
  .dg-pill {
    display: inline-flex;
    align-items: center;
    gap: 0;
    height: 44px;
    padding: 0 16px;
    border-radius: 100px;
    background: rgba(6, 2, 2, 0.5);
    border: 1px solid rgba(249, 95, 74, 0.75);
    backdrop-filter: blur(20px) saturate(200%);
    -webkit-backdrop-filter: blur(20px) saturate(200%);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.18);
    transition: border-color 0.4s cubic-bezier(0.25, 0.1, 0.25, 1), padding 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .dg-pill:hover {
    border-color: rgba(249, 95, 74, 1);
    padding: 0 20px;
  }
  .dg-nav-item {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 5px 10px;
    border-radius: 100px;
    transition: gap 0.38s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .dg-pill:hover .dg-nav-item {
    gap: 7px;
  }
  .dg-nav-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(254, 252, 217, 0.5);
    flex: none;
    transition: background 0.35s cubic-bezier(0.25, 0.1, 0.25, 1), box-shadow 0.35s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .dg-nav-item.is-active .dg-nav-dot {
    background: #f95f4a;
    box-shadow: 0 0 8px rgba(249, 95, 74, 0.8);
  }
  .dg-pill:hover .dg-nav-item:hover .dg-nav-dot {
    background: #f95f4a;
  }
  .dg-nav-label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-family: "PolySans Trial", sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    color: #fefcd9;
    opacity: 0;
    transition: max-width 0.38s cubic-bezier(0.25, 0.1, 0.25, 1), opacity 0.3s ease;
  }
  .dg-nav-item.is-active .dg-nav-label,
  .dg-pill:hover .dg-nav-label {
    max-width: 90px;
    opacity: 1;
  }
  .dg-nav-hint {
    font-family: "PolySans Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(254, 252, 217, 0.35);
  }
  :global(html[data-theme="light"]) .dg-nav-demo {
    border-color: rgba(26, 26, 26, 0.08);
  }

