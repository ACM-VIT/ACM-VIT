  :global(html[data-theme="light"]) #dg-cm-current {
    color: #1a1a1a;
  }
  :global(html[data-theme="light"]) .dg-cm-fam {
    color: rgba(26, 26, 26, 0.5);
  }
  .dg-cm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(50px, 1fr));
    gap: 1px;
    background: rgba(254, 252, 217, 0.1);
