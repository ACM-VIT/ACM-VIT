---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import "../styles/globals.css";
import Footer from "../layouts/Footer.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import FillButton from "../components/ui/FillButton.astro";
import AnimatedButton from "../components/ui/AnimatedButton.astro";
import CassetteTile from "../components/ui/CassetteTile.astro";
import BoardMemberCardSingular from "../components/ui/BoardMemberCardSingular.astro";
import { getAssetUrl } from "../utils/cdn";

type Swatch = { name: string; hex: string; note: string };

const coreColors: Swatch[] = [
  { name: "Primary Orange", hex: "#F95F4A", note: "The brand color. CTAs, links, accents." },
  { name: "Pink", hex: "#FF007A", note: "ACM-W, merch, secondary accents." },
  { name: "Blue", hex: "#135DE2", note: "GREP, informational highlights." },
  { name: "Green", hex: "#42CD9D", note: "z0d1ak, success states." },
  { name: "Gold", hex: "#F2C94C", note: "Achievements, celebratory moments." },
  { name: "Purple", hex: "#9B51E0", note: "Cassette Builder, creative tools." },
  { name: "Teal", hex: "#008080", note: "Calendar, scheduling contexts." },
  { name: "Cyan", hex: "#00B4D8", note: "FAQs, reference & docs pages." },
];

const baseColors: Swatch[] = [
  { name: "Ink (dark bg)", hex: "#0D0E0D", note: "Default site background." },
  { name: "Cream", hex: "#FEFCD9", note: "Primary text on dark, sticker labels." },
  { name: "Paper (light bg)", hex: "#F5EDE4", note: "Light-mode background." },
  { name: "Charcoal (light text)", hex: "#1A1A1A", note: "Primary text on light mode." },
];

// Domain accents - the six colors that key the domain pages, the calendar
// cassettes, and the nav dots. Distinct from the marketing palette above.
const domainColors: Swatch[] = [
  { name: "Tech", hex: "#9B51E0", note: "App Dev, Web, FOSS, DevOps." },
  { name: "Design", hex: "#FF0054", note: "UI/UX, motion, 3D." },
  { name: "Research", hex: "#135DE2", note: "AI/ML, blockchain, quantum." },
  { name: "Management", hex: "#00B4B4", note: "Operations & coordination." },
  { name: "Competitive Coding", hex: "#42CD9D", note: "Codeforces, ICPC, C++." },
  { name: "Blog / ACM orange", hex: "#F95F4A", note: "Blog posts & shared chapter surfaces." },
];

// The three PolySans cuts the site actually renders in, plus the editorial serif.
const typeFamilies = [
  {
    id: "standard",
    css: "PolySans Trial",
    tag: "Display / Headings / UI",
    sample: "PolySans",
    desc: "The Standard cut. Every heading, button label, and nav item. Bold, tight tracking, uppercase for titles.",
    files: "PolySans-Slim / Neutral / Median / Bulky .otf",
  },
  {
    id: "mono",
    css: "PolySans Mono",
    tag: "Labels / Tags / Running copy",
    sample: "PolySans Mono - tags, chips, code",
    desc: "The Mono cut. Wide-tracked micro-labels, chips, timestamps, and the long-form copy inside guides like this one.",
    files: "PolySans-*Mono.otf",
  },
  {
    id: "wide",
    css: "PolySans Wide",
    tag: "Wide - oversized moments only",
    sample: "WIDE LOAD",
    desc: "The Wide cut. Reserved for a handful of oversized display beats. Never body copy - it eats horizontal space.",
    files: "PolySans-*Wide.otf",
  },
  {
    id: "serif",
    css: "Cormorant Garamond",
    tag: "Editorial accent - used sparingly",
    sample: "Cormorant Garamond",
    desc: "A high-contrast serif for one-off editorial pages (Achievements). A guest, never a default.",
    files: "Google Fonts (OFL)",
  },
];

// Four weights of the Standard cut - the ladder used across the chrome.
const typeWeights = [
  { w: 300, name: "Slim", use: "Thin display accents" },
  { w: 400, name: "Neutral", use: "Body & default UI" },
  { w: 500, name: "Median", use: "Nav labels, emphasis" },
  { w: 700, name: "Bulky", use: "Headings, wordmark weight" },
];

// Glyph set for the interactive character map - the full Latin set the
// PolySans cuts ship with, mirrored from the /design typography specimen.
const glyphs = [
  ..."ABCDEFGHIJKLMNOPQRSTUVWXYZ",
  ..."ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÑÒÓÔÕÖØÙÚÛÜÝ",
  ..."abcdefghijklmnopqrstuvwxyz",
  ..."àáâãäåæçèéêëìíîïñòóôõöøùúûüýÿ",
  ..."0123456789",
  ..."&@#$€.,;:!?'\"()[]{}/\\%+-=*·•…",
];

// ── Cassette variants (section 04) ──────────────────────────────────────────
// Blank label templates - no artwork, just the tape in a brand color.
const blankTapes = [
  { src: "/cassettes/cassettes-cassette-layout-orange.webp", name: "Orange", use: "Default board / member cards" },
  { src: "/cassettes/cassettes-cassette-layout-pink.webp", name: "Pink", use: "ACM-W members & leads" },
  { src: "/cassettes/cassettes-cassette-layout-white.webp", name: "White", use: "Gallery fallback art" },
];

// The three "About" tapes in the About section + nav dropdown.
const aboutTapes = [
  { src: "/about/about-acmvit-cassette.webp", name: "ACM-VIT", use: "Chapter mission tile" },
  { src: "/about/about-vit-cassette.webp", name: "VIT", use: "University tile" },
  { src: "/about/about-acm-cassette.webp", name: "ACM Global", use: "Global society tile" },
];

// Bespoke artwork tapes - one drawn per item. Samples only.
const sampleEvents = [
  "/events/events-c2c-cassette.webp",
  "/events/events-cryptic-hunt-cassette.webp",
  "/events/events-inspiher-cassette.webp",
  "/events/events-forktober-cassette.webp",
  "/events/events-neural-hack-cassette.webp",
];
const sampleProjects = [
  getAssetUrl("/projects/cassettes/projects-cassettes-conclave.svg"),
  getAssetUrl("/projects/cassettes/projects-cassettes-wenvy.svg"),
  getAssetUrl("/projects/cassettes/projects-cassettes-ocs-26.webp"),
];
const sampleMerch = [
  getAssetUrl("/merch/merch-cassette-2026.webp"),
  getAssetUrl("/merch/merch-cassette-2025.webp"),
  getAssetUrl("/merch/merch-cassette-2024.webp"),
];

// Domain cassettes for the calendar legend demo (also reused in section 04).
const calDomains = [
  { label: "Tech", color: "#9B51E0", cassette: "/cassettes/cassettes-cassette-tech.webp" },
  { label: "Design", color: "#FF0054", cassette: "/cassettes/cassettes-cassette-design.webp" },
  { label: "Research", color: "#135DE2", cassette: "/cassettes/cassettes-cassette-research.webp" },
  { label: "Management", color: "#00B4B4", cassette: "/cassettes/cassettes-cassette-management.webp" },
  { label: "Competitive Coding", color: "#42CD9D", cassette: "/cassettes/cassettes-cassette-cc.webp" },
];

// Side progress rail - the cassette strip. Order must match section order.
const railSections = [
  { id: "homage", label: "Homage" },
  { id: "giants", label: "Giants" },
  { id: "marks", label: "Marks" },
  { id: "color", label: "Color" },
  { id: "cassettes", label: "Cassettes" },
  { id: "type", label: "Type" },
  { id: "charmap", label: "Char Map" },
  { id: "nav", label: "Navigation" },
  { id: "buttons", label: "Buttons" },
  { id: "cards", label: "Components" },
  { id: "calendar", label: "Calendar" },
  { id: "motion", label: "Motion" },
  { id: "voice", label: "Voice" },
];

const doList = [
  "Dry, self-aware wit - we can laugh at ourselves",
  "Cassette & mixtape metaphors where they fit naturally",
  "Plain dashes for breaks in a sentence - like this",
  "Short, confident sentences over long corporate ones",
  "Specific numbers and details over vague hype",
];

const dontList = [
  "Don't reach for em dashes - use a plain dash instead",
  "Don't call every event a \"flagship\" - save the word for when it's true",
  "Don't force a cassette pun where it doesn't fit",
  "Don't write copy that could belong to any other org",
  "Don't oversell - let the work speak first",
];
---

<Layout pageTitle="Sleeve Notes" backHref="/" bleedBg>
  <main class="dg-page relative w-full overflow-hidden">
    <div class="dg-glow" aria-hidden="true"></div>

    <!-- Side progress rail -->
    <nav class="dg-rail" id="dgRail" aria-label="Section progress">
      <span class="dg-rail-line" aria-hidden="true">
        <span class="dg-rail-prog" id="dgRailFill"></span>
      </span>
      <ul class="dg-rail-list">
        {
          railSections.map((s, i) => (
            <li>
              <a href={`#${s.id}`} class="dg-rail-item" data-rail={s.id} aria-label={s.label}>
                <span class="dg-rail-tick"></span>
                <span class="dg-rail-label">
                  <span class="dg-rail-num">{String(i + 1).padStart(2, "0")}</span>
                  {s.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="dg-inner relative z-10 mx-auto w-full max-w-5xl px-5 pb-28 pt-32 sm:px-8">
      <SectionHeading
        title="Design"
        accent="Guide"
        subtitle="The sleeve notes to ACM-VIT - how we look, sound, and talk, for anyone building alongside us, on or off the site."
        align="left"
        class="mb-10 !px-0"
      />

      <a
        href="/design"
        class="dg-system-link"
        data-reveal
        aria-label="Open the full ACM-VIT design guidelines"
      >
        <span class="dg-system-link-text">
          <strong>Looking for the full brand system?</strong>
          Logo files, color, type, grids, motion, and social standards live in
          the ACM-VIT Design Guidelines.
        </span>
        <span class="dg-system-link-cta">Open guidelines →</span>
      </a>

      <!-- ─────────── Inspiration & Homage ─────────── -->
      <section class="dg-section" id="homage" data-reveal>
        <header class="dg-head">
          <span class="dg-num">01</span>
          <h2 class="dg-title">Inspiration &amp; Homage</h2>
        </header>

        <p class="dg-homage-lead">
          Why a cassette? Because it is one of those small inventions that quietly rewired how people live with technology.
        </p>

        <p class="dg-lede">
          The compact cassette showed up in the 1960s and did something radical for its moment. It let ordinary
          people record, copy, and carry sound without a studio, a label, or anyone's permission. Portable audio
          stopped being a promise and turned into something you could drop in a pocket. It gave us the Walkman, the
          mixtape you made for one specific person, the bootleg passed hand to hand at the back of a class. That
          instinct - personal, portable, made to be shared - is the same one running through everything we stream
          today. The cassette did not just play music. It changed who got to be the one pressing record.
        </p>

        <p class="dg-lede">
          So we built the site as a tape, not a website wearing a tape costume. The cassette held recordings; this one
          holds ACM-VIT's events, projects, and the stuff we have actually shipped. Each section is a track you play,
          not a menu item you click. It runs front to back, in order, the way someone hands you a mixtape they made on
          purpose.
        </p>

        <p class="dg-lede">
          A cassette also happens to suit a computer science chapter. It was hacker hardware before that was a word:
          people spliced tape, dubbed copies for friends, wrote the liner notes by hand, and passed the results around.
          Same loop we run now. Build something, ship it, remix what someone else made, hand it forward. The tape became
          repos and streams, but the habit did not change.
        </p>

        <p class="dg-lede dg-homage-close">
          So the cassette is not nostalgia for its own sake. It is a small tribute to everyone who kept pressing record
          before any of this was easy, and a reminder of what we are here for. Honour the inventions that got us this
          far, then go build the ones that come next.
        </p>

        <a class="dg-homage-cta" href="/cassette" data-reveal>
          <svg class="dg-homage-cta-tape" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="5" width="20" height="14" rx="2" />
            <circle cx="8" cy="12" r="2" />
            <circle cx="16" cy="12" r="2" />
            <path d="M10 12h4M7 19l1.5-3h7L17 19" />
          </svg>
          <span>See the journey of a cassette</span>
          <svg class="dg-homage-cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </section>

      <!-- ─────────── Standing on Giants ─────────── -->
      <section class="dg-section" id="giants" data-reveal>
        <header class="dg-head">
          <span class="dg-num">02</span>
          <h2 class="dg-title">Standing on Giants</h2>
        </header>
        <p class="dg-lede">
          Look closely at the cassette on any Area of Interest page and the label art is not decoration. Each tape is
          set against the headquarters of a company that pushed that field forward - Apple Park behind App
          Development, the Googleplex behind Web, and so on across Tech, Design, and Research. A quiet nod to the work
          we build on top of.
        </p>
        <a
          href="/sleeve-notes/giants"
          class="dg-system-link"
          aria-label="See every Area of Interest cassette and the company behind it"
        >
          <span class="dg-system-link-text">
            <strong>See every cassette and the giant behind it</strong>
            A full breakdown of which headquarters hides on each Area of Interest tape, and what that company did for
            its field.
          </span>
          <span class="dg-system-link-cta">Open the collection →</span>
        </a>
      </section>

      <!-- ─────────── Brand Marks ─────────── -->
      <section class="dg-section" id="marks" data-reveal>
        <header class="dg-head">
          <span class="dg-num">03</span>
          <h2 class="dg-title">Brand Marks</h2>
        </header>

        <div class="dg-marks-grid">
          <div class="dg-mark-card dg-mark-dark">
            <img src="/logos/logos-acm-topleft.webp" alt="ACM-VIT primary logo" loading="lazy" decoding="async" />
            <span class="dg-mark-label">Primary mark - on dark</span>
          </div>
          <div class="dg-mark-card dg-mark-light">
            <img src="/logos/logos-acm-logo-black.webp" alt="ACM-VIT logo, black variant" loading="lazy" decoding="async" />
            <span class="dg-mark-label">Black variant - on light / print</span>
          </div>
          <div class="dg-mark-card dg-mark-dark">
            <img src="/logos/logos-vit.webp" alt="VIT logo, paired mark" loading="lazy" decoding="async" />
            <span class="dg-mark-label">VIT pairing - homepage only</span>
          </div>
          <div class="dg-mark-card dg-mark-dark">
            <img src="/logos/logos-acmw-logo.webp" alt="ACM-W sub-brand logo" loading="lazy" decoding="async" />
            <span class="dg-mark-label">ACM-W - sub-brand mark</span>
          </div>
        </div>

        <div class="dg-rules">
          <div class="dg-rule-col">
            <p class="dg-rule-label dg-rule-good">Do</p>
            <ul>
              <li>Keep clear space around the mark equal to the diamond's own width</li>
              <li>Use the black variant on light or busy backgrounds</li>
              <li>Scale proportionally - the diamond never distorts</li>
            </ul>
          </div>
          <div class="dg-rule-col">
            <p class="dg-rule-label dg-rule-bad">Don't</p>
            <ul>
              <li>Recolor the mark outside the approved variants</li>
              <li>Rotate, skew, or add effects like drop shadows</li>
              <li>Place it on a background it can't be read against</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- ─────────── Color System ─────────── -->
      <section class="dg-section" id="color" data-reveal>
        <header class="dg-head">
          <span class="dg-num">04</span>
          <h2 class="dg-title">Color System</h2>
        </header>
        <p class="dg-lede">
          One accent color per context, not a rainbow per page. Click any swatch to copy its hex.
        </p>

        <div class="dg-swatch-grid">
          {
            coreColors.map((c) => (
              <button class="dg-swatch" type="button" data-copy-hex={c.hex} style={`--sw: ${c.hex}`}>
                <span class="dg-swatch-chip"></span>
                <span class="dg-swatch-meta">
                  <span class="dg-swatch-name">{c.name}</span>
                  <span class="dg-swatch-hex">{c.hex}</span>
                  <span class="dg-swatch-note">{c.note}</span>
                </span>
              </button>
            ))
          }
        </div>

        <p class="dg-lede dg-lede-tight">Base - the neutrals everything else sits on.</p>
        <div class="dg-swatch-grid dg-swatch-grid-base">
          {
            baseColors.map((c) => (
              <button class="dg-swatch" type="button" data-copy-hex={c.hex} style={`--sw: ${c.hex}`}>
                <span class="dg-swatch-chip"></span>
                <span class="dg-swatch-meta">
                  <span class="dg-swatch-name">{c.name}</span>
                  <span class="dg-swatch-hex">{c.hex}</span>
                  <span class="dg-swatch-note">{c.note}</span>
                </span>
              </button>
            ))
          }
        </div>

        <p class="dg-lede dg-lede-tight">
          Domain accents - the same palette, assigned. Each domain owns one
          fixed color that keys its page, its calendar cassette, its nav dot,
          and the event legend. It never gets swapped or reassigned.
        </p>
        <div class="dg-domain-map">
          {
            domainColors.map((c) => (
              <button class="dg-domain-chip" type="button" data-copy-hex={c.hex} style={`--sw: ${c.hex}`}>
                <span class="dg-domain-dot"></span>
                <span class="dg-domain-name">{c.name}</span>
                <span class="dg-domain-hex">{c.hex}</span>
              </button>
            ))
          }
        </div>
      </section>

      <!-- ─────────── Cassette Variants ─────────── -->
      <section class="dg-section" id="cassettes" data-reveal>
        <header class="dg-head">
          <span class="dg-num">05</span>
          <h2 class="dg-title">Cassette Variants</h2>
        </header>
        <p class="dg-lede">
          The cassette is the site's load-bearing object - the shape the whole
          brand hangs on. Every tape shares the same silhouette (corner screws,
          a cream sticker, twin reels) and is then restyled per context. They
          come in two kinds: <strong>pre-drawn artwork</strong> shipped as image
          files, and <strong>code-drawn</strong> tapes rendered live in the
          browser. Below is every family, what it is, and where it runs.
        </p>

        <p class="dg-cass-cap">
          Domain tapes - a fixed, pre-drawn tape per domain. The label art is
          locked to that domain's accent and never recolored, so a domain reads
          the same everywhere it appears.
        </p>
        <div class="dg-cass-grid">
          {
            calDomains.map((d) => (
              <figure class="dg-cass" style={`--sw:${d.color}`}>
                <img src={d.cassette} alt={`${d.label} cassette`} loading="lazy" decoding="async" />
                <figcaption>{d.label}</figcaption>
              </figure>
            ))
          }
        </div>
        <p class="dg-cass-where">Used on: domain landing pages, the calendar legend & event cassettes, and the Domains nav dropdown.</p>

        <p class="dg-cass-cap">
          Blank label templates - a plain tape in a flat brand color with an
          empty sticker, meant as a canvas. Other components (team cards,
          gallery art) drop content on top of these rather than drawing a tape
          from scratch.
        </p>
        <div class="dg-cass-grid">
          {
            blankTapes.map((t) => (
              <figure class="dg-cass">
                <img src={t.src} alt={`${t.name} blank cassette`} loading="lazy" decoding="async" />
                <figcaption>{t.name}</figcaption>
                <span class="dg-cass-sub">{t.use}</span>
              </figure>
            ))
          }
        </div>

        <p class="dg-cass-cap">
          Team tapes - the board & member cards. Each is a blank template with a
          headshot, name, and role composited on, so every person becomes their
          own tape in the team wall.
        </p>
        <div class="dg-team-grid">
          <div class="dg-team-card">
            <BoardMemberCardSingular
              title=""
              fullName="Member Name"
              position="Chairperson"
              imageUrl=""
            />
          </div>
          <div class="dg-team-card">
            <BoardMemberCardSingular
              title=""
              fullName="Member Name"
              position="ACM-W Lead"
              imageUrl=""
              isW={true}
            />
          </div>
        </div>
        <p class="dg-cass-where">The team page lays a headshot and name over the orange tape (pink for ACM-W), caps it with the black mark, and adds social links. No photo yet? It falls back to this name-only cut.</p>

        <p class="dg-cass-cap">
          About tapes - three purpose-drawn tapes for the "who we are" story:
          the chapter, the university, and the global society. They only appear
          in the About section and its nav dropdown.
        </p>
        <div class="dg-cass-grid">
          {
            aboutTapes.map((t) => (
              <figure class="dg-cass">
                <img src={t.src} alt={`${t.name} cassette`} loading="lazy" decoding="async" />
                <figcaption>{t.name}</figcaption>
                <span class="dg-cass-sub">{t.use}</span>
              </figure>
            ))
          }
        </div>

        <p class="dg-cass-cap">
          Partner tape - a single shared tape used across the Partners section.
          It comes as a filled version and a line-only outline (its empty /
          hover state), retinted to each partner's brand.
        </p>
        <div class="dg-cass-grid">
          <figure class="dg-cass">
            <img src="/cassettes/cassettes-partner-cassette.webp" alt="Partner cassette" loading="lazy" decoding="async" />
            <figcaption>Partner</figcaption>
            <span class="dg-cass-sub">Partners section & partner cards</span>
          </figure>
          <figure class="dg-cass">
            <img src="/cassettes/cassettes-partner-outline.svg" alt="Partner outline cassette" loading="lazy" decoding="async" />
            <figcaption>Partner outline</figcaption>
            <span class="dg-cass-sub">Empty / hover state</span>
          </figure>
        </div>

        <p class="dg-cass-cap">
          Bespoke artwork - the biggest family. Every event, project, and merch
          drop gets its own one-off tape, hand-designed with unique label art.
          These carry the most personality; the rest of the system stays neutral
          so these can shine.
        </p>
        <div class="dg-cass-bespoke">
          <div class="dg-cass-bset">
            <div class="dg-cass-brow">
              {sampleEvents.map((s) => (
                <img src={s} alt="Event cassette" loading="lazy" decoding="async" />
              ))}
            </div>
            <span class="dg-cass-sub">Events - 30+ tapes, one per event. Event pages + Events nav & landing rail.</span>
          </div>
          <div class="dg-cass-bset">
            <div class="dg-cass-brow">
              {sampleProjects.map((s) => (
                <img src={s} alt="Project cassette" loading="lazy" decoding="async" />
              ))}
            </div>
            <span class="dg-cass-sub">Projects - one tape per project. Project pages + Projects nav.</span>
          </div>
          <div class="dg-cass-bset">
            <div class="dg-cass-brow">
              {sampleMerch.map((s) => (
                <img src={s} alt="Merch cassette" loading="lazy" decoding="async" />
              ))}
            </div>
            <span class="dg-cass-sub">Merch - one collectible tape per drop year (2023 →).</span>
          </div>
        </div>

        <p class="dg-cass-cap">
          Drawn & interactive - not images at all. These tapes are built in code
          (CSS + SVG) so they can move, recolor, and respond: reels spin, labels
          swap, and one is fully customizable.
        </p>
        <div class="dg-card-notes">
          <div class="dg-motion-card">
            <p class="dg-motion-title">Cassette Tile</p>
            <p class="dg-motion-body">The CSS-drawn tile in the landing "More" grid and card layouts. Retints from a single <code>accent</code> prop; reels spin on hover.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Cassette Player</p>
            <p class="dg-motion-body">The floating tape deck. A live SVG cassette with spinning reels, cross-tab synced over <code>BroadcastChannel</code>.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Cassette Builder</p>
            <p class="dg-motion-body">The <a href="/cassette-builder">customizer</a> - a fully parametric SVG tape you recolor and label, then export.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Calendar modal</p>
            <p class="dg-motion-body">Opening a calendar event flips it into a hand-drawn SVG cassette with A-SIDE label art keyed to the domain color.</p>
          </div>
        </div>
      </section>

      <!-- ─────────── Typography ─────────── -->
      <section class="dg-section" id="type" data-reveal>
        <header class="dg-head">
          <span class="dg-num">06</span>
          <h2 class="dg-title">Typography</h2>
        </header>
        <p class="dg-lede">
          The site renders in <strong style="color:inherit">PolySans</strong> -
          three cuts of one superfamily. The <em>Standard</em> cut carries every
          heading and control, <em>Mono</em> handles labels and long copy, and
          <em>Wide</em> shows up only for oversized display beats. Cormorant
          Garamond is a rare editorial guest. (The <a href="/design/typography">brand
          guidelines</a> spec DM Sans as the system face - PolySans is the
          website's own on-screen voice.)
        </p>

        {
          typeFamilies.map((f) => (
            <div class="dg-type-specimen">
              <span class="dg-type-tag">{f.tag}</span>
              <p class={`dg-type-sample dg-type-${f.id}`} style={`font-family:"${f.css}", sans-serif`}>{f.sample}</p>
              <p class="dg-type-desc">{f.desc}</p>
              <span class="dg-type-file">{f.files}</span>
            </div>
          ))
        }

        <p class="dg-lede dg-lede-tight">Weight ladder - the Standard cut.</p>
        <div class="dg-weight-grid">
          {
            typeWeights.map((w) => (
              <div class="dg-weight-card">
                <span class="dg-weight-aa" style={`font-weight:${w.w}`}>Aa</span>
                <span class="dg-weight-name">{w.name} · {w.w}</span>
                <span class="dg-weight-use">{w.use}</span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ─────────── Character Map ─────────── -->
      <section class="dg-section" id="charmap" data-reveal>
        <header class="dg-head">
          <span class="dg-num">07</span>
          <h2 class="dg-title">Character Map</h2>
        </header>
        <p class="dg-lede">
          The full Latin set each cut ships with. Switch the family, then hover
          any glyph to inspect it live against the vertical metrics - cap
          height, x-height, baseline, and descender - measured straight from the
          font file.
        </p>

        <div class="dg-charmap">
          <div class="dg-cm-stage">
            <div class="dg-cm-fonts" role="tablist" aria-label="Typeface">
              <button class="dg-cm-font is-on" data-font="PolySans Trial" data-lbl="PolySans Standard" role="tab" aria-selected="true" type="button">Standard</button>
              <button class="dg-cm-font" data-font="PolySans Mono" data-lbl="PolySans Mono" role="tab" aria-selected="false" type="button">Mono</button>
              <button class="dg-cm-font" data-font="PolySans Wide" data-lbl="PolySans Wide" role="tab" aria-selected="false" type="button">Wide</button>
              <button class="dg-cm-font" data-font="Cormorant Garamond" data-lbl="Cormorant" role="tab" aria-selected="false" type="button">Serif</button>
            </div>
            <svg id="dg-cm-svg" role="img" aria-label="Glyph specimen with vertical metrics" preserveAspectRatio="xMidYMid meet"></svg>
            <div class="dg-cm-tag">
              <span id="dg-cm-current">H</span>
              <span class="dg-cm-fam" id="dg-cm-fam">PolySans</span>
            </div>
            <div class="dg-cm-toggle" role="tablist" aria-label="Specimen mode">
              <button class="dg-cm-tog is-on" data-mode="solid" role="tab" aria-selected="true" type="button">Solid</button>
              <button class="dg-cm-tog" data-mode="anchors" role="tab" aria-selected="false" type="button">Outline</button>
            </div>
          </div>
          <div class="dg-cm-grid" id="dg-cm-grid" role="listbox" aria-label="Glyphs">
            {
              glyphs.map((ch) => (
                <button
                  class:list={["dg-cm-cell", ch === "H" && "is-active"]}
                  data-g={ch}
                  type="button"
                  role="option"
                  aria-selected={ch === "H" ? "true" : "false"}
                >
                  {ch}
                </button>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ─────────── Navigation ─────────── -->
      <section class="dg-section" id="nav" data-reveal>
        <header class="dg-head">
          <span class="dg-num">08</span>
          <h2 class="dg-title">Navigation</h2>
        </header>
        <p class="dg-lede">
          The header is a floating liquid-glass pill, not a bar. At rest it is a
          row of labelled dots; hover or open it and the labels breathe out. The
          active section's dot stays lit in orange the whole time. Hover the
          demo below.
        </p>

        <div class="dg-nav-demo">
          <div class="dg-pill" id="dg-pill">
            {["About", "Domains", "Events", "Projects", "Team", "More"].map((l, i) => (
              <span class:list={["dg-nav-item", i === 0 && "is-active"]}>
                <span class="dg-nav-dot"></span>
                <span class="dg-nav-label">{l}</span>
              </span>
            ))}
          </div>
          <span class="dg-nav-hint">hover / tap the pill</span>
        </div>

        <div class="dg-motion-grid" style="margin-top:1.6rem">
          <div class="dg-motion-card">
            <p class="dg-motion-title">Liquid glass</p>
            <p class="dg-motion-body"><code>backdrop-filter: blur(32px) saturate(220%)</code> over a near-black tint, a <code>0.75</code> orange border, and a diagonal lens sheen. Fully rounded at <code>100px</code>.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Dot → label</p>
            <p class="dg-motion-body">Rest = dots only. On hover the <code>gap</code> and label width expand on <code>cubic-bezier(.25,.1,.25,1)</code> over <code>~0.38s</code>. The active dot glows orange; ACM-W hovers pink.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">GSAP + Flip intro</p>
            <p class="dg-motion-body">On load the pill fades in from collapsed and the dots stagger open. Scroll-spy swaps the active dot to the section in view.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Megamenu</p>
            <p class="dg-motion-body">Hovering a section drops a cassette-tile panel. The pill flips to <code>pill-menu-open</code> - same expanded state as hover - so it never snaps shut mid-reach.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Mobile</p>
            <p class="dg-motion-body">Under <code>1024px</code> the top pill hands off to <code>MobileNavbar</code> - a bottom-anchored deck. See the deep dive below.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Theme ripple</p>
            <p class="dg-motion-body">The theme toggle splits the pill and expands a clip-path circle from the button. Backdrop filters drop during the wipe so the split reads clean.</p>
          </div>
        </div>

        <!-- Mobile navbar deep dive -->
        <div class="dg-mn">
          <div class="dg-mn-intro">
            <h3 class="dg-mn-h">The mobile navbar, in full</h3>
            <p class="dg-mn-lede">
              On phones the floating top pill is replaced by a single
              bottom-anchored deck - thumb-reachable, home-indicator aware, and
              always one tap from nav, the menu, or the music. It is not a
              separate menu screen: it is <em>one pill</em> that morphs its
              contents between five panels with a GSAP Flip, so the shape flows
              instead of cutting.
            </p>
          </div>

          <!-- Interactive inert replica of the real MobileNavbar pill -->
          <div class="dg-mnx-stage">
            <div class="dg-mnx-pill" id="dgMnxPill" data-state="nav">
              <!-- nav -->
              <div class="dg-mnx-panel dg-mnx-nav" data-mnx="nav">
                <div class="dg-mnx-left">
                  <span class="dg-mnx-dot"></span>
                  <span class="dg-mnx-label">HOME</span>
                </div>
                <div class="dg-mnx-btns">
                  <button class="dg-mnx-btn" data-mnx-go="menu" aria-label="Open menu" type="button">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="5" r="1.6"/><circle cx="12" cy="5" r="1.6"/><circle cx="19" cy="5" r="1.6"/><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/><circle cx="5" cy="19" r="1.6"/><circle cx="12" cy="19" r="1.6"/><circle cx="19" cy="19" r="1.6"/></svg>
                  </button>
                  <button class="dg-mnx-btn" data-mnx-theme aria-label="Toggle theme" type="button">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/></svg>
                  </button>
                  <button class="dg-mnx-btn-primary" data-mnx-go="music" aria-label="Open music player" type="button">
                    <span class="dg-mnx-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                    <svg class="dg-mnx-note" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                  </button>
                </div>
              </div>

              <!-- menu -->
              <div class="dg-mnx-panel dg-mnx-menu" data-mnx="menu" hidden>
                <div class="dg-mnx-head">
                  <span class="dg-mnx-head-title">Menu</span>
                  <button class="dg-mnx-close" data-mnx-go="nav" aria-label="Close" type="button">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                  </button>
                </div>
                {["About","Domains","Events","Projects","Community","More"].map((l) => (
                  <span class="dg-mnx-link">
                    <span class="dg-mnx-link-dot"></span>
                    <span class="dg-mnx-link-t">{l}</span>
                    <span class="dg-mnx-link-caret">›</span>
                  </span>
                ))}
              </div>

              <!-- music -->
              <div class="dg-mnx-panel dg-mnx-music" data-mnx="music" hidden>
                <div class="dg-mnx-head">
                  <div class="dg-mnx-track">
                    <span class="dg-mnx-track-t">Sleeve Notes</span>
                    <span class="dg-mnx-track-a">ACM-VIT</span>
                  </div>
                  <button class="dg-mnx-close" data-mnx-go="nav" aria-label="Close" type="button">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                  </button>
                </div>
                <div class="dg-mnx-scrub">
                  <span class="dg-mnx-time">1:12</span>
                  <span class="dg-mnx-track-bar"><i style="width:42%"></i></span>
                  <span class="dg-mnx-time">2:56</span>
                </div>
                <div class="dg-mnx-transport">
                  <button class="dg-mnx-tbtn" aria-label="Previous" type="button">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h2v14H6zM20 5v14l-11-7z"/></svg>
                  </button>
                  <button class="dg-mnx-play" data-mnx-play aria-label="Play" type="button">
                    <svg class="dg-mnx-ico-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    <svg class="dg-mnx-ico-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" hidden><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>
                  </button>
                  <button class="dg-mnx-tbtn" aria-label="Next" type="button">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 5h2v14h-2zM4 5l11 7-11 7z"/></svg>
                  </button>
                </div>
              </div>
            </div>
            <span class="dg-mnx-hint">tap the buttons - it morphs, nothing navigates</span>
          </div>

          <p class="dg-mn-subhead-lede">The five panels it morphs through:</p>
          <div class="dg-mn-states">
            <div class="dg-mn-scard">
              <span class="dg-mn-tag">nav · default</span>
              <div class="dg-mn-demo">
                <span class="dg-mn-dot"></span>
                <span class="dg-mn-lbl">HOME</span>
                <span class="dg-mn-spacer"></span>
                <span class="dg-mn-ico">⋯</span>
                <span class="dg-mn-ico">☾</span>
                <span class="dg-mn-ico is-play">♫</span>
              </div>
              <p class="dg-mn-body">A live section dot + label (fed by the same scroll-spy as desktop), then the menu, theme, and music buttons. On subpages the label locks to the page title. When audio plays, the music button swaps its note for an animated EQ bar.</p>
            </div>
            <div class="dg-mn-scard">
              <span class="dg-mn-tag">menu</span>
              <div class="dg-mn-demo dg-mn-demo-col">
                <span class="dg-mn-row"><span class="dg-mn-mini"></span> About <span class="dg-mn-caret">›</span></span>
                <span class="dg-mn-row"><span class="dg-mn-mini"></span> Domains <span class="dg-mn-caret">›</span></span>
                <span class="dg-mn-row"><span class="dg-mn-mini"></span> Events <span class="dg-mn-caret">›</span></span>
              </div>
              <p class="dg-mn-body">The menu button morphs the pill up into a scrollable section list. Any section that has children shows a caret; the rest navigate straight away.</p>
            </div>
            <div class="dg-mn-scard">
              <span class="dg-mn-tag">submenu</span>
              <div class="dg-mn-demo dg-mn-demo-col">
                <span class="dg-mn-subhead"><span class="dg-mn-avatar">D</span> Domains</span>
                <span class="dg-mn-chips"><i>Tech</i><i>CC</i><i>Design</i><i>Research</i></span>
              </div>
              <p class="dg-mn-body">The caret drills into that section's children - mirroring the desktop megamenu's <code>dropdowns</code> from one shared data source. Each child gets a round avatar: a brand icon, a domain-colored fill, or a letter glyph.</p>
            </div>
            <div class="dg-mn-scard">
              <span class="dg-mn-tag">music</span>
              <div class="dg-mn-demo dg-mn-demo-col">
                <span class="dg-mn-track">Side A - ACM-VIT</span>
                <span class="dg-mn-prog"><i style="width:42%"></i></span>
                <span class="dg-mn-transport">⏮ <b>⏸</b> ⏭</span>
              </div>
              <p class="dg-mn-body">The music button opens a full transport: track title, a scrubbable progress bar, and prev/play/next. It drives the shared <code>CassettePlayer</code> through <code>window.acmCassette</code> and stays in sync across tabs - never touching the raw audio node.</p>
            </div>
            <div class="dg-mn-scard">
              <span class="dg-mn-tag">blog / merch</span>
              <div class="dg-mn-demo">
                <span class="dg-mn-lbl">TOOLS</span>
                <span class="dg-mn-spacer"></span>
                <span class="dg-mn-ico">▤</span>
                <span class="dg-mn-ico">▦</span>
                <span class="dg-mn-ico">✕</span>
              </div>
              <p class="dg-mn-body">Contextual panels. On article and merch pages the floating dock's tools surface here as extra buttons instead of a second bar - the dock proxies into this one deck.</p>
            </div>
          </div>

          <div class="dg-mn-notes">
            <div class="dg-mn-note">
              <p class="dg-mn-nt">One pill, Flip morph</p>
              <p class="dg-mn-nb">Every state swap runs <code>Flip.getState → swap panel → Flip.from</code> with a content crossfade. The container animates its own width/height, so nav → menu → music feels like one object breathing, not four screens.</p>
            </div>
            <div class="dg-mn-note">
              <p class="dg-mn-nt">Solid, not glass</p>
              <p class="dg-mn-nb">Unlike the desktop pill it is a solid <code>#1e1e1e</code> fill. Backdrop-blur over scrolling content is expensive and jittery on mobile GPUs, so the deck stays opaque and cheap.</p>
            </div>
            <div class="dg-mn-note">
              <p class="dg-mn-nt">Safe-area & reach</p>
              <p class="dg-mn-nb">Pinned to <code>bottom: calc(16px + env(safe-area-inset-bottom))</code> so it clears the iPhone home indicator and lands in the thumb zone. The root is <code>pointer-events:none</code>; only the pill catches taps.</p>
            </div>
            <div class="dg-mn-note">
              <p class="dg-mn-nt">Intro grow</p>
              <p class="dg-mn-nb">On load it starts collapsed to the bare music circle, then Flip-expands into the full nav bar - the same tape-deck-powering-on beat as the rest of the site.</p>
            </div>
            <div class="dg-mn-note">
              <p class="dg-mn-nt">Deterministic smooth scroll</p>
              <p class="dg-mn-nb">Same-page links animate <code>scrollTop</code> by hand over rAF. Mobile Safari fakes smooth <code>scrollIntoView</code> into an instant jump, so we drive the scroller (body or documentElement, detected live) ourselves.</p>
            </div>
            <div class="dg-mn-note">
              <p class="dg-mn-nt">Dock proxy</p>
              <p class="dg-mn-nb">Page-level floating docks (blog, merch) don't get their own mobile bar - they surface as extra buttons here and proxy their clicks, so there's only ever one control surface at the bottom.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ─────────── Buttons & CTAs ─────────── -->
      <section class="dg-section" id="buttons" data-reveal>
        <header class="dg-head">
          <span class="dg-num">09</span>
          <h2 class="dg-title">Buttons &amp; CTAs</h2>
        </header>
        <p class="dg-lede">
          Two button primitives cover the whole site. Both are snappy, never
          bouncy - <code>power3.out</code> in, no overshoot.
        </p>

        <div class="dg-component-block dg-component-block-dark">
          <span class="dg-component-label">Animated Button - primary / hero CTA</span>
          <div class="dg-component-stage dg-stage-center dg-inert">
            <AnimatedButton text="Partner With Us" href="/#contact" />
          </div>
          <p class="dg-component-note dg-note-inline">
            The MacBook-Pro pill: a dark capsule with an accent circle that expands
            rightward to reveal its label on hover. Our default call to action.
          </p>
        </div>

        <div class="dg-component-block">
          <span class="dg-component-label">Fill Button - secondary / inline action</span>
          <div class="dg-component-stage dg-stage-center dg-inert">
            <FillButton label="Explore Projects" href="/projects" class="dg-demo-fill" />
          </div>
          <p class="dg-component-note dg-note-inline">
            An outlined pill whose accent fill wipes in from the bottom on hover.
            Driven by <code>--proj-color</code> so any surface can retint it.
          </p>
        </div>
      </section>

      <!-- ─────────── Cards, Tiles & Cassettes ─────────── -->
      <section class="dg-section" id="cards" data-reveal>
        <header class="dg-head">
          <span class="dg-num">10</span>
          <h2 class="dg-title">Cards &amp; Components</h2>
        </header>
        <p class="dg-lede">
          Beyond the tape itself, a small kit of shared parts carries the rest of
          the site. The Cassette Tile is the workhorse - a live demo below.
        </p>

        <div class="dg-component-block">
          <span class="dg-component-label">Cassette Tile - landing "More" grid, event & project cards</span>
          <div class="dg-component-stage dg-component-stage-tile">
            <CassetteTile
              title="Example Tile"
              desc="Corner screws, cream sticker, spinning reels on hover"
              href="/#more"
              accent="#F95F4A"
              tag="DEMO"
            >
              <Fragment slot="icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="8" cy="12" r="2"/><circle cx="16" cy="12" r="2"/><path d="M10 12h4"/></svg>`} />
            </CassetteTile>
          </div>
          <p class="dg-component-note dg-note-inline">
            Pass an <code>accent</code> and the sticker, tag, and reel glow all
            retint. The tag reads like a tape side - "SIDE A", a domain, a status.
          </p>
        </div>

        <div class="dg-component-block dg-component-block-dark">
          <span class="dg-component-label">Cassette Player - the floating music deck</span>
          <div class="dg-component-stage dg-cp-stage">
            <div class="dg-cp">
              <svg viewBox="0 0 280 175" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Cassette music player">
                <rect class="dg-cp-body" x="1" y="1" width="278" height="173" rx="11"/>
                <path class="dg-cp-cover" d="M 18 10 L 22 10 L 28 16 L 252 16 L 258 10 L 262 10 Q 266 10 266 14 L 266 120 L 14 120 L 14 14 Q 14 10 18 10 Z"/>
                <line class="dg-cp-line" x1="20" y1="22" x2="260" y2="22"/>
                <line class="dg-cp-line" x1="20" y1="114" x2="260" y2="114"/>
                <!-- left reel -->
                <circle class="dg-cp-outer" cx="92" cy="58" r="24"/>
                <circle class="dg-cp-mid" cx="92" cy="58" r="16"/>
                <g class="dg-cp-reel">
                  {[0,60,120,180,240,300].map((r) => (
                    <line class="dg-cp-spoke" x1="92" y1="40" x2="92" y2="34" transform={`rotate(${r},92,58)`}/>
                  ))}
                </g>
                <circle class="dg-cp-hub" cx="92" cy="58" r="5.5"/>
                <circle class="dg-cp-tape" cx="92" cy="58" r="19"/>
                <!-- right reel -->
                <circle class="dg-cp-outer" cx="188" cy="58" r="24"/>
                <circle class="dg-cp-mid" cx="188" cy="58" r="16"/>
                <g class="dg-cp-reel">
                  {[0,60,120,180,240,300].map((r) => (
                    <line class="dg-cp-spoke" x1="188" y1="40" x2="188" y2="34" transform={`rotate(${r},188,58)`}/>
                  ))}
                </g>
                <circle class="dg-cp-hub-accent" cx="188" cy="58" r="5.5"/>
                <circle class="dg-cp-tape" cx="188" cy="58" r="10"/>
                <path class="dg-cp-path" d="M 68 58 A 24 24 0 0 0 92 82 L 188 82 A 24 24 0 0 0 212 58"/>
                <rect class="dg-cp-window" x="118" y="69" width="44" height="16" rx="3"/>
                <circle class="dg-cp-post" cx="140" cy="58" r="2.5"/>
                <!-- label -->
                <rect class="dg-cp-label" x="40" y="92" width="200" height="22" rx="4"/>
                <text class="dg-cp-title" x="140" y="100" text-anchor="middle" dominant-baseline="middle">Sleeve Notes</text>
                <text class="dg-cp-artist" x="140" y="110" text-anchor="middle" dominant-baseline="middle">ACM-VIT</text>
                <!-- controls -->
                <g class="dg-cp-btn" transform="translate(75,135)">
                  <rect x="-14" y="-10" width="28" height="20" rx="4" class="dg-cp-btn-bg"/>
                  <path d="M-2 0l6 4V-4zM-5-4v8" class="dg-cp-btn-ico"/>
                </g>
                <g transform="translate(140,135)">
                  <circle r="14" class="dg-cp-play-bg"/>
                  <path d="M-3-5v10l8-5z" fill="#fff"/>
                </g>
                <g class="dg-cp-btn" transform="translate(205,135)">
                  <rect x="-14" y="-10" width="28" height="20" rx="4" class="dg-cp-btn-bg"/>
                  <path d="M-4-4v8l6-4zM5-4v8" class="dg-cp-btn-ico"/>
                </g>
                <!-- progress -->
                <rect class="dg-cp-prog-bg" x="40" y="155" width="200" height="3" rx="1.5"/>
                <rect class="dg-cp-prog-fill" x="40" y="155" width="82" height="3" rx="1.5"/>
                <text class="dg-cp-time" x="40" y="165" dominant-baseline="hanging">1:12</text>
                <text class="dg-cp-time" x="240" y="165" text-anchor="end" dominant-baseline="hanging">2:56</text>
                <circle class="dg-cp-pin" cx="50" cy="135" r="1.5"/>
                <circle class="dg-cp-pin" cx="230" cy="135" r="1.5"/>
                <circle class="dg-cp-screw" cx="8" cy="8" r="2.5"/>
                <circle class="dg-cp-screw" cx="272" cy="8" r="2.5"/>
                <circle class="dg-cp-screw" cx="8" cy="167" r="2.5"/>
                <circle class="dg-cp-screw" cx="272" cy="167" r="2.5"/>
              </svg>
            </div>
          </div>
          <p class="dg-component-note dg-note-inline">
            The whole player <em>is</em> a cassette - track title on the label, transport
            and progress printed on the body, reels that spin while a track plays. It docks
            as a small note button, expands on tap, and stays in sync across tabs over
            <code>BroadcastChannel</code>. Drive it through <code>window.acmCassette</code>,
            never the raw <code>#cp-audio</code> node.
          </p>
        </div>

        <div class="dg-component-block">
          <span class="dg-component-label">Contributor pills - project page credits</span>
          <div class="dg-component-stage dg-people-stage">
            <div class="dg-people">
              <a class="dg-person" href="https://github.com/acm-vit" target="_blank" rel="noopener">
                <span class="dg-person-av"><img src="https://github.com/acm-vit.png?size=120" alt="" loading="lazy" decoding="async" /></span>
                <span class="dg-person-info">
                  <span class="dg-person-name">@acm-vit</span>
                  <span class="dg-person-role">Lead Developer</span>
                </span>
                <svg class="dg-person-arr" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
              </a>
              <a class="dg-person" href="#" target="_blank" rel="noopener">
                <span class="dg-person-av dg-person-av--initial">B</span>
                <span class="dg-person-info">
                  <span class="dg-person-name">Bahubali</span>
                  <span class="dg-person-role">Designer</span>
                </span>
                <svg class="dg-person-arr" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
              </a>
              <span class="dg-mini-person">
                <span class="dg-mini-av dg-mini-av--initial">R</span>
                @riya
              </span>
            </div>
          </div>
          <p class="dg-component-note dg-note-inline">
            Credit rows on project pages. Developer pills pull the avatar and display name
            live from <code>github.com/&lt;user&gt;.png</code> + the GitHub API; designers fall
            back to a colored initial chip. Both retint to the project accent on hover. The
            small variant lists version contributors inline.
          </p>
        </div>

        <div class="dg-card-notes">
          <div class="dg-motion-card">
            <p class="dg-motion-title">Breadcrumbs</p>
            <p class="dg-motion-body">Subpages open with a small crumb trail keyed to the page accent. On bleed-background pages it floats out of flow via the <code>bleedBg</code> Layout flag.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Accordion</p>
            <p class="dg-motion-body">Lives on <a href="/faqs">FAQs</a> - same card language, a <code>grid-rows</code> collapse and a play triangle that rotates to a pause on open.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Scroll cue</p>
            <p class="dg-motion-body">A quiet "SCROLL" marker at hero feet and a tape-click hint ("PLAY") on interactive cassettes. Both fade out once the user moves.</p>
          </div>
        </div>
      </section>

      <!-- ─────────── Calendar ─────────── -->
      <section class="dg-section" id="calendar" data-reveal>
        <header class="dg-head">
          <span class="dg-num">11</span>
          <h2 class="dg-title">Calendar</h2>
        </header>
        <p class="dg-lede">
          The <a href="/calendar">calendar</a> ships in two views behind a pill
          switcher. Events are colored by domain, and opening one flips it into a
          full cassette - the tape <em>is</em> the event card.
        </p>

        <div class="dg-cal-views">
          <div class="dg-cal-view">
            <div class="dg-cal-switch">
              <span class="dg-cal-sw is-on">Agenda</span>
              <span class="dg-cal-sw">Traditional</span>
            </div>
            <p class="dg-motion-title" style="margin-top:1rem">Agenda (default)</p>
            <p class="dg-motion-body">A sidebar with a mini-month, domain filters, and an upcoming queue, next to a scrolling day-by-day timeline. The reading view - "what's next".</p>
          </div>
          <div class="dg-cal-view">
            <div class="dg-cal-switch">
              <span class="dg-cal-sw">Agenda</span>
              <span class="dg-cal-sw is-on">Traditional</span>
            </div>
            <p class="dg-motion-title" style="margin-top:1rem">Traditional</p>
            <p class="dg-motion-body">A full month / week grid with a tape-deck toolbar, Today jump, and up to three event pills per day. The planning view - "the whole month".</p>
          </div>
        </div>

        <p class="dg-lede dg-lede-tight">Domain legend - each filter is a real cassette.</p>
        <div class="dg-cal-legend">
          {
            calDomains.map((d) => (
              <span class="dg-cal-pill" style={`border-color:${d.color}`}>
                <img src={d.cassette} alt="" loading="lazy" decoding="async" />
                <span style={`color:${d.color}`}>{d.label}</span>
              </span>
            ))
          }
        </div>
        <p class="dg-component-note" style="margin-top:1.4rem">
          Click a pill to filter; click an event to open its cassette modal - a
          drawn tape with A-SIDE label art, the domain dot, date/time/location,
          and a "Read Blog" link when the event maps to a post. Blog dates merge
          in live from <code>/api/blog-dates</code>.
        </p>
      </section>

      <!-- ─────────── Motion ─────────── -->
      <section class="dg-section" id="motion" data-reveal>
        <header class="dg-head">
          <span class="dg-num">12</span>
          <h2 class="dg-title">Motion</h2>
        </header>
        <div class="dg-motion-grid">
          <div class="dg-motion-card">
            <p class="dg-motion-title">Easing</p>
            <p class="dg-motion-body"><code>power3.out</code> for reveals, <code>cubic-bezier(0.25, 0.1, 0.25, 1)</code> for hovers. Nothing bounces unless it's a bulb cord.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Buttons</p>
            <p class="dg-motion-body">Snappy expand, not a slow reveal - a dark pill with an accent circle, expanding to show its label on hover.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Scroll reveals</p>
            <p class="dg-motion-body">Opacity + <code>y: 24–30px</code>, staggered lightly. Always guarded by <code>prefers-reduced-motion</code>.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Smooth scroll</p>
            <p class="dg-motion-body">The window scrolls natively; GSAP ScrollTrigger reads off it. No inner scroller - so <code>position: sticky</code> works everywhere.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Reels</p>
            <p class="dg-motion-body">Cassette reels spin while audio plays. Safari won't retime a running CSS animation, so we restart it via <code>animation-name: none</code> + reflow.</p>
          </div>
          <div class="dg-motion-card">
            <p class="dg-motion-title">Restraint</p>
            <p class="dg-motion-body">Motion earns its place or it's cut. One hero flourish per page, quiet hovers everywhere else. Never animate for the sake of it.</p>
          </div>
        </div>
      </section>

      <!-- ─────────── Voice & Tone ─────────── -->
      <section class="dg-section" id="voice" data-reveal>
        <header class="dg-head">
          <span class="dg-num">13</span>
          <h2 class="dg-title">Voice &amp; Tone</h2>
        </header>
        <p class="dg-lede">Write like a person who's actually building this stuff, not marketing it.</p>

        <div class="dg-rules dg-rules-voice">
          <div class="dg-rule-col">
            <p class="dg-rule-label dg-rule-good">Do</p>
            <ul>{doList.map((d) => <li>{d}</li>)}</ul>
          </div>
          <div class="dg-rule-col">
            <p class="dg-rule-label dg-rule-bad">Don't</p>
            <ul>{dontList.map((d) => <li>{d}</li>)}</ul>
          </div>
        </div>
      </section>

      <!-- ─────────── Assets ─────────── -->
      <div class="dg-cta" data-reveal>
        <h3 class="dg-cta-title">Need the files?</h3>
        <p class="dg-cta-body">Grab the real assets - build your own cassette, browse the merch line, or just reach out if something here doesn't cover it.</p>
        <div class="dg-cta-actions">
          <FillButton label="Cassette Builder" href="/cassette-builder" class="dg-cta-btn" />
          <FillButton label="Get in touch" href="/#contact" class="dg-cta-btn dg-cta-btn-alt" />
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600&display=swap");
</style>

<style>
  .dg-page {
    min-height: 100vh;
    /* Bleed the grid/glow up behind the fixed header so there's no seam at the
       .content clearance (pt-28 = 7rem). margin/padding cancel, so inner
       content keeps its exact position. */
    margin-top: -7rem;
    padding-top: 7rem;
  }

  .dg-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(45% 30% at 20% 8%, rgba(249, 95, 74, 0.16), transparent 70%),
      radial-gradient(40% 35% at 85% 40%, rgba(0, 180, 216, 0.08), transparent 70%);
  }
  .dg-grid-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .dg-v {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: repeating-linear-gradient(to bottom, rgba(153, 153, 153, 0.3) 0 3px, transparent 3px 18px);
  }
  :global(html[data-theme="light"]) .dg-v {
    background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.18) 0 3px, transparent 3px 18px);
  }

  /* Content column gets dashed side rails; each section a dashed top - together
     they form a stacked grid of boxes. Site-wide dashed #999 style, darkened. */
  .dg-inner {
    border-left: 1.5px dashed rgba(153, 153, 153, 0.32);
    border-right: 1.5px dashed rgba(153, 153, 153, 0.32);
  }
  :global(html[data-theme="light"]) .dg-inner {
    border-left-color: rgba(0, 0, 0, 0.2);
    border-right-color: rgba(0, 0, 0, 0.2);
  }

  /* ── Section scaffold ── */
  .dg-section {
    position: relative;
    margin-bottom: 0;
    padding-block: clamp(3.25rem, 6vw, 5.5rem);
  }
  /* full-bleed dashed top divider that reaches the column's side rails */
  .dg-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: -1.25rem;
    right: -1.25rem;
    border-top: 1.5px dashed rgba(153, 153, 153, 0.32);
  }
  @media (min-width: 640px) {
    .dg-section::before {
      left: -2rem;
      right: -2rem;
    }
  }
  :global(html[data-theme="light"]) .dg-section::before {
    border-top-color: rgba(0, 0, 0, 0.2);
  }
  .dg-section:first-of-type {
    padding-top: 1rem;
  }
  .dg-section:first-of-type::before {
    display: none;
  }
  .dg-head {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 1.4rem;
    padding-bottom: 0.9rem;
  }
  /* dashed underline, full-bleed to the column side rails (matches section tops) */
  .dg-head::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: -1.25rem;
    right: -1.25rem;
    border-bottom: 1.5px dashed rgba(153, 153, 153, 0.32);
  }
  @media (min-width: 640px) {
    .dg-head::after {
      left: -2rem;
      right: -2rem;
    }
  }
  :global(html[data-theme="light"]) .dg-head::after {
    border-bottom-color: rgba(0, 0, 0, 0.2);
  }
  .dg-num {
    font-family: "PolySans Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #f95f4a;
  }
  .dg-title {
    margin: 0;
    font-family: "PolySans Trial", sans-serif;
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: #fefcd9;
  }
  .dg-lede {
    margin: 0 0 1.6rem;
    max-width: 68ch;
    font-family: "PolySans Mono", monospace;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(254, 252, 217, 0.7);
  }
  .dg-lede-tight {
    margin-top: 2.2rem;
    margin-bottom: 1rem;
  }
  :global(html[data-theme="light"]) .dg-head {
    border-bottom-color: rgba(26, 26, 26, 0.12);
  }
  :global(html[data-theme="light"]) .dg-title {
    color: #1a1a1a;
  }
  :global(html[data-theme="light"]) .dg-lede {
    color: rgba(26, 26, 26, 0.65);
  }

  /* ── Link to the full design system ── */
  .dg-system-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 4rem;
    padding: 1.1rem 1.4rem;
    border-radius: 16px;
    border: 1px solid rgba(254, 252, 217, 0.16);
    background: rgba(254, 252, 217, 0.05);
    text-decoration: none;
    color: rgba(254, 252, 217, 0.82);
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .dg-system-link:hover {
    border-color: rgba(249, 95, 74, 0.55);
    background: rgba(249, 95, 74, 0.08);
  }
  .dg-system-link-text {
    font-size: 0.92rem;
    line-height: 1.5;
    max-width: 46ch;
  }
  .dg-system-link-text strong {
    display: block;
    color: #fefcd9;
    font-weight: 620;
  }
  .dg-system-link-cta {
    font-weight: 640;
    font-size: 0.9rem;
    color: #f95f4a;
    white-space: nowrap;
  }
  :global(html[data-theme="light"]) .dg-system-link {
    border-color: rgba(26, 26, 26, 0.14);
    background: rgba(26, 26, 26, 0.04);
    color: rgba(26, 26, 26, 0.75);
  }
  :global(html[data-theme="light"]) .dg-system-link-text strong {
    color: #1a1a1a;
  }

  /* ── Brand marks ── */
  .dg-marks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .dg-mark-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem 1rem 1.2rem;
    border-radius: 16px;
    border: 1px solid rgba(254, 252, 217, 0.1);
  }
  .dg-mark-dark {
    background: #0a0a0a;
  }
  .dg-mark-light {
    background: #f2ede2;
  }
  .dg-mark-card img {
    height: 56px;
    width: auto;
    object-fit: contain;
  }
  .dg-mark-label {
    font-family: "PolySans Mono", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(254, 252, 217, 0.5);
    text-align: center;
  }
  .dg-mark-light .dg-mark-label {
    color: rgba(26, 26, 26, 0.55);
  }

  /* ── Do / Don't rules ── */
  .dg-rules {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .dg-rule-col ul {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .dg-rule-col li {
    font-family: "PolySans Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.55;
    color: rgba(254, 252, 217, 0.7);
    padding-left: 1.1rem;
    position: relative;
  }
  .dg-rule-col li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .dg-rule-good li::before {
    background: #42cd9d;
  }
  .dg-rule-bad li::before {
    background: #f95f4a;
  }
  .dg-rule-label {
    margin: 0;
    font-family: "PolySans Trial", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .dg-rule-good {
    color: #42cd9d;
  }
  .dg-rule-bad {
    color: #f95f4a;
  }
  :global(html[data-theme="light"]) .dg-rule-col li {
    color: rgba(26, 26, 26, 0.68);
  }

  /* ── Color swatches ── */
  .dg-swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
  }
  .dg-swatch-grid-base {
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  .dg-swatch {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem;
    border-radius: 12px;
    border: 1px solid rgba(254, 252, 217, 0.1);
    background: rgba(254, 252, 217, 0.02);
    cursor: pointer;
    text-align: left;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .dg-swatch:hover {
    border-color: color-mix(in srgb, var(--sw) 55%, transparent);
    transform: translateY(-2px);
  }
  .dg-swatch-chip {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--sw);
    border: 1px solid rgba(254, 252, 217, 0.18);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--sw) 35%, transparent);
  }
  .dg-swatch-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .dg-swatch-name {
    font-family: "PolySans Trial", sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fefcd9;
  }
  .dg-swatch-hex {
    font-family: "PolySans Mono", monospace;
    font-size: 0.68rem;
    color: color-mix(in srgb, var(--sw) 65%, #808080 35%);
  }
  .dg-swatch-note {
    font-family: "PolySans Mono", monospace;
    font-size: 0.62rem;
    color: rgba(254, 252, 217, 0.45);
    line-height: 1.4;
  }
  .dg-swatch.is-copied .dg-swatch-hex::after {
    content: " · copied";
    color: #42cd9d;
  }
  :global(html[data-theme="light"]) .dg-swatch {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(26, 26, 26, 0.1);
  }
  :global(html[data-theme="light"]) .dg-swatch-name {
    color: #1a1a1a;
  }
  :global(html[data-theme="light"]) .dg-swatch-note {
    color: rgba(26, 26, 26, 0.5);
  }

  /* ── Typography specimens ── */
  .dg-type-specimen {
    padding: 1.6rem 0;
    border-bottom: 1px solid rgba(254, 252, 217, 0.08);
  }
  .dg-type-specimen:last-child {
    border-bottom: none;
  }
  .dg-type-tag {
    display: block;
    font-family: "PolySans Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #f95f4a;
    margin-bottom: 0.6rem;
  }
  .dg-type-sample {
    margin: 0;
    color: #fefcd9;
  }
  .dg-type-trial {
    font-family: "PolySans Trial", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    letter-spacing: -0.02em;
  }
  .dg-type-mono {
    font-family: "PolySans Mono", monospace;
    font-size: clamp(1rem, 2vw, 1.2rem);
  }
  .dg-type-serif {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 500;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .dg-type-desc {
    margin: 0.7rem 0 0;
    font-family: "PolySans Mono", monospace;
    font-size: 0.76rem;
    line-height: 1.6;
    color: rgba(254, 252, 217, 0.55);
  }
  :global(html[data-theme="light"]) .dg-type-specimen {
    border-bottom-color: rgba(26, 26, 26, 0.08);
  }
  :global(html[data-theme="light"]) .dg-type-sample {
    color: #1a1a1a;
  }
  :global(html[data-theme="light"]) .dg-type-desc {
    color: rgba(26, 26, 26, 0.55);
  }

  /* ── Components ── */
  .dg-component-block {
    padding: 1.6rem;
    border-radius: 16px;
    border: 1px solid rgba(254, 252, 217, 0.1);
    margin-bottom: 1rem;
  }
  .dg-component-block-dark {
    background: #0a0a0a;
  }
  .dg-component-label {
    display: block;
    margin-bottom: 1.1rem;
    font-family: "PolySans Mono", monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(254, 252, 217, 0.5);
  }
  .dg-component-stage {
    display: flex;
    justify-content: flex-start;
  }
  .dg-stage-center {
    justify-content: center;
  }
  /* give the demo FillButton a real accent so it reads as a solid orange pill
     and the hover fill stays legible (unset, it dissolves into the dark page) */
  .dg-component-stage :global(.dg-demo-fill) {
    --proj-color: #f95f4a;
    --proj-color-secondary: #0d0e0d;
    --fill-bg: #0d0e0d;
  }
  .dg-component-stage-tile {
    max-width: 320px;
    margin-inline: auto;
  }
  .dg-component-note {
    margin: 1rem 0 0;
    font-family: "PolySans Mono", monospace;
    font-size: 0.86rem;
    color: rgba(254, 252, 217, 0.6);
  }
  .dg-component-note a {
    color: #00b4d8;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(html[data-theme="light"]) .dg-component-block:not(.dg-component-block-dark) {
    background: rgba(255, 255, 255, 0.35);
  }
  :global(html[data-theme="light"]) .dg-component-note {
    color: rgba(26, 26, 26, 0.6);
  }

  /* ── Motion ── */
  .dg-motion-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  /* cap all equal-card grids at 3 per row, drop to 2 then 1 on smaller screens */
  .dg-motion-grid,
  .dg-card-notes,
  .dg-mn-notes,
  .dg-mn-states {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 820px) {
    .dg-motion-grid,
    .dg-card-notes,
    .dg-mn-notes,
    .dg-mn-states {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .dg-motion-grid,
    .dg-card-notes,
    .dg-mn-notes,
    .dg-mn-states {
      grid-template-columns: 1fr;
    }
  }
  .dg-motion-card {
    padding: 1.4rem;
    border-radius: 14px;
    border: 1px solid rgba(254, 252, 217, 0.1);
    background: rgba(254, 252, 217, 0.02);
  }
  .dg-motion-title {
    margin: 0 0 0.5rem;
    font-family: "PolySans Trial", sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    color: #fefcd9;
  }
  .dg-motion-body {
    margin: 0;
    font-family: "PolySans Mono", monospace;
    font-size: 0.84rem;
    line-height: 1.6;
    color: rgba(254, 252, 217, 0.6);
  }
  .dg-motion-body code {
    color: #00b4d8;
    font-size: 0.72rem;
  }
  :global(html[data-theme="light"]) .dg-motion-card {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(26, 26, 26, 0.1);
  }
  :global(html[data-theme="light"]) .dg-motion-title {
    color: #1a1a1a;
  }
  :global(html[data-theme="light"]) .dg-motion-body {
    color: rgba(26, 26, 26, 0.6);
  }

  /* ── Inspiration & Homage ── */
  #homage .dg-lede {
    max-width: none;
  }
  .dg-homage-lead {
    margin: 0 0 1.6rem;
    max-width: none;
    font-family: "PolySans Trial", sans-serif;
    font-weight: 700;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: #fefcd9;
  }
  .dg-homage-close {
    margin-top: 0.4rem;
  }
  :global(html[data-theme="light"]) .dg-homage-lead {
    color: #1a1a1a;
  }

  /* CTA: jump to the cassette-journey page. */
  .dg-homage-cta {
    margin-top: 2.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.6rem;
    border: 1px solid rgba(249, 95, 74, 0.55);
    border-radius: 999px;
    background: rgba(249, 95, 74, 0.06);
    color: #fefcd9;
    font-family: "PolySans Trial", sans-serif;
    font-weight: 600;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .dg-homage-cta:hover {
    background: rgba(249, 95, 74, 0.14);
    border-color: rgba(249, 95, 74, 0.9);
    transform: translateY(-2px);
  }
  .dg-homage-cta-tape {
    width: 26px;
    height: 26px;
    color: #f95f4a;
    flex: none;
  }
  .dg-homage-cta-arrow {
    width: 20px;
    height: 20px;
    flex: none;
    transition: transform 0.25s ease;
  }
  .dg-homage-cta:hover .dg-homage-cta-arrow {
    transform: translateX(4px);
  }
  :global(html[data-theme="light"]) .dg-homage-cta {
    color: #1a1a1a;
  }

  /* ── Bottom CTA ── */
  .dg-cta {
    margin-top: 5rem;
    padding: 2.5rem 2rem;
    border-radius: 20px;
    text-align: center;
    background: radial-gradient(80% 100% at 50% 0%, rgba(249, 95, 74, 0.12), transparent 70%);
    border: 1px solid rgba(254, 252, 217, 0.1);
  }
  .dg-cta-title {
    margin: 0;
    font-family: "PolySans Trial", sans-serif;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    color: #fefcd9;
  }
  .dg-cta-body {
    margin: 0.6rem auto 0;
    max-width: 42ch;
    font-family: "PolySans Mono", monospace;
    font-size: 0.8rem;
    line-height: 1.6;
    color: rgba(254, 252, 217, 0.65);
  }
  .dg-cta-actions {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .dg-cta :global(.dg-cta-btn) {
    --proj-color: #f95f4a;
    --proj-color-secondary: #0d0e0d;
  }
  .dg-cta :global(.dg-cta-btn-alt) {
    --proj-color: #fefcd9;
    --proj-color-secondary: #1c1917;
  }
  :global(html[data-theme="light"]) .dg-cta {
    border-color: rgba(26, 26, 26, 0.1);
    background: radial-gradient(80% 100% at 50% 0%, rgba(249, 95, 74, 0.1), transparent 70%);
  }
  :global(html[data-theme="light"]) .dg-cta-title {
    color: #1a1a1a;
  }
  :global(html[data-theme="light"]) .dg-cta-body {
    color: rgba(26, 26, 26, 0.65);
  }

  /* ── Domain accent mapping (compact, no duplicate swatch cards) ── */
  .dg-domain-map {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .dg-domain-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.85rem;
    border-radius: 100px;
    border: 1px solid rgba(254, 252, 217, 0.12);
    background: rgba(254, 252, 217, 0.02);
    cursor: pointer;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .dg-domain-chip:hover {
    border-color: color-mix(in srgb, var(--sw) 60%, transparent);
    transform: translateY(-1px);
  }
  .dg-domain-dot {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    background: var(--sw);
    flex: none;
    box-shadow: 0 0 10px color-mix(in srgb, var(--sw) 45%, transparent);
  }
  .dg-domain-name {
    font-family: "PolySans Trial", sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    color: #fefcd9;
  }
  .dg-domain-hex {
    font-family: "PolySans Mono", monospace;
    font-size: 0.64rem;
    color: color-mix(in srgb, var(--sw) 70%, #808080 30%);
  }
  .dg-domain-chip.is-copied .dg-domain-hex::after {
    content: " · copied";
    color: #42cd9d;
  }
  :global(html[data-theme="light"]) .dg-domain-chip {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(26, 26, 26, 0.1);
  }
  :global(html[data-theme="light"]) .dg-domain-name {
    color: #1a1a1a;
  }

  /* ── Side progress rail (full-height scroll timeline, right edge) ── */
  .dg-rail {
    position: fixed;
    left: 22px;
    /* start below the fixed header + breadcrumbs so the top tick hits nothing */
    top: 132px;
    height: calc(100vh - 160px);
    height: calc(100dvh - 160px);
    z-index: 40;
    display: flex;
    align-items: center;
    padding: 8px 0;
  }
  /* faint vertical track behind the ticks (left edge of the rail) */
  .dg-rail-line {
    position: absolute;
    left: 3px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: rgba(254, 252, 217, 0.14);
    overflow: hidden;
  }
  .dg-rail-prog {
    position: absolute;
    inset: 0 0 auto 0;
    height: 0%;
    width: 100%;
    background: #f95f4a;
    transition: height 0.35s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .dg-rail-list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 2px;
  }
  .dg-rail-item {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    padding: 4px 12px 4px 10px;
    text-decoration: none;
    border-radius: 100px;
  }
  /* label - dim by default, hidden-ish until hover/active */
  .dg-rail-label {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    white-space: nowrap;
    font-family: "PolySans Trial", sans-serif;
    font-size: 0.74rem;
    font-weight: 500;
    color: rgba(254, 252, 217, 0.5);
    /* collapsed at rest so the rail is ticks-only and never overlaps content */
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateX(-6px);
    transition: max-width 0.28s cubic-bezier(0.25, 0.1, 0.25, 1), opacity 0.25s ease, transform 0.25s ease, color 0.25s ease;
  }
  .dg-rail-num {
    font-family: "PolySans Mono", monospace;
    font-size: 0.58rem;
    color: rgba(254, 252, 217, 0.35);
  }
  /* small tick dot sitting on the track */
  .dg-rail-tick {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex: none;
    background: rgba(254, 252, 217, 0.28);
    transition: background 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  /* reveal all labels when hovering the rail */
  .dg-rail:hover .dg-rail-label {
    max-width: 160px;
    opacity: 1;
    transform: none;
  }
  .dg-rail-item:hover .dg-rail-label {
    color: rgba(254, 252, 217, 0.85);
  }
  .dg-rail-item:hover .dg-rail-tick {
    background: rgba(254, 252, 217, 0.7);
    transform: scale(1.2);
  }
  /* passed */
  .dg-rail-item.is-done .dg-rail-tick {
    background: rgba(249, 95, 74, 0.55);
  }
  /* active - always pops a small tab: glowing tick + label in a pill */
  .dg-rail-item.is-active {
    background: rgba(13, 14, 13, 0.82);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
  }
  .dg-rail-item.is-active .dg-rail-label {
    max-width: 160px;
    opacity: 1;
    transform: none;
    color: #fefcd9;
  }
  .dg-rail-item.is-active .dg-rail-num {
    color: #f95f4a;
  }
  .dg-rail-item.is-active .dg-rail-tick {
    background: #f95f4a;
    transform: scale(1.25);
    box-shadow: 0 0 8px rgba(249, 95, 74, 0.8);
  }
  :global(html[data-theme="light"]) .dg-rail-line {
    background: rgba(26, 26, 26, 0.14);
  }
  :global(html[data-theme="light"]) .dg-rail-label {
    color: rgba(26, 26, 26, 0.5);
  }
  :global(html[data-theme="light"]) .dg-rail-item:hover .dg-rail-label,
  :global(html[data-theme="light"]) .dg-rail-item.is-active .dg-rail-label {
    color: #1a1a1a;
  }
  :global(html[data-theme="light"]) .dg-rail-tick {
    background: rgba(26, 26, 26, 0.28);
  }
  :global(html[data-theme="light"]) .dg-rail-item.is-active {
    background: rgba(245, 237, 228, 0.95);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }
  /* hide the rail when there isn't room beside the centered column */
  @media (max-width: 1200px) {
    .dg-rail {
      display: none;
    }
  }

  /* ── Cassette variant gallery ── */
  .dg-cass-cap {
    margin: 2rem 0 0.9rem;
    font-family: "PolySans Mono", monospace;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    color: rgba(254, 252, 217, 0.6);
  }
  .dg-cass-cap:first-of-type {
    margin-top: 0.4rem;
  }
  :global(html[data-theme="light"]) .dg-cass-cap {
    color: rgba(26, 26, 26, 0.6);
  }
  .dg-cass-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.9rem;
  }
  .dg-cass {
    margin: 0;
    padding: 0.9rem;
    border-radius: 14px;
    border: 1px solid rgba(254, 252, 217, 0.1);
    background: rgba(254, 252, 217, 0.02);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .dg-cass:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--sw, #f95f4a) 55%, transparent);
  }
  .dg-cass img {
    width: 100%;
    max-width: 130px;
    height: 84px;
    object-fit: contain;
  }
  .dg-cass figcaption {
    margin-top: 0.7rem;
    font-family: "PolySans Trial", sans-serif;
    font-size: 0.76rem;
    font-weight: 500;
    color: #fefcd9;
  }
  .dg-cass-sub {
    margin-top: 0.2rem;
    font-family: "PolySans Mono", monospace;
    font-size: 0.72rem;
    line-height: 1.4;
    color: rgba(254, 252, 217, 0.45);
  }
  :global(html[data-theme="light"]) .dg-cass {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(26, 26, 26, 0.1);
  }
  :global(html[data-theme="light"]) .dg-cass figcaption {
    color: #1a1a1a;
  }
  :global(html[data-theme="light"]) .dg-cass-sub {
    color: rgba(26, 26, 26, 0.5);
  }
  .dg-cass-where {
    margin: 0.9rem 0 0;
    font-family: "PolySans Mono", monospace;
    font-size: 0.86rem;
    line-height: 1.5;
    color: rgba(254, 252, 217, 0.5);
  }
  :global(html[data-theme="light"]) .dg-cass-where {
    color: rgba(26, 26, 26, 0.55);
  }
  .dg-team-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .dg-team-card {
    width: 190px;
    max-width: 100%;
    border-radius: 10px;
    overflow: hidden;
  }
  .dg-cass-bespoke {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .dg-cass-bset {
    padding: 1rem;
    border-radius: 14px;
    border: 1px solid rgba(254, 252, 217, 0.1);
    background: rgba(254, 252, 217, 0.02);
  }
  .dg-cass-brow {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    padding-bottom: 0.4rem;
  }
  .dg-cass-brow img {
    height: 74px;
    width: auto;
    flex: none;
    object-fit: contain;
  }
  .dg-cass-bset .dg-cass-sub {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.66rem;
  }
  :global(html[data-theme="light"]) .dg-cass-bset {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(26, 26, 26, 0.1);
  }

  /* ── Type family filename tag + wide/serif specimens ── */
  .dg-type-file {
    display: block;
    margin-top: 0.5rem;
    font-family: "PolySans Mono", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(254, 252, 217, 0.35);
  }
  :global(html[data-theme="light"]) .dg-type-file {
    color: rgba(26, 26, 26, 0.4);
  }
  .dg-type-standard {
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    letter-spacing: -0.02em;
  }
  .dg-type-mono {
    font-size: clamp(1rem, 2vw, 1.2rem);
  }
  .dg-type-wide {
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.4rem, 3.4vw, 2rem);
    letter-spacing: 0.04em;
  }
  .dg-type-serif {
    font-weight: 500;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  /* ── Weight ladder ── */
  .dg-weight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
  }
  .dg-weight-card {
    padding: 1.2rem 1.3rem;
    border-radius: 14px;
    border: 1px solid rgba(254, 252, 217, 0.1);
    background: rgba(254, 252, 217, 0.02);
    display: flex;
    flex-direction: column;
  }
  .dg-weight-aa {
    font-family: "PolySans Trial", sans-serif;
    font-size: 2.6rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fefcd9;
  }
  .dg-weight-name {
    margin-top: 0.7rem;
    font-family: "PolySans Trial", sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
    color: #fefcd9;
  }
  .dg-weight-use {
    margin-top: 0.2rem;
    font-family: "PolySans Mono", monospace;
    font-size: 0.66rem;
    color: rgba(254, 252, 217, 0.5);
  }
  :global(html[data-theme="light"]) .dg-weight-card {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(26, 26, 26, 0.1);
  }
  :global(html[data-theme="light"]) .dg-weight-aa,
  :global(html[data-theme="light"]) .dg-weight-name {
    color: #1a1a1a;
  }
  :global(html[data-theme="light"]) .dg-weight-use {
    color: rgba(26, 26, 26, 0.55);
  }

  /* ── Character map (live SVG specimen) ── */
  .dg-charmap {
    margin-top: 1.6rem;
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid rgba(254, 252, 217, 0.12);
    border-radius: 16px;
    overflow: hidden;
    background: rgba(254, 252, 217, 0.02);
  }
  @media (min-width: 900px) {
    .dg-charmap {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .dg-cm-stage {
    position: relative;
    background: rgba(254, 252, 217, 0.03);
    border-bottom: 1px solid rgba(254, 252, 217, 0.12);
    min-height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 66px 20px 20px;
  }
  @media (min-width: 900px) {
    .dg-cm-stage {
      border-bottom: none;
      border-right: 1px solid rgba(254, 252, 217, 0.12);
      position: sticky;
      top: 0;
      align-self: start;
      min-height: 520px;
    }
  }
  #dg-cm-svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .dg-cm-fonts {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    flex-wrap: nowrap;
    gap: 2px;
    padding: 3px;
    border-radius: 100px;
    background: rgba(13, 14, 13, 0.6);
    border: 1px solid rgba(254, 252, 217, 0.14);
    z-index: 2;
    white-space: nowrap;
  }
  .dg-cm-font {
    border: none;
    background: transparent;
    color: rgba(254, 252, 217, 0.55);
    font-family: "PolySans Mono", monospace;
    font-size: 11.5px;
    font-weight: 500;
    padding: 5px 13px;
    border-radius: 100px;
    cursor: pointer;
    transition: background 0.14s ease, color 0.14s ease;
  }
  .dg-cm-font:hover {
    color: #fefcd9;
  }
  .dg-cm-font.is-on {
    background: #f95f4a;
    color: #0d0e0d;
  }
  .dg-cm-toggle {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: 100px;
    background: rgba(13, 14, 13, 0.6);
    border: 1px solid rgba(254, 252, 217, 0.14);
    z-index: 2;
  }
  .dg-cm-tog {
    border: none;
    background: transparent;
    color: rgba(254, 252, 217, 0.55);
    font-family: "PolySans Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 100px;
    cursor: pointer;
