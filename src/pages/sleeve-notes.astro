    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .dg-mnx-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f95f4a;
    box-shadow: 0 0 6px rgba(249, 95, 74, 0.6);
    flex: none;
  }
  .dg-mnx-label {
    font-family: "PolySans Trial", sans-serif;
    font-size: 11px;
