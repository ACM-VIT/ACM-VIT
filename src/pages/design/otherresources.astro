---

<DesignLayout
  title="Other Resources"
  description="Event, product, and enamel-pin logos from across ACM-VIT - Cryptic Hunt, Reverse Coding, Codex Cryptum, Forktober, ExamCooker, UniPool, and more, each ready to download in SVG, PNG, and WebP."
  current="/design/otherresources"
>
  <section class="ds-hero">
    <div class="ds-kicker"><span class="ds-kicker-pill">Assets · Other resources</span></div>
    <h1 class="ds-h1">The rest of the shelf.</h1>
    <p class="ds-body-lg">
      Beyond the ACM mark sits a wider library the design team has drawn over the
      years - event logos, hackathon identities, product brandmarks, and enamel
      pins. This is that set, one section per event and product, renamed and
      downloadable, so everyone pulls the same file instead of rebuilding one.
    </p>
    <div style="display:flex; gap:12px; margin-top:26px; flex-wrap:wrap;">
      <a href="/design/logosystem" class="ds-btn ds-btn-outline">Back to the logo system</a>
      <a href="#cryptic-hunt" class="ds-btn ds-btn-primary">Jump to the logos</a>
    </div>
  </section>

  <section class="ds-section" id="rules">
    <div class="ds-bento">
      <div class="ds-card ds-card-tonal ds-b6 ds-reveal">
        <span class="ds-chip ds-chip-do" style="margin-bottom:14px">Inside ACM-VIT</span>
        <p class="ds-body">
          These are for chapter members making event art, merch, and recaps. Pick
          the edition you need, keep it intact, and download the file here rather
          than remaking it.
        </p>
      </div>
      <div class="ds-card ds-card-tonal ds-b6 ds-reveal">
        <span class="ds-chip ds-chip-dont" style="margin-bottom:14px">Outside ACM-VIT</span>
        <p class="ds-body">
          Partners, sponsors, and press should use the standard marks on the
          <a href="/design/logo" style="color:var(--ds-accent-ink); font-weight:600;">Logo page</a>.
          Need something this set does not cover? Email
          <a href="mailto:outreach@acmvit.in" style="color:var(--ds-accent-ink); font-weight:600;">outreach@acmvit.in</a>.
        </p>
      </div>
    </div>
  </section>

  {
    sections.map((g) => (
      <section class="ds-section" id={g.id}>
        <div class="ds-sec-head">
          <span class="ds-sec-num">{g.num}</span>
          <h2 class="ds-h2">{g.title}</h2>
        </div>
        <p class="ds-body">{g.blurb}</p>

        <div class="ds-bento">
          {g.items.map((l) => (
            <div class="ds-card ds-b6 ds-reveal" style="padding:0; overflow:hidden;">
              <div
                class:list={[
                  "ds-specimen-stage",
                  l.bg === "checker" && "ds-checker",
                  l.bg === "checker-dark" && "ds-checker-dark",
                  l.lit && "or-lit",
                ]}
                style="min-height:230px;"
              >
                <img
                  class="or-art"
                  src={asset(`${l.slug}-preview.webp`)}
                  alt={l.name}
                  loading="lazy"
                />
              </div>
              <div style="padding:20px 24px 24px;">
                <div style="display:flex; align-items:baseline; justify-content:space-between; gap:12px;">
                  <h3 class="ds-h4">{l.name}</h3>
                  <code class="ds-mono ds-small">{l.slug}</code>
                </div>
                <p class="ds-body" style="margin-top:6px">{l.desc}</p>
                {l.raster && <p class="ds-dl-cap">Bitmap source · PNG &amp; WebP only</p>}
                <div class="ds-dl-rows">
                  {!l.raster && (
                    <div class="ds-dl-row">
                      <span class="ds-mono ds-small">SVG</span>
                      <span class="ds-dl">
                        <a href={asset(`${l.slug}.svg`)} download>vector</a>
                      </span>
                    </div>
                  )}
                  <div class="ds-dl-row">
                    <span class="ds-mono ds-small">PNG</span>
                    <span class="ds-dl">
                      {dlSizes.map((s) => (
                        <a href={asset(`${l.slug}-${s}.png`)} download>{s}</a>
                      ))}
                    </span>
                  </div>
                  <div class="ds-dl-row">
                    <span class="ds-mono ds-small">WebP</span>
                    <span class="ds-dl">
                      {dlSizes.map((s) => (
                        <a href={asset(`${l.slug}-${s}.webp`)} download>{s}</a>
                      ))}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }
</DesignLayout>

<style>
  /* Uniform contain-box so every mark reads at a similar size. The
     preview files are already trimmed and centred on one canvas, so this
     just caps the display height. */
  .or-art {
    width: 100%;
    max-width: 440px;
    height: 150px;
    object-fit: contain;
    display: block;
  }
  .ds-dl-cap {
    margin: 16px 0 0;
    font-size: 11.5px;
    font-weight: 640;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ds-ink-3);
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .ds-dl-rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 16px;
  }
  .ds-dl-cap + .ds-dl-rows {
    margin-top: 8px;
  }
  .ds-dl-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ds-dl-row > .ds-mono {
    width: 48px;
    flex: none;
  }
  .ds-sec-head .ds-h2 {
    text-transform: none;
  }

  /* In dark mode the shared .ds-checker stays a light panel by design (it
     hosts dark-ink art elsewhere). Here most marks read fine on a dark
     stage, so flip the light checker to the dark checker in dark mode.
     Scoped to this page by Astro, so the logo-system page is untouched.
     Marks tagged .or-lit (pure dark ink / own dark backdrop) opt back out
     and keep the light checker. */
  :global(html[data-theme="dark"]) .ds-specimen-stage.ds-checker {
    background-color: #201e1b;
    background-image: linear-gradient(45deg, #302d28 25%, transparent 25%),
      linear-gradient(-45deg, #302d28 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #302d28 75%),
      linear-gradient(-45deg, transparent 75%, #302d28 75%);
    background-size: 22px 22px;
    background-position: 0 0, 0 11px, 11px -11px, -11px 0;
  }
  :global(html[data-theme="dark"]) .ds-specimen-stage.ds-checker.or-lit {
    background-color: #ffffff;
    background-image: linear-gradient(45deg, #efece6 25%, transparent 25%),
      linear-gradient(-45deg, #efece6 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #efece6 75%),
      linear-gradient(-45deg, transparent 75%, #efece6 75%);
  }
</style>
