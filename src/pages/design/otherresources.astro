---
export const prerender = true;
import DesignLayout from "../../layouts/DesignLayout.astro";
import { getAssetUrl } from "../../utils/cdn";

const asset = (p: string) => getAssetUrl(`/design/otherresources/${p}`);

// Event, product, and enamel-pin logos the design team has built over the
// years, collected here so members reach for the same file instead of
// hunting the drive. One section per event / product, with all the enamel
// pins gathered at the end. bg is "checker" or "checker-dark" (the
// transparent-artwork backdrops). raster marks bitmap-only sources that
// ship without a vector download. Every stage shows the trimmed, uniform
// {slug}-preview.webp; the download links point at the full-size files.
type Item = {
  slug: string;
  name: string;
  desc: string;
  bg: "checker" | "checker-dark";
  raster?: boolean;
  // Force the light checker even in dark mode. For pure dark-ink marks and
  // marks with their own dark backdrop, which would vanish on a dark stage.
  lit?: boolean;
};

type Section = {
  num: string;
  id: string;
  title: string;
  blurb: string;
  items: Item[];
};

