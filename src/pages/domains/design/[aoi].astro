---
export const prerender = true;

import Layout from "../../../layouts/Layout.astro";
import Footer from "../../../layouts/Footer.astro";
import "../../../styles/globals.css";
import "../../../styles/design-domain.css";
import { getAssetUrl } from "../../../utils/cdn";
import ToolCard from "../../../components/ToolCard.astro";
import FillButton from "../../../components/ui/FillButton.astro";
import {
  DESIGN_THEME_COLOR,
  designAOIs,
  designTools,
  designFooterMessage,
} from "../../../data/designDomainData";

export function getStaticPaths() {
  return designAOIs.map((aoi) => ({ params: { aoi: aoi.key } }));
}

const { aoi: aoiSlug } = Astro.params;
const aoiData = designAOIs.find((a) => a.key === aoiSlug);
if (!aoiData) return Astro.redirect("/domains/design");

const aoiTools = aoiData.tools
  .map((slug) => designTools.find((t) => t.slug === slug))
  .filter((t): t is (typeof designTools)[number] => Boolean(t));

const otherAOIs = designAOIs.filter((a) => a.key !== aoiSlug);
---

<Layout pageTitle={aoiData.title} backHref="/domains/design">
  <div style={`--domain-color: ${DESIGN_THEME_COLOR};`}>

    <!-- Hero -->
    <section class="dsg-hero" style="min-height: 70vh;">
      <div class="dsg-hero-inner">
        <div class="dsg-hero-text">
          <nav class="dsg-hero-crumbs" aria-label="Breadcrumb" data-dsg-animate="fade-up">
            <svg class="dsg-hero-crumb-reel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <circle cx="12" cy="12" r="3.4" />
              <path d="M12 2v6.6M12 15.4V22M2 12h6.6M15.4 12H22" />
            </svg>
            <ol>
              <li><a href="/">Home</a></li>
              <li><a href="/#domains">Domains</a></li>
              <li><a href="/domains/design">Design</a></li>
              <li aria-current="page">{aoiData.title}</li>
            </ol>
          </nav>
          <h1 class="dsg-hero-title" data-dsg-animate="fade-up" style="font-size: clamp(3rem, 8vw, 7rem);">
            {aoiData.title}
          </h1>
          <p class="dsg-hero-desc" data-dsg-animate="fade-up">
            {aoiData.shortDescription}
          </p>
        </div>
        <div class="dsg-cassette-fan" data-dsg-animate="fade-up" style="min-height: 300px;">
          <div class="dsg-fan-center" style="opacity: 1;">
            <img
              src={getAssetUrl(aoiData.cassetteSrc)}
              alt={aoiData.title}
              style="width: 380px;"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Description -->
    <section class="dsg-about">
      <div class="dsg-about-inner">
        <h2 class="dsg-about-heading" data-dsg-animate="fade-up">
          What this <span>AOI</span> does
        </h2>
        <div class="dsg-about-body" data-dsg-animate="fade-up">
          {aoiData.longDescription.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <hr class="dsg-divider" />

    <!-- Tools used in this AOI -->
    {aoiTools.length > 0 && (
      <section class="dsg-tools">
        <div class="dsg-tools-header">
          <p class="dsg-tools-label" data-dsg-animate="fade-up">Stack</p>
          <h2 class="dsg-tools-title" data-dsg-animate="fade-up">Tools We Use</h2>
        </div>
        <div class="dsg-aoi-tools-row">
          {aoiTools.map((tool, i) => (
            <ToolCard tool={tool} delaySeconds={i * 0.05} />
          ))}
        </div>
      </section>
    )}

    {aoiData.works && aoiData.works.length > 0 && (
      <>
        <hr class="dsg-divider" />
        <section class="dsg-events">
          <div class="dsg-events-header">
            <p class="dsg-events-label" data-dsg-animate="fade-up">Projects</p>
            <h2 class="dsg-events-title" data-dsg-animate="fade-up">What We've Made</h2>
          </div>
          <div class="dsg-works-grid" data-dsg-animate="fade-up">
            {aoiData.works.map((work) => (
              <a
                href={work.href}
                target="_blank"
                rel="noopener noreferrer"
                class="dsg-work-card"
              >
                <span class="dsg-work-thumb">
                  <img
                    src={getAssetUrl(work.thumb)}
                    alt={work.title ?? "Instagram reel by ACM-VIT"}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="dsg-work-play" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </span>
                  <span class="dsg-work-badge">{work.platform === "youtube" ? "YouTube" : "Instagram"}</span>
                </span>
                <h4>{work.title ?? "Instagram Reel"}</h4>
              </a>
            ))}
          </div>
        </section>
      </>
    )}

    <hr class="dsg-divider" />

    <!-- Other AOIs -->
    {otherAOIs.length > 0 && (
      <section class="dsg-events">
        <div class="dsg-events-header">
          <p class="dsg-events-label" data-dsg-animate="fade-up">More from Design</p>
          <h2 class="dsg-events-title" data-dsg-animate="fade-up">Other AOIs</h2>
        </div>
        <div class="dsg-events-row">
          {otherAOIs.map((aoi) => (
            <a href={`/domains/design/${aoi.key}`} class="dsg-event-card" data-dsg-animate="fade-up">
              <img
                src={getAssetUrl(aoi.cassetteSrc)}
                alt={aoi.title}
                loading="lazy"
                decoding="async"
              />
              <h4>{aoi.title}</h4>
              <p>{aoi.shortDescription}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Footer with cassette fan -->
    <section class="dsg-footer-section">
      <div class="dsg-cassette-fan" data-dsg-fan>
        {otherAOIs.map((aoi, i) => (
          <div class="dsg-fan-card" style={`--fan-index: ${i}`} data-fan-card>
            <img
              src={getAssetUrl(aoi.cassetteSrc)}
              alt={aoi.title}
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
      <p class="dsg-footer-msg">{designFooterMessage}</p>
      <FillButton href="/domains/design" label="Back to Design" style={`--proj-color: ${DESIGN_THEME_COLOR}; --proj-color-secondary: #0d0e0d;`}>
        <svg slot="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </FillButton>
    </section>
  </div>

  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const entry = gsap.timeline({ defaults: { ease: "power3.out" }, paused: true });

  // Hero text
  const heroEls = document.querySelectorAll('.dsg-hero-text [data-dsg-animate="fade-up"]');
  entry.fromTo(heroEls,
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 0.6, stagger: 0.12 }
  );

  // Cassette
  const fan = document.querySelector('.dsg-cassette-fan[data-dsg-animate]');
  if (fan) {
    entry.fromTo(fan,
      { opacity: 0, scale: 0.9, rotate: -3 },
      { opacity: 1, scale: 1, rotate: 0, duration: 0.8 },
      "-=0.3"
    );
  }

  // Float
  const centerImg = document.querySelector('.dsg-fan-center img');
  if (centerImg) {
    gsap.to(centerImg, {
      y: -12, duration: 2.5, ease: "sine.inOut", yoyo: true, repeat: -1,
    });
  }

  window.addEventListener("preloader:done", () => entry.play(), { once: true });

  // Scroll reveals
  const scrollEls = document.querySelectorAll(
    '.dsg-about [data-dsg-animate], .dsg-tools [data-dsg-animate], .dsg-events [data-dsg-animate]'
  );
  scrollEls.forEach((el) => {
    gsap.fromTo(el,
      { opacity: 0, y: 24 },
      {
        opacity: 1, y: 0, duration: 0.6, ease: "power2.out",
        delay: parseFloat((el as HTMLElement).style.getPropertyValue('--card-delay') || '0'),
        scrollTrigger: { trigger: el, start: "top 88%", once: true },
      }
    );
  });

  // Footer cassette fan - scroll triggered
  const fanCards = document.querySelectorAll("[data-fan-card]");
  const fanSection = document.querySelector(".dsg-cassette-fan");

  if (fanSection && fanCards.length > 0) {
    // 4 cards: left, near-left, near-right, right
    const fanAngles = [-25, -10, 10, 25];
    const fanOffsetsX = [-220, -80, 80, 220];
    const fanOffsetsY = [30, 5, 5, 30];

    fanCards.forEach((card) => {
      gsap.set(card, { opacity: 0, rotation: 0, x: 0, y: 40, scale: 0.5 });
    });

    const fanTl = gsap.timeline({
      scrollTrigger: {
        trigger: fanSection,
        start: "top 80%",
        once: true,
      },
    });

    fanCards.forEach((card, i) => {
      fanTl.to(card, {
        opacity: 1,
        rotation: fanAngles[i] ?? 0,
        x: fanOffsetsX[i] ?? 0,
        y: fanOffsetsY[i] ?? 0,
        scale: 1,
        duration: 0.6,
        ease: "back.out(1.2)",
      }, i === 0 ? "+=0" : "-=0.45");
    });
  }
</script>
