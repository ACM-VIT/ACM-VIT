---
export const prerender = true;
import { getAssetUrl } from "../utils/cdn";

const versions = [
  { id: "v1", label: "v1 · August 2026", title: "August 2026 Edition", path: "/grep/v1.pdf" },
  { id: "v0", label: "v0 · Origins", title: "Origins Edition", path: "/grep/v0.pdf" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Read GREP - ACM-VIT</title>
    <link rel="icon" type="image/webp" href={getAssetUrl("/favicon.webp")} />
  </head>
  <body>
    <main class="grep-reader" data-grep-viewer data-mode="spread" aria-busy="true">
      <header class="reader-toolbar">
        <a class="reader-brand" href="/" aria-label="Read GREP — Back to Main Site">Read <strong>GREP</strong></a>
        <div class="reader-options">
          <label class="deck-field"><span class="sr-only">Version</span>
            <select data-grep-version-select>
              {versions.map((version, index) => (
                <option value={version.id} selected={index === 0} data-pdf-url={getAssetUrl(version.path)} data-pdf-fallback={version.path} data-version-title={version.title}>{version.label}</option>
              ))}
            </select>
          </label>
          <details class="reading-options">
            <summary>Reading Options</summary>
          <label class="deck-field">View
            <select data-grep-mode>
              <option value="spread">Two Pages</option>
              <option value="single">One Page</option>
              <option value="pdf">PDF Mode</option>
            </select>
          </label>
          <a class="deck-button open-pdf" data-grep-pdf-link href="/grep/v1.pdf" target="_blank" rel="noopener">Open PDF ↗</a>
          </details>
        </div>
      </header>

      <section class="reader-content" aria-label="GREP pages">
        <div class="grep-stage" data-grep-stage>
          <canvas data-grep-left aria-label="Left page"></canvas>
          <canvas data-grep-right aria-label="Right page"></canvas>
          <canvas class="turn-page" data-grep-flip aria-hidden="true" hidden></canvas>
        </div>
        <iframe data-grep-pdf-frame title="GREP PDF viewer" hidden></iframe>

        <div class="reader-overlay" data-grep-start hidden>
          <div class="reader-card">
            <h1>Welcome to GREP</h1>
            <p data-grep-edition>August 2026 Edition</p>
            <button class="deck-button primary" data-grep-start-btn type="button">Start Reading</button>
          </div>
        </div>

        <div class="reader-overlay loading-overlay" data-grep-loading role="status" aria-live="polite">
          <div class="reader-card">
            <div class="loading-cassette" data-grep-loading-animation aria-hidden="true"></div>
            <p data-grep-loading-text>Loading GREP…</p>
          </div>
        </div>

        <div class="reader-overlay" data-grep-error hidden role="alert">
          <div class="reader-card">
            <h2>Unable to Load GREP</h2>
            <p>Please try again, or open the PDF directly.</p>
            <button class="deck-button primary" data-grep-retry type="button">Retry</button>
            <a class="deck-button" data-grep-error-link href="/grep/v1.pdf" target="_blank" rel="noopener">Open PDF ↗</a>
          </div>
        </div>
      </section>

      <footer class="reader-transport">
        <button class="deck-button transport-key" data-grep-prev type="button" aria-label="Previous pages" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
          <span class="sr-only">Previous pages</span>
        </button>
        <div class="page-display" aria-live="polite"><span data-grep-page>1</span><span class="page-divider"> / </span><span data-grep-total>—</span><small data-grep-end hidden>End of GREP</small></div>
        <button class="deck-button transport-key" data-grep-next type="button" aria-label="Next pages" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
          <span class="sr-only">Next pages</span>
        </button>
      </footer>
      <noscript><p class="noscript">Enable JavaScript to use the reader, or <a href="/grep/v1.pdf">Read GREP v1 as a PDF</a>.</p></noscript>
    </main>
    <script>
      import "../scripts/grep-viewer";
    </script>
  </body>
</html>

<style>
  :global(html), :global(body) { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #0d0e0d; color: #fefcd9; font-family: "PolySans Trial", sans-serif; }
  :global(*) { box-sizing: border-box; }
  :global([hidden]) { display: none !important; }
  .grep-reader { position: relative; height: 100vh; height: 100dvh; background: radial-gradient(circle at center, #111 0%, #0a0a0a 55%, #050505 100%); }
  .reader-toolbar { position: absolute; top: 18px; left: 18px; z-index: 10; width: min(280px, calc(100vw - 36px)); padding: 14px; border: 1px solid rgba(249, 95, 74, .35); border-radius: 16px; background: rgba(10, 10, 10, .78); backdrop-filter: blur(14px); }
  .reader-brand { display: inline-flex; gap: 4px; align-items: center; text-decoration: none; color: #f95f4a; font-size: 12px; letter-spacing: .08em; margin-bottom: 10px; }
  .reader-brand strong { font-weight: inherit; }
  .reader-options { display: grid; gap: 9px; }
  .reading-options summary { color: rgba(254, 252, 217, .6); font-size: 10px; cursor: pointer; }
  .reading-options .deck-field { margin-top: 10px; }
  .reading-options .open-pdf { margin-top: 10px; }
  .deck-field { display: grid; gap: 5px; color: rgba(254, 252, 217, .52); font-size: 10px; letter-spacing: .08em; }
  select, .deck-button { border: 1px solid rgba(254, 252, 217, .14); border-radius: 10px; background: #171716; color: #fefcd9; font: inherit; font-size: 12px; }
  select { color-scheme: dark; width: 100%; padding: 9px 12px; cursor: pointer; }
  select option { background: #171716; color: #fefcd9; }
  .deck-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 20px; text-decoration: none; cursor: pointer; border-radius: 999px; border-color: #f95f4a; background: transparent; transition: background .2s ease, color .2s ease; }
  select:hover:not(:disabled) { border-color: rgba(249, 95, 74, .7); }
  .deck-button:hover:not(:disabled) { background: #f95f4a; color: #1a1a1a; }
  .deck-button:disabled, select:disabled { opacity: .4; cursor: default; }
  :is(a, button, select):focus-visible { outline: 2px solid #f95f4a; outline-offset: 3px; }
  .open-pdf { justify-self: start; font-size: 10px; padding: 6px 12px; }
  .reader-content { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .grep-stage { position: relative; width: 100%; height: 100%; padding: clamp(8px, 1.2vw, 18px); display: flex; justify-content: center; align-items: center; }
  .grep-stage canvas { display: block; flex: 0 0 auto; }
  .grep-stage .turn-page { position: absolute; pointer-events: none; z-index: 1; will-change: transform; }
  iframe { width: 100%; height: 100%; border: 0; background: #171716; }
  .reader-overlay { position: absolute; inset: 0; display: grid; place-items: center; padding: 20px; background: radial-gradient(circle at center, rgba(12, 12, 12, .7), rgba(5, 5, 5, .92)); z-index: 3; }
  .reader-card { text-align: center; max-width: 420px; padding: 26px 30px; border-radius: 18px; border: 1px solid rgba(249, 95, 74, .4); background: rgba(10, 10, 10, .7); }
  .reader-card h1 { font-size: .95rem; margin: 0 0 8px; font-weight: 400; letter-spacing: .12em; }
  .reader-card p { color: rgba(254, 252, 217, .6); font-size: .8rem; line-height: 1.6; margin: 0 0 16px; letter-spacing: .06em; }
  .reader-card h2 { font-size: 1rem; font-weight: 400; }
  .loading-overlay { z-index: 4; background: #0d0e0d; }
  .loading-overlay .reader-card { background: none; border: 0; }
  .loading-cassette { width: 300px; height: 300px; display: flex; align-items: center; justify-content: center; margin: 0 auto 26px; }
  .loading-cassette :global(svg) { max-width: 100%; max-height: 100%; }
  .reader-transport { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .transport-key { position: absolute; top: 50%; width: 48px; height: 48px; padding: 0; border: 1px solid rgba(249, 95, 74, .4); border-radius: 50%; background: rgba(10, 10, 10, .65); color: rgba(254, 252, 217, .75); pointer-events: auto; transform: translateY(-50%); }
  [data-grep-prev] { left: 20px; }
  [data-grep-next] { right: 20px; }
  .transport-key svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .page-display { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); text-align: center; font-size: .7rem; letter-spacing: .3em; color: rgba(254, 252, 217, .7); }
  .page-display small { display: block; font-size: 10px; letter-spacing: .05em; margin-top: 5px; }
  .page-divider { color: rgba(254, 252, 217, .4); }
  [data-mode="pdf"] .reader-transport { display: none; }
  [data-mode="pdf"] .reader-toolbar { position: relative; top: auto; left: auto; width: 100%; border-radius: 0; display: flex; align-items: center; gap: 16px; }
  [data-mode="pdf"] .reader-brand { margin: 0; white-space: nowrap; }
  [data-mode="pdf"] .reader-options { display: flex; align-items: end; gap: 12px; }
  [data-mode="pdf"].grep-reader { display: flex; flex-direction: column; }
  [data-mode="pdf"] .reader-content { flex: 1; min-height: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .noscript { position: fixed; inset: 25% 10%; background: #191a17; padding: 30px; z-index: 20; }
  .noscript a { color: #f95f4a; }
  @media (max-width: 768px) {
    .reader-toolbar { top: 10px; left: 10px; width: min(240px, calc(100vw - 20px)); padding: 10px; border-radius: 12px; }
    .reader-options { gap: 7px; }
    select { padding: 7px 9px; font-size: 11px; }
    .grep-stage { padding: 8px; }
    .transport-key { top: auto; bottom: 20px; width: 52px; height: 52px; transform: none; }
    [data-grep-prev] { left: 16px; }
    [data-grep-next] { right: 16px; }
    .page-display { bottom: 84px; }
    [data-mode="pdf"] .reader-toolbar { flex-wrap: wrap; }
    [data-mode="pdf"] .reader-options { flex-wrap: wrap; width: 100%; }
    [data-mode="pdf"] .deck-field { flex: 1; }
  }
  @media (max-width: 768px) { .loading-cassette { width: 250px; height: 250px; } }
  @media (max-width: 480px) { .loading-cassette { width: 200px; height: 200px; } }
</style>
