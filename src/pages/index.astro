---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import "../styles/globals.css";
import PageSections from "../components/PageSections.astro";
import GrepSideTab from "../components/ui/GrepSideTab.astro";
import Footer from "../layouts/Footer.astro";
import { items as pages } from "../generated/pages";

// The homepage is composed from the `pages` collection: an ordered list of
// block instances editable in the CMS (reorder, toggle). Blocks themselves
// are code - see src/platform/blocks/registry.ts.
const home = pages.find((p) => p.slug === "home");
if (!home) throw new Error('Missing "home" entry in the pages collection');
---

<Layout>
    <PageSections sections={home.sections} />

    <GrepSideTab />
    <Footer />
</Layout>
